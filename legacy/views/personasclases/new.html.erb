<h1>New personasclase</h1>

<% form_for(@personasclase) do |f| %>
  <%= f.error_messages %>

  <p>
    <%= f.label :persona_id %><br />
    <%= f.text_field :persona_id %>
  </p>
  <p>
    <%= f.label :tiposhorario_id %><br />
    <%= f.text_field :tiposhorario_id %>
  </p>
  <p>
    <%= f.label :placa_id %><br />
    <%= f.text_field :placa_id %>
  </p>
  <p>
    <%= f.label :fecha_clase %><br />
    <%= f.date_select :fecha_clase %>
  </p>
  <p>
    <%= f.label :recoje %><br />
    <%= f.text_field :recoje %>
  </p>
  <p>
    <%= f.label :user_id %><br />
    <%= f.text_field :user_id %>
  </p>
  <p>
    <%= f.submit 'Create' %>
  </p>
<% end %>

<%= link_to 'Back', personasclases_path %>