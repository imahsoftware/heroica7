<br/>
<div align="center">
  <table width="70%"  border="0" cellspacing="0" cellpadding="0" class="sample">
<% i = 0
@instructores.each do |instructor|
i = i + 1
 if i == 1 %>
    <thead>
      <tr>
        <td width="50%" height="20" class="camposDescN11"><div align="left">Alerta</div></td>
        <td width="25%" class="camposDescN11"><div align="center">Instructor</div></td>
        <td width="25%" class="camposDescN11"><div align="center">Fecha Vencimiento</div></td>
      </tr>
    </thead>
<% end %>
    <tr>
      <td class="camposDesc11"><div align="left"><%=instructor.nom%></div></td>
      <td class="camposDesc11"><div align="center"><%=instructor.nombre%></div></td>
      <td class="camposDesc11"><div align="center"><%=instructor.fch%></div></td>
    </tr>
<% end %>
   </table>
<br/>
<table width="500"  border="0" cellspacing="0" cellpadding="0" class="sample">
<% i = 0
@objetos.each do |objeto|
i = i + 1
 if i == 1 %>
    <thead>
      <tr>
        <td width="50%" height="20" class="camposDescN11"><div align="left">Alerta</div></td>
        <td width="25%" class="camposDescN11"><div align="center">Placa</div></td>
        <td width="25%" class="camposDescN11"><div align="center">Fecha Vencimiento</div></td>
      </tr>
    </thead>
<% end %>
    <tr>
      <td class="camposDesc11"><div align="left"><%=objeto.nom%></div></td>
      <td class="camposDesc11"><div align="center"><%=objeto.descripcion%></div></td>
      <td class="camposDesc11"><div align="center"><%=objeto.fch%></div></td>
    </tr>  
<% end %>
   </table>
<br/>
<table width="600"  border="0" cellspacing="0" cellpadding="0" class="sample">
<% i = 0
@categoriasalertas.each do |categoriasalerta|
i = i + 1
 if i == 1 %>
    <thead>
      <tr>
        <td width="45%" height="20" class="camposDescN11"><div align="left">Alertas Usuario</div></td>
        <td width="50%" class="camposDescN11"><div align="center">Deteccion</div></td>
        <td width="5%" class="camposDescN11"><div align="center"></div></td>
      </tr>
    </thead>
<% end %>
    <tr>
      <td class="camposDesc11"><div align="left"><%=categoriasalerta.persona.autobuscar%></div></td>
      <td class="camposDesc11"><div align="center">
      <% if categoriasalerta.cantclases > categoriasalerta.practicas %>
      * Se Dictaron mas Clases... pactadas <%=categoriasalerta.practicas%>, registradas <%=categoriasalerta.cantclases%>
      <% end
      if categoriasalerta.cantclases >= categoriasalerta.alertaspracticas %>
      * Solicitud de Abono ... registradas <%=categoriasalerta.cantclases%> alerta <%=categoriasalerta.alertaspracticas%>
      <% end %>
      </div></td>
      <td class="camposDesc11"><div align="center"></div></td>
    </tr>
<% end %>
   </table>
</div>
<table width="100%" height="300" border="0" align="center" cellpadding="0" cellspacing="0">
  <tr valign="middle">
    <td><div align="center">
        <img src="/images/<%=Parametro.find(11).valor.to_s%>"></img>
    </div>
    </td>
  </tr>
</table>


