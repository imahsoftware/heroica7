<h1>New preguntasrespuesta</h1>

<% form_for(@preguntasrespuesta) do |f| %>
  <%= f.error_messages %>

  <p>
    <%= f.label :pregunta_id %><br />
    <%= f.text_field :pregunta_id %>
  </p>
  <p>
    <%= f.label :respuesta %><br />
    <%= f.text_field :respuesta %>
  </p>
  <p>
    <%= f.submit 'Create' %>
  </p>
<% end %>

<%= link_to 'Back', preguntasrespuestas_path %>