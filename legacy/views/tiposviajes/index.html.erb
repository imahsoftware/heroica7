<div id="productheader">
  <h2><img src="/images/tipostours.png"></h2>&nbsp;&nbsp;
</div>
  <div align="center">
<table width="50%" height="40" border="0" cellpadding="0" cellspacing="0">
   <tr>
    <td><% form_remote_tag :url => {:action => 'add_tiposviaje'}, :complete => "tiposviaje_descripcion.value=nil" do %>
<table width="100%" height="40" border="0" cellpadding="0" cellspacing="0">
   <tr>
     <td width="55%" class="campos">Descripcion del Tour</td>
     <td width="25%" class="campos">Valor</td>
     <td width="20%"></td>
   </tr>
   <tr>
     <td><%= text_field 'tiposviaje', 'descripcion',{ :class => "campo",
                :size => 50,
                :onFocus => "this.style.border='1px solid #f00',this.value=''",
                :onBlur => "this.style.border='1px solid #bbb'",
                :onChange=> "javascript:this.value=this.value.toUpperCase();"
                 }  %></td>
      <td><%= text_field 'tiposviaje', 'valor',{ :class => "campo",
                :size => 15,
                :onFocus => "this.style.border='1px solid #f00',this.value=''",
                :onBlur => "this.style.border='1px solid #bbb'",
                :onChange=> "javascript:this.value=this.value.toUpperCase();"
                 }  %></td>
      <td><%= submit_tag "Guardar", :class=>"buttonAsLink"%></td>
   </tr>
</table>

     <% end %></td>
  </tr>
</table>

<br />
<div id="tiposviaje_list">
<%= render :partial => 'list' %>
  <div id="notice"><%= flash[:notice] %></div>
</div>
<br/>
</div>

