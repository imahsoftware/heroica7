<%= stylesheet_link_tag 'tabs'%>
<%= javascript_include_tag 'fabtabulous' %>
<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;INFORMACION USUARIOS</span>
  <div align="right">
   <%= link_to 'Buscar Usuario', busqueda_personas_path, :class=>"regresarlink" %>&nbsp;&nbsp;</div>
</div>
<br/>
<div align="center">
<table width="70%" border="0" align="center" cellpadding="0" cellspacing="0">
  <tr valign="middle">
    <td width="20%" height="30" class="oce-first">Identificacion</td>
    <td width="60%" class="oce-first">Nombre</td>
    <td width="20%" class="oce-first">&nbsp;</td>
  </tr>
  <% @personas.each do |persona| %>
  <tr valign="middle">
    <td height="30"><div align="center" class="camposDesc"><%=h persona.identificacion %></div></td>
    <td class="camposDesc">
      <%=h persona.primer_nombre%> <%=h persona.segundo_nombre %> <%=h persona.primer_apellido %> <%=h persona.segundo_apellido %>
      </td>
    <td ><div align="center">
        <%= link_to 'Editar', edit_persona_path(persona),:class=>"editarlink"%>
    </div></td>
  </tr>
  <% end %>
</table>
<table width="80%" height="0" align="center" border="0" cellpadding="0" cellspacing="0">
  <tr>
    <td height="10"><hr size="1" noshade class="hrlinea"></td>
  </tr>
</table>
<table width="80%" border="0" align="center" cellpadding="0" cellspacing="0">
  <tr valign="middle">
    <td width="100%" height="30" class="camposDescN"><div align="center">Nro Total de Registro : <%=@personas.count%></div></td>
  </tr>
</table> 
</div>