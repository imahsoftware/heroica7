  <div align="center">
<table width="50%" border="0" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr>
    <td class="oce-first" width="20%">Id</td>
    <td class="oce-first" width="60%">Placa</td>
    <td class="oce-first" width="20%"></td>
  </tr>
<% for tiposcombustible in @tiposcombustibles%>
  <tr class="<%=cycle('even1', 'odd1')%> postS_<%=tiposcombustible.id%>">
    <td ><%=h tiposcombustible.id %></td>
    <td ><%=h tiposcombustible.descripcion %></td>
    <td ><div align="center">
        <%= link_to 'Editar', edit_tiposcombustible_path(tiposcombustible), :class=>"editarlink" %>
        <%= link_to_remote 'Borrar',
                :url => tiposcombustible_path(tiposcombustible),
                :method => :delete,
                :confirm => "¿Seguro?",
                :before => "$(this).up('.postS_#{tiposcombustible.id}').remove()"%>
        </div>
   </td>
  </tr>
<% end %>
</table>
</div>