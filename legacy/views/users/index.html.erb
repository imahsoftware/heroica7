<%=  javascript_include_tag :defaults %>
<div id="productheader">
  <h2>&nbsp;<img src="/images/informacionusuarios.png"></h2>
  <div align="right">
   <%= link_to 'Nuevo', new_user_path, :class=>"nuevolink" %>&nbsp;&nbsp;</div>
</div>
<div align="center">
<% form_tag request.path, :method => 'get' do %>
    <% content_tag :label do %>
<table width="90%" height="40" border="0" cellpadding="0" cellspacing="0">
   <tr>
     <td width="30%">Digite el dato a buscar :</td>
     <td width="70%"><%= text_field_tag :search, params[:search],{ :class => "campo2",
                :onFocus => "this.style.border='1px solid #f00'",
                :onBlur => "this.style.border='1px solid #bbb'" } %>
      <%= image_submit_tag '/images/find.png', :width => '18', :name => nil %></td>
   </tr>
</table>
    <% end %>
  <% end %>
</div>
<br/>
<table width="80%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr valign="middle">
    <td width="20%" height="30" class="oce-first">Usuario</td>
    <td width="40%" height="30" class="oce-first">Correo Electronico</td>
    <td width="30%" class="oce-first">Nombre</td>
    <td width="10%" class="oce-first">&nbsp;</td>
  </tr>
<% @users.each do |user| %>
  <tr valign="middle">
    <td width="20%" height="30" class="camposDesc"><%=h user.username %></td>
    <td width="40%" height="30" class="camposDesc"><%=h user.email %></td>
    <td width="30%" class="camposDesc"><%=h user.nombre%></td>
    <td width="10%" class="camposDesc"><div align="center">
        <%= link_to 'Editar', edit_user_path(user), :class=>"editarlink"%></div>
    </td>
  </tr>
<% end %>
</table>
<br/>
<table width="90%" height="40" border="0" cellpadding="0" cellspacing="0">
   <tr>
     <td width="100%" class="acci_titcontenido2"><div align="center"><%= will_paginate @users, :previous_label => 'Anterior', :next_label => 'Siguiente' %></div></td>
   </tr>
   <tr>
     <td width="100%" class="acci_titcontenido2"><div align="center">Total Registros: <%= @users.total_entries %></div></td>
   </tr>

</table>
<br>
