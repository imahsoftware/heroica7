<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;INFORMACION CATEGORIAS</span>
</div>
<br/>
<div align="center">
<% if permiso("categoria","C").to_s == "S" %>
<table width="80%" height="40" border="0" cellpadding="0" cellspacing="0">
   <tr>
    <td><% form_remote_tag :url => {:action => 'add_categoria'}, :complete => "categoria_nombre.value=nil categoria_codigo_nuevo.value=nil categoria_codigo.value=nil categoria_tipo_servicio.value=nil" do %>
<table width="100%" height="40" border="0" cellpadding="0" cellspacing="0">
   <tr>
     <td width="35%" class="campos">Nombre</td>
     <td width="15%" class="campos">Codigo Nuevo</td>
     <td width="15%" class="campos">Codigo</td>
     <td width="15%" class="campos">Tipo Servicio</td>
     <td width="20%"></td>
   </tr>
   <tr>
     <td><%= text_field 'categoria', 'nombre',{ :class => "campo",
                :size => 40,
                :onFocus => "this.style.border='1px solid #f00',this.value=''",
                :onBlur => "this.style.border='1px solid #bbb'",
                :onChange=> "javascript:this.value=this.value.toUpperCase();"
                 }  %></td>
     <td><%= text_field 'categoria', 'codigo_nuevo',{ :class => "campo",
                :size => 10,
                :onFocus => "this.style.border='1px solid #f00',this.value=''",
                :onBlur => "this.style.border='1px solid #bbb'"
                 }  %></td>
     <td><%= text_field 'categoria', 'codigo',{ :class => "campo",
                :size => 10,
                :onFocus => "this.style.border='1px solid #f00',this.value=''",
                :onBlur => "this.style.border='1px solid #bbb'"
                 }  %></td>
     <td><%= text_field 'categoria', 'tipo_servicio',{ :class => "campo",
                :size => 10,
                :onFocus => "this.style.border='1px solid #f00',this.value=''",
                :onBlur => "this.style.border='1px solid #bbb'"
                 }  %></td>
      <td><%= submit_tag "Guardar", :class=>"buttonAsLink"%></td>
   </tr>
</table>

     <% end %></td>
  </tr>
</table>
<br />
<% end %>
<div id="categoria_list">
<%= render :partial => 'list' %>
  <div id="notice"><%= flash[:notice] %></div>
</div>
<br/>
</div>
