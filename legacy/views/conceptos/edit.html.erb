<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;INFORMACION CONCEPTOS</span>
  <div align="right">
   <%= link_to 'Regresar', conceptos_path, :class=>"regresarlink" %>&nbsp;&nbsp;</div>
</div>
<br/>
<div align="center">
<% form_for(@concepto) do |f| %>
<table width="60%" height="40" border="0" cellpadding="0" cellspacing="0">
   <tr>
    <td>
<table width="100%" height="40" border="0" cellpadding="0" cellspacing="0">
   <tr>
     <td width="20%" height="30" class="campos">Id :</td>
     <td width="80%"><%=@concepto.id%></td>
   </tr>
   <tr>
     <td height="30" class="campos">Descripcion :</td>
     <td><%= f.text_field :descripcion,{ :class => "campo", :size => 50,
                :onChange=> "javascript:this.value=this.value.toUpperCase();",
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }%></td>
   </tr>
   <tr>
     <td height="30" class="campos">Valor :</td>
     <td><%= f.text_field :valor,{ :class => "campo", :size => 50,
                :onChange=> "javascript:this.value=this.value.toUpperCase();",
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }%></td>
   </tr>
   <tr>
     <td></td>
      <td><%= f.submit "Guardar", :class=>"buttonAsLink"%></td>
   </tr>
</table>
</td>
  </tr>
</table>
<% end %>
</div>