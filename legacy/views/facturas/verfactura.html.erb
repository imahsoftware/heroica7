    <td width="130" class="camposDescN11"><div align="center">Subtotal</div> </td>
  </tr>
  </thead>
  <%
      @detallesfacturas = Detallesfactura.find_all_by_factura_id(@factura.id)
      for detallesfactura in @detallesfacturas

  %>
  <tr>
    <td height="20" class="camposDesc11"><div align="center"><%=detallesfactura.concepto_id%></div></td>
    <td class="camposDesc11"><%=detallesfactura.concepto.descripcion rescue nil%></td>
    <td class="camposDesc11"><div align="center">
        <% if detallesfactura.cantidad.to_s == "" %>
          1
        <% else %>
          <%=detallesfactura.cantidad%>
        <% end %>
      </div></td>
    <td class="camposDesc11"><div align="right"><%=camponumerico(detallesfactura.valor)%>&nbsp;&nbsp;</div></td>
  </tr>
  <% end %>
