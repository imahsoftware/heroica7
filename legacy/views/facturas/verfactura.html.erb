  <tr>
    <td height="20" colspan ="4" class="camposDescN12"><div align="left"> NOTA: SERVICIO PRESTADO AL USUARIO (<%=@factura.persona.identificacion rescue nil%> - <%=@factura.persona.nombres rescue nil%>)</div></td>
  </tr>
  <% end %>
</table>
</td>
