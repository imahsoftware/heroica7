<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;INFORMACION CLASES POR PERIODO</span>
</div>
<BR/>
<div align="center">
  <table width="99%"  border="0" cellspacing="0" cellpadding="0" class="sample">
    <thead>
      <tr>
        <td height="40" colspan="5" class="camposDescN16"><div align="center">INFORME RANGO DE FECHAS   <%=@fch1%> - <%=@fch2%></div></td>
      </tr>
    </thead>
  </table>

<table width="99%" border="0" align="center" cellpadding="0" cellspacing="0" class="sample">
  <thead>
  <tr valign="middle">
    <td width="8%" class="camposDescN11"><div align="center">Fecha Inscripcion</div></td>
    <td width="28%" class="camposDescN11"><div align="center">Identificacion - Nombre</div></td>
    <td width="4%" class="camposDescN11"><div align="center">Cat.</div></td>
    <td width="8%" class="camposDescN11"><div align="center">Fecha Reg. Clases</div></td>
    <td width="5%" class="camposDescN11"><div align="center">Practicas</div></td>
    <td width="5%" class="camposDescN11"><div align="center">Teoricas</div></td>
    <td width="5%" class="camposDescN11"><div align="center">Taller</div></td>
    <td width="4%" class="camposDescN11"><div align="center">Total</div></td>
    <td width="21%" class="camposDescN11"><div align="center">Placa - Instructor</div></td>
    <td width="2%" class="camposDescN11"><div align="center"></div></td>
  </tr>
  </thead>
  <% for personastramiteshora in @personastramiteshoras %>
   <tr  valign="middle">
        <td class="camposDesc11"><div align="center"><%=personastramiteshora.fch%></div></td>
        <td class="camposDesc11"><%=personastramiteshora.identificacion%> - <%=personastramiteshora.nombre%> <%=personastramiteshora.apellido%></td>
        <td class="camposDesc11"><div align="center"><%=personastramiteshora.cat.slice!(9..15)%></div></td>
        <td class="camposDesc11"><div align="center"><%=personastramiteshora.fecha%></div></td>
        <td class="camposDesc11"><div align="center"><%=personastramiteshora.practicas%></div></td>
        <td class="camposDesc11"><div align="center"><%=personastramiteshora.teoricas%></div></td>
        <td class="camposDesc11"><div align="center"><%=personastramiteshora.taller%></div></td>
        <td class="camposDesc11"><div align="center"><%=personastramiteshora.total%></div></td>
        <td class="camposDesc11"><%
            if personastramiteshora.placa_id
              @placa = Placa.find(personastramiteshora.placa_id)%>
              <%=@placa.descripcion%> - <%=@placa.instructor.nombre rescue nil%>
            <% end %>
        </td>
        <td class="camposDesc11"><div align="center">
          <%= link_to '', {:controller=>"personastramiteshoras", :action=>"new2", :personastramite_id=> personastramiteshora.personastramite_id},
                :popup => ['new_window','height=500,width=1000,scrollbars=yes'],
                                 :title => "Registro Horas RUNT", :class=>"nuevolink" %>
            </div>
        </td>
      </tr>
<% end %>
</table>
<br/>
<table width="99%" border="0" align="center" cellpadding="0" cellspacing="0" class="sample">
  <thead>
  <tr valign="middle">
    <td width="8%" class="camposDescN11"><div align="center">Fecha Inscripcion</div></td>
    <td width="40%" class="camposDescN11"><div align="center">Identificacion - Nombre</div></td>
    <td width="4%" class="camposDescN11"><div align="center">Cat.</div></td>
    <td width="8%" class="camposDescN11"><div align="center">Total <br/>Practicas</div></td>
    <td width="8%" class="camposDescN11"><div align="center">Total <br/>Teoricas</div></td>
    <td width="8%" class="camposDescN11"><div align="center">Total <br/>Taller</div></td>
    <td width="8%" class="camposDescN11"><div align="center">Falta <br/>Practicas</div></td>
    <td width="8%" class="camposDescN11"><div align="center">Falta <br/>Teoricas</div></td>
    <td width="8%" class="camposDescN11"><div align="center">Falta <br/>Taller</div></td>
  </tr>
  </thead>
  <% for personastramiteshora in @objetos
        cant1 = 0
        cant2 = 0
        cant3 = 0
            @categoria = Categoria.find(personastramiteshora.categoria_id)
            cant1 = @categoria.practicas.to_i - personastramiteshora.pra.to_i
            cant2 = @categoria.teoricas.to_i - personastramiteshora.teo.to_i
            cant3 = @categoria.taller.to_i - personastramiteshora.tal.to_i

  %>
   <tr  valign="middle">
        <td class="camposDesc11"><div align="center"><%=personastramiteshora.fch%></div></td>
        <td class="camposDesc11"><%=personastramiteshora.identificacion%> - <%=personastramiteshora.nombre%> <%=personastramiteshora.apellido%></td>
        <td class="camposDesc11"><div align="center"><%=personastramiteshora.cat.slice!(9..15)%></div></td>
        <td class="camposDesc11"><div align="center"><%=personastramiteshora.pra%></div></td>
        <td class="camposDesc11"><div align="center"><%=personastramiteshora.teo%></div></td>
        <td class="camposDesc11"><div align="center"><%=personastramiteshora.tal%></div></td>
        <td class="camposDesc11"><div align="center"><%=cant1%></div></td>
        <td class="camposDesc11"><div align="center"><%=cant2%></div></td>
        <td class="camposDesc11"><div align="center"><%=cant3%></div></td>
      </tr>
<% end %>
</table>
<table width="90%"  border="0" cellspacing="0" cellpadding="0">
      <tr>
        <td width="60%" height="20" class="camposDesc11"><div align="left"><%=Time.now.strftime("%Y-%m-%d %X")%> - <%=User.find(is_admin).nombre rescue nil%></div></td>
        <td width="40%" height="20" class="camposDesc11"><div align="right"><a href="javascript:window.print()" class="imprimirlink">Imprimir</a>&nbsp;&nbsp;</div></td>
      </tr>
  </table>
<br/>
      </div>