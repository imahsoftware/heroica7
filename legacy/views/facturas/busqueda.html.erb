<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;INFORMACION FACTURAS</span>
</div>
<br/>
<% form_tag buscar_facturas_path, :method => 'get' do %>
<div align="center">
<table width="60%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr valign="middle">
    <td width="30%" height="30" class="camposDesc"><div align="right"><strong>Identificacion:&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" class="camposDesc"> <%= text_field_tag :buscarident, params[:buscarident],{ :class => "campo", :size => 40,
                :onFocus => "this.style.border='1px solid #f00'",
                :onBlur => "this.style.border='1px solid #bbb'" } %></td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" class="camposDesc"><div align="right"><strong>Nombre:&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" class="camposDesc"> <%= text_field_tag :buscarnombre, params[:buscarnombre],{ :class => "campo", :size => 40,
                :onFocus => "this.style.border='1px solid #f00'",
                :onBlur => "this.style.border='1px solid #bbb'" } %></td>
  </tr>
  <tr valign="middle">
    <td height="30" class="camposDesc"><div align="right"><strong>Numero de Factura:&nbsp;&nbsp;</strong></div></td>
    <td height="30" class="camposDesc"> <%= text_field_tag :buscarfactura, params[:buscarfactura],{ :class => "campo", :size => 40,
                :onFocus => "this.style.border='1px solid #f00'",
                :onBlur => "this.style.border='1px solid #bbb'" } %></td>
  </tr>
  <tr valign="middle">
    <td height="30" class="camposDesc"><div align="right"><strong>Numero del Abono:&nbsp;&nbsp;</strong></div></td>
    <td height="30" class="camposDesc"> <%= text_field_tag :buscarabono, params[:buscarabono],{ :class => "campo", :size => 40,
                :onFocus => "this.style.border='1px solid #f00'",
                :onBlur => "this.style.border='1px solid #bbb'" } %></td>
  </tr>
  <tr valign="middle">
    <td height="30" class="camposDesc"></td>
    <td height="30" class="camposDesc">
      <%= submit_tag "Buscar", :name => nil, :disable_with => "Buscando..." , :class=>"buttonAsLink"%></td></td>
  </tr>
</table>
</div>
<% end %>
<br/>
<% if permiso("facturasinforme","A").to_s == "S" %>
<div align="center">
<table width="95%" height="0" border="0" cellpadding="0" cellspacing="0">
  <tr>
    <td height="10"><hr size="1" noshade class="hrlinea"></td>
  </tr>
</table>
 </div>
<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;INFORME DIARIO</span>
</div>
<br/>
<% form_tag informe_facturas_path, :method => 'get' do %>
<div align="center">
<table width="60%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr valign="middle">
    <td height="30" class="camposDescN10"><div align="right">Fecha Informe: &nbsp;&nbsp;</div></td>
    <td height="30" class="camposDesc">Inicial:&nbsp;&nbsp;
      <%= calendar_date_select "ubicacion", "inicial", :year_range => 50.years.ago..0.years.ago, :class=> "campo", :size => 10, :time => false%>
  &nbsp;&nbsp; - &nbsp;Final:&nbsp;&nbsp;
  <%= calendar_date_select "ubicacion", "final", :year_range => 50.years.ago..0.years.ago, :class=> "campo", :size => 10, :time => false%>
    </td>
  </tr>
  <tr valign="middle">
    <td height="30" class="camposDesc"></td>
    <td height="30" class="camposDesc">
      <%= submit_tag "Generar", :name => nil, :disable_with => "Buscando..." , :class=>"buttonAsLink"%></td>
  </tr>
</table>
</div>
<% end %>
<br/>
<div align="center">
<table width="95%" height="0" border="0" cellpadding="0" cellspacing="0">
  <tr>
    <td height="10"><hr size="1" noshade class="hrlinea"></td>
  </tr>
</table>
 </div>
<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;INFORME DIARIO CONSOLIDADO</span>
</div>
<br/>
<% form_tag informeconsolidado_facturas_path, :method => 'get' do %>
<div align="center">
<table width="60%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr valign="middle">
    <td height="30" class="camposDescN10"><div align="right">Fecha Informe: &nbsp;&nbsp;</div></td>
    <td height="30" class="camposDesc">Inicial:&nbsp;&nbsp;
      <%= calendar_date_select "ubicacion", "inicial", :year_range => 50.years.ago..0.years.ago, :class=> "campo", :size => 10, :time => false%>
  &nbsp;&nbsp; - &nbsp;Final:&nbsp;&nbsp;
  <%= calendar_date_select "ubicacion", "final", :year_range => 50.years.ago..0.years.ago, :class=> "campo", :size => 10, :time => false%>
    </td>
  </tr>
  <tr valign="middle">
    <td height="30" class="camposDesc"></td>
    <td height="30" class="camposDesc">
      <%= submit_tag "Generar", :name => nil, :disable_with => "Buscando..." , :class=>"buttonAsLink"%></td>
  </tr>
</table>
</div>
<% end %>
<br/>
<% end %>

