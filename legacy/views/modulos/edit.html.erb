<h1>Editing modulo</h1>

<% form_for(@modulo) do |f| %>
  <%= f.error_messages %>

  <p>
    <%= f.label :descripcion %><br />
    <%= f.text_field :descripcion %>
  </p>
  <p>
    <%= f.label :mensaje %><br />
    <%= f.text_field :mensaje %>
  </p>
  <p>
    <%= f.label :controlador %><br />
    <%= f.text_field :controlador %>
  </p>
  <p>
    <%= f.submit 'Update' %>
  </p>
<% end %>

<%= link_to 'Show', @modulo %> |
<%= link_to 'Back', modulos_path %>