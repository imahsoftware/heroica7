  <div align="center">
<table width="60%" border="0" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr>
    <td class="oce-first" width="10%">Id</td>
    <td class="oce-first" width="20%">Cedula</td>
    <td class="oce-first" width="50%">Nombre</td>
    <td class="oce-first" width="20%"></td>
  </tr>
<% for instructor in @instructores%>
  <tr class="<%=cycle('even1', 'odd1')%> postS_<%=instructor.id%>">
    <td ><%=h instructor.id %></td>
    <td ><%=h instructor.identificacion %></td>
    <td ><%=h instructor.nombre %></td>
    <td ><div align="center">
                <%= link_to 'Editar', edit_instructor_path(instructor), :class=>"editarlink" %>
        <%= link_to_remote 'Borrar',
                :url => instructor_path(instructor),
                :method => :delete,
                :confirm => "¿Seguro?",
                :before => "$(this).up('.postS_#{instructor.id}').remove()"%>
        </div>
   </td>
  </tr>
<% end %>
</table>
</div>