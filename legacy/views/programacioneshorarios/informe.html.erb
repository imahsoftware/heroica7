<div align="center">
  <table width="800"  border="0" cellspacing="0" cellpadding="0" class="sample">
    <thead>
      <tr>
        <td height="40" colspan="5" class="camposDescN16"><div align="center">INFORME RANGO DE FECHAS   <%=@fch1%> - <%=@fch2%></div></td>
      </tr>
    </thead>
  </table>
<table width="800" border="0" align="center" cellpadding="0" cellspacing="0" class="sample">
  <thead>
  <tr valign="middle">
    <td width="10%" class="camposDescN11"><div align="center">Nro Clases</div></td>
    <td width="30%" class="camposDescN11">Usuario</td>
    <td width="10%" class="camposDescN11"><div align="center">Horario</div></td>
    <td width="10%" class="camposDescN11"><div align="center">Placa</div></td>
    <td width="30%" class="camposDescN11">Instructor</td>
    <td width="10%" class="camposDescN11"><div align="center">Fecha Clase</div></td>
  </tr>
  </thead>
<% i = 0
   for personasclase in @personasclases
   i = i + 1
%>
   <tr  valign="middle" id="personasclase_<%=personasclase.id%>">
    <td class="camposDesc11"><div align="center"><%=i%></div></td>
    <td class="camposDesc11"><%=personasclase.persona.identificacion rescue nil%> - <%=personasclase.persona.nombres rescue nil%></td>
    <td class="camposDesc11"><div align="center"><%=personasclase.tiposhorario.descripcion rescue nil%></div></td>
    <td class="camposDesc11"><div align="center"><%=personasclase.placa.descripcion rescue nil%></div></td>
    <td class="camposDesc11"><%=personasclase.instructor.nombre rescue nil%></td>
    <td class="camposDesc11"><div align="center"><%=personasclase.fecha_clase%></div></td>
 </tr>
<% end %>
</table>
<table width="800"  border="0" cellspacing="0" cellpadding="0">
      <tr>
        <td width="60%" height="20" class="camposDesc11"><div align="left"><%=Time.now.strftime("%Y-%m-%d %X")%> - <%=User.find(is_admin).nombre rescue nil%></div></td>
