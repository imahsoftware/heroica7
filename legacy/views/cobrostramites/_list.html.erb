<%
  @categorias = Categoria.all
  @categorias.each do |categoria|
    if Cobrostramite.exists?(['categoria_id = ?',categoria.id])
%>
<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;<%=categoria.nombre%></span>
</div>
<div align="center">
<table width="95%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr valign="middle">
    <td width="20%" height="30" class="oce-first">Usuario</td>
    <td width="25%" height="30" class="oce-first">Tramite</td>
    <td width="30%" height="30" class="oce-first">Concepto</td>
    <td width="10%" height="30" class="oce-first">Valor</td>
    <td width="15%" class="oce-first"></td>
  </tr>
<%    @cobrostramites = Cobrostramite.find(:all, :conditions=>['categoria_id = ?',categoria.id], :order =>'tipostramite_id, concepto_id')
      for cobrostramite in @cobrostramites
%>
  <tr class="<%=cycle('even1', 'odd1')%> postS_<%=cobrostramite.id%>">
    <td  class="camposDesc">
      <%=cobrostramite.updated_at.strftime("%Y-%m-%d %X")%> - <%=cobrostramite.user.username rescue nil%>
    </td>
    <td  class="camposDesc"><%=h cobrostramite.tipostramite.descripcion rescue nil %></td>
    <td  class="camposDesc"><%=h cobrostramite.concepto.descripcion rescue nil%></td>
    <td  class="camposDesc"><%=h camponumerico(cobrostramite.concepto.valor) rescue nil%></td>
    <td  class="camposDesc"><div align="center">
        <% if permiso("cobrostramite","A").to_s == "S" %>
        <%= link_to 'Editar', edit_cobrostramite_path(cobrostramite), :class=>"editarlink" %>
        <% end %>
        <% if permiso("cobrostramite","E").to_s == "S" %>
        &nbsp;|&nbsp;
          <%= link_to_remote ('Borrar', {
                :url => cobrostramite_path(cobrostramite),
                :method => :delete,
                :confirm => "Seguro?",
                :before => "$(this).up('.postS_#{cobrostramite.id}').remove()" },
                :class=>"borrarlink")%>
        <% end %>
        </div>
   </td>
  </tr>
<% end %>
</table>
  </div>
<% end %>
<% end %>
