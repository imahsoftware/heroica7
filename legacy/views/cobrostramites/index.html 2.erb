<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;INFORMACION CONCEPTOS TRAMITES</span>
</div>
<br/>
<div align="center">
<% if permiso("cobrostramite","C").to_s == "S" %>
<table width="90%" height="40" border="0" cellpadding="0" cellspacing="0">
   <tr>
    <td><% form_remote_tag :url => {:action => 'add_cobrostramite'}, :complete => "concepto_descripcion.value=nil concepto_valor.value=nil" do %>
<table width="100%" height="40" border="0" cellpadding="0" cellspacing="0">
   <tr>
     <td width="15%" class="campos">Categoria</td>
     <td width="30%" class="campos">Tramite</td>
     <td width="30%" class="campos">Concepto</td>
     <td width="15%"></td>
   </tr>
   <tr>
     <td><%=select("cobrostramite", "categoria_id", Categoria.find(:all,:order=>'nombre').collect {|p| [ p.nombre, p.id ] }, { :include_blank => true },
      { :style=>"width:150px", :class => "campo", :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb'" }) %>
     </td>
     <td><%=select("cobrostramite", "tipostramite_id", Tipostramite.find(:all,:order=>'descripcion').collect {|p| [ p.descripcion, p.id ] }, { :include_blank => true },
      { :style=>"width:280px", :class => "campo", :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb'" }) %>
     </td>
     <td><%=select("cobrostramite", "concepto_id", Concepto.find(:all,:order=>'descripcion').collect {|p| [ p.descripcion, p.id ] }, { :include_blank => true },
      { :style=>"width:280px", :class => "campo", :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb'" }) %>
     </td>
      <td><%= submit_tag "Guardar", :class=>"buttonAsLink"%></td>
   </tr>
</table>
     <% end %></td>
  </tr>
</table>
<br />
<% end %>
</div>
<div id="cobrostramite_list">
<%= render :partial => 'list' %>
  <div id="notice"><%= flash[:notice] %></div>
</div>
<br/>

