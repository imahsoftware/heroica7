<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
	"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
   <meta http-equiv="content-type" content="text/html;charset=UTF-8" />
   <title>...::: <%=Parametro.find(12).valor.to_s%> :::...</title>
   <%= javascript_include_tag "prototype" %>
   <%= javascript_include_tag :defaults %>
<%= calendar_date_select_includes "blue",:locale=>'es' %>
   <link href="../../stylesheets/scaffold.css" rel="stylesheet" type="text/css" />
   <link href="../../stylesheets/estilos.css" rel="stylesheet" type="text/css" />
   <link href="../../stylesheets/tabs.css" rel="stylesheet" type="text/css" />
</head>
<body>
  <% if flash[:notice] %>
<div align="center">
<table width="60%" height="30" border="0" align="center" cellpadding="0" cellspacing="0" id="notice">
      <tr>
        <td class="msj">&nbsp;&nbsp;<%= flash[:notice] %></td>
      </tr>
</table>
</div>
<script type="text/javascript">setTimeout("new Effect.Fade('notice');", 5000)</script>
<% end %>
<% if flash[:warning] %>
<div align="center">
<table width="60%" height="30" border="0" align="center" cellpadding="0" cellspacing="0" id="notice">
      <tr>
        <td class="msj">&nbsp;&nbsp;<%= flash[:warning] %></td>
      </tr>
</table>
</div>
<script type="text/javascript">setTimeout("new Effect.Fade('notice');", 5000)</script>
<% end %>
  <div id="yield">
	  <%= yield  %>
   </div>
</body>
</html>