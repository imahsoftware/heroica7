<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
	"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
   <meta http-equiv="content-type" content="text/html;charset=UTF-8" />
   <title>...::: <%=Parametro.find(12).valor.to_s%> :::...</title>
   <script type="text/javascript">
      var GB_ROOT_DIR = "/greybox/";
   </script>
<%= stylesheet_link_tag 'scaffold','/greybox/gb_styles','base','ipad','nike','home','c','dhtml-horiz'%>
   <%= javascript_include_tag '/greybox/AJS' %>
   <%= javascript_include_tag '/greybox/AJS_fx' %>
   <%= javascript_include_tag '/greybox/gb_scripts' %>
   <%= javascript_include_tag 'script' %>
   <%= javascript_include_tag "prototype" %>
   <%= javascript_include_tag :defaults %>
<%= calendar_date_select_includes "blue",:locale=>'es' %>
</head>
<body id="guided-tours">
<% if flash[:notice] %>
<div align="center">
<table width="60%" height="30" border="0" align="center" cellpadding="0" cellspacing="0" id="notice">
      <tr>
        <td class="msj">&nbsp;&nbsp;<%= flash[:notice] %></td>
      </tr>
</table>
</div>
<script type="text/javascript">setTimeout("new Effect.Fade('notice');", 5000)</script>
<% end %>
<% if flash[:warning] %>
<div align="center">
<table width="60%" height="30" border="0" align="center" cellpadding="0" cellspacing="0" id="notice">
      <tr>
        <td class="msj">&nbsp;&nbsp;<%= flash[:warning] %></td>
      </tr>
</table>
</div>
<script type="text/javascript">setTimeout("new Effect.Fade('notice');", 5000)</script>
<% end %>
<div id="productheader">
	<h2><img src="/images/evial1.png" alt="iPad"></h2>
</div>
<div id="main">
  <div class="content">
    <table width="500" height="370" border="0" align="center" cellpadding="0" cellspacing="0">
  <tr valign="top">
    <td><div style="position: relative; display:block; height: 100%; top: 2px;">
      <div id="yield">
        <%= yield :head %>
        <%=yield %>
      </div>
    </div></td>
  </tr>
</table>
  </div>
</div>
<div id="globalfooter">
				<div class="gf-sosumi">
	<p>© Copyright 2011, Todos los Derechos Reservados - Powered Fabian Fernandez 2011, Antioquia</p>
</div>

</div><!--/globalfooter-->
</body>
</html>