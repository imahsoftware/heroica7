<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
	"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
   <meta http-equiv="content-type" content="text/html;charset=UTF-8" />
   <title>...::: <%=Parametro.find(12).valor.to_s%> :::...</title>
   <script type="text/javascript">
      var GB_ROOT_DIR = "/greybox/";
function mostrardiv() {
div = document.getElementById('flotante');
div.style.display = "";
}

function cerrar() {
div = document.getElementById('flotante');
div.style.display="none";
}

function mostrardivobliga(valor) {
div = document.getElementById(valor);
div.style.display = "";
}

function cerrardivobliga(valor) {
div = document.getElementById(valor);
div.style.display="none";
}

function mostrardivobligagestion(valor) {
div = document.getElementById(valor);
div.style.display = "";
}

function cerrardivobligagestion(valor) {
div = document.getElementById(valor);
div.style.display="none";
}

function mostrardiv2() {
div = document.getElementById('flotante2');
div.style.display = "";
}

function cerrar2() {
div = document.getElementById('flotante2');
div.style.display="none";
}
 </script>
<%= stylesheet_link_tag 'scaffold','/greybox/gb_styles','base','ipad','nike','home','c','dhtml-horiz'%>
   <%= javascript_include_tag '/greybox/AJS' %>
   <%= javascript_include_tag '/greybox/AJS_fx' %>
   <%= javascript_include_tag '/greybox/gb_scripts' %>
   <%= javascript_include_tag 'script' %>
   <%= javascript_include_tag "prototype" %>
   <%= javascript_include_tag :defaults %>
<%= calendar_date_select_includes "blue",:locale=>'es' %>
</head>
  <body OnLoad="setFocus()" id="guided-tours">
<% if flash[:notice] %>
<div id="footer_wrap">
<table width="100%" border="0" cellpadding="5" cellspacing="3">
      <tr>
        <td width="5%"><div align="right"><img src="/images/connect.png"></div></td>
        <td width="95%" class="campos">&nbsp;&nbsp;<%= flash[:notice] %></td>
     </tr>
  </table>
</div>
<script type="text/javascript">
    setTimeout("new Effect.Fade('footer_wrap');", 5000)
</script>
<% end %>
<% if flash[:warning] %>
<div id="footer_wrap">
<table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#FFFF99">
      <tr>
        <td width="5%"><div align="right"><img src="/images/cancel.png"></div></td>
        <td width="95%" class="campos">&nbsp;&nbsp;<%= flash[:warning] %></td>
     </tr>
  </table>
</div>
<script type="text/javascript">
    setTimeout("new Effect.Fade('footer_wrap');", 5000)
</script>
<% end %>
<div id="productheader">
	<h2><img src="/images/evial1.png" alt="iPad"></h2>
	<ul>
<% if current_user %>
    <% @usersmodulos.each do |usersmodulo| %>
          <li><%= link_to image_tag("#{usersmodulo.modulo.imagen}", { :border => 0, :title => "#{usersmodulo.modulo.descripcion}" }), "#{usersmodulo.modulo.controlador}" %></li>
    <% end %>
   <li><%= link_to image_tag('menus.png', { :border => 0, :title => "Menu" }),menus_path %></li>
<% end %>
<li><%= link_to image_tag('cliente1.png', { :border => 0, :title => "Clave" }),editpass_user_path(is_admin)%></li>
<li><%= link_to image_tag('door_out.png', { :border => 0, :title => "Salir" }),user_session_path,
                      :confirm => "Esta seguro "+"#{current_user.nombre.upcase}"+ " que quiere Desconectarse?",
                      :method => :delete %></li>
	</ul>
</div>
<div id="main">
  <div class="content">
    <table width="100%" height="500" border="0" align="center" cellpadding="0" cellspacing="0">
  <tr valign="top">
    <td><div style="position: relative; display:block; height: 100%; top: 2px;">
      <div id="yield">
        <%= yield :head %>
        <%=yield %>
      </div>
    </div></td>
  </tr>
</table>
  </div>
</div>
<div id="globalfooter">
				<div class="gf-sosumi">
	<p>© Copyright 2012, Todos los Derechos Reservados - Powered Fabian Fernandez 2012, Antioquia</p>
</div>

</div><!--/globalfooter-->
  </body>
</html>
