<%= stylesheet_link_tag 'tabs'%>
<%= javascript_include_tag 'fabtabulous' %>
<div id="productheader">
  <h2><img src="/images/entradassalidas.png"></h2>
  <div align="right">
   <%= link_to 'Buscar Registro', busqueda_parqueaderos_path, :class=>"regresarlink" %>&nbsp;&nbsp;</div>
</div>
<fieldset>
<%  form_for @parqueadero do |f| %>
<br/>
<div align="center">
<table width="80%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Fecha y Hora :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" >
      <%= calendar_date_select "parqueadero", "fecha_hora", :year_range => 50.years.ago..0.years.ago, :class=> "campo", :size => 25%>
    </td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Tipo de Registro :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" >
      <%= select(:parqueadero,
                :tipo, {"ENTRADA" => "ENTRADA",
                           "SALIDA" => "SALIDA"},
                        { :include_blank => true },
                      { :style=>"width:100px", :class => "campo", :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb'" })%>
    </td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Placa :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" >
    <%=select("parqueadero", "placa_id", Placa.find(:all,:order=>'descripcion').collect {|p| [ p.descripcion, p.id ] }, { :include_blank => true },
      { :style=>"width:100px", :class => "campo", :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb'" }) %></td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Instructor a Cargo :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" >
      <%=select("parqueadero", "instructor_id", Instructor.find(:all,:order=>'nombre').collect {|p| [ p.nombre, p.id ] }, { :include_blank => true },
      { :style=>"width:300px", :class => "campo", :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb'" }) %></td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Kilometraje :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" >
      <%= f.text_field :kilometraje_entrada,{ :class => "campo", :size => 15,
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }  %>
    </td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Cantidad de Combustible :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%= f.text_field :cant_combustible,{ :class => "campo", :size => 15,
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }  %></td>
  </tr>
  <tr valign="middle">
    <td height="30"></td>
    <td height="30"><%= submit_tag "Guardar", :name => nil, :disable_with => "Guardando" , :class=>"buttonAsLink"%></td>
  </tr>
</table>
</div>
<% end %>
</fieldset>
<br/>
