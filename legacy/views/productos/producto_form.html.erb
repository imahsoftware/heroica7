<%= stylesheet_link_tag 'tabs'%>
<%= javascript_include_tag 'fabtabulous' %>
<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;PRODUCTO</span>
  <div align="right">
   <%= link_to 'Listado', productos_path, :class=>"regresarlink" %>&nbsp;&nbsp;
  </div>
</div>
<br/>
<fieldset>
<%  form_for(@producto) do |f| %>
<div align="center">
<table width="80%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr valign="middle">
    <td width="20%" height="30" ><div align="right"><strong>Descripcion :&nbsp;&nbsp;</strong></div></td>
    <td width="80%" height="30" ><%= f.text_field :descripcion,{ :class => "campo",:size => 70,
                :onFocus => "this.style.border='1px solid #f00'",
                :onBlur => "this.style.border='1px solid #bbb'",
                :onChange=> "javascript:this.value=this.value.toUpperCase();"
                 }  %></td>
  </tr>
<% unless @producto.new_record? %>
  <tr valign="middle">
    <td height="30" ><div align="right"><strong>Creacion :&nbsp;&nbsp;</strong></div></td>
    <td height="30" ><%=@producto.created_at.strftime("%Y-%m-%d %X")%> - <%=@producto.user.username rescue nil%></td>
  </tr>
  <tr valign="middle">
    <td height="30" ><div align="right"><strong>Ult.Act :&nbsp;&nbsp;</strong></div></td>
    <td height="30" ><%=@producto.updated_at.strftime("%Y-%m-%d %X")%> - <%=User.find(@producto.user_actualiza).username rescue nil%></td>
  </tr>
<% end %>
  <tr valign="middle">
    <td height="30"></td>
    <td height="30"><%= submit_tag "Guardar", :name => nil, :disable_with => "Guardando" , :class=>"buttonAsLink"%></td>
  </tr>
</table>
</div>
<% end %>
</fieldset>
<br/>
