<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;PRODUCTOS</span>
  <div align="right">
   <%= link_to "Nuevo",new_producto_path,:class=>"nuevolink"%>&nbsp;&nbsp;
  </div>
</div>
<br/>
<div align="center">
<table width="90%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr valign="middle">
    <td width="85%" height="30" class="oce-first">Descripcion</td>
    <td width="15%" class="oce-first">&nbsp;</td>
  </tr>
<% @productos.each do |producto| %>
  <tr valign="middle" class="<%=cycle('even1', 'odd1')%>">
    <td class="camposDesc"><%=h producto.descripcion %></td>
    <td class="camposDesc"><%= link_to 'Editar', edit_producto_path(producto), :class=>"editarlink" %>
<%= link_to 'Borrar', producto, :confirm => 'Are you sure?', :method => :delete, :class=>"borrarlink" %></td>
  </tr>
<% end %>
</table>
<br/>
<table width="90%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
   <tr>
     <td width="100%" class="oce-first"><div align="center">Total Registros: <%= @productos.count %></div></td>
   </tr>
</table>
<br/>
</div>