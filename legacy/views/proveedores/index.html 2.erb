<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;PROVEEDORES</span>
  <div align="right">
   <%= link_to "Nuevo",new_proveedor_path,:class=>"nuevolink"%>&nbsp;&nbsp;
  </div>
</div>
<br/>
<div align="center">
<table width="90%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr valign="middle">
    <td class="oce-first">Proveedor</td>
    <td width="20%" class="oce-first">Telefonos</td>
    <td width="20%" class="oce-first">Email</td>
    <td width="15%" class="oce-first">&nbsp;</td>
  </tr>
<% @proveedores.each do |proveedor| %>
  <tr valign="middle" class="<%=cycle('even1', 'odd1')%>">
    <td class="camposDesc"><%=h proveedor.autobuscar %><br/><strong><%=h proveedor.contacto %></strong></td>
    <td class="camposDesc"><%=h proveedor.telefonos %></td>
    <td class="camposDesc"><%=h proveedor.email %></td>
    <td class="camposDesc">
      <%= link_to 'Editar', edit_proveedor_path(proveedor), :class=>"editarlink" %>
<%= link_to 'Borrar', proveedor, :confirm => 'Are you sure?', :method => :delete, :class=>"borrarlink" %></td>
  </tr>
<% end %>
</table>
<br/>
<table width="90%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
   <tr>
     <td width="100%" class="oce-first"><div align="center">Total Registros: <%= @proveedores.count %></div></td>
   </tr>
</table>
<br/>
</div>