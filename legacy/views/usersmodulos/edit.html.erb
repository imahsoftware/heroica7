<h1>Editing usersmodulo</h1>

<% form_for(@usersmodulo) do |f| %>
  <%= f.error_messages %>

  <p>
    <%= f.label :user_id %><br />
    <%= f.text_field :user_id %>
  </p>
  <p>
    <%= f.label :modulo_id %><br />
    <%= f.text_field :modulo_id %>
  </p>
  <p>
    <%= f.submit 'Update' %>
  </p>
<% end %>

<%= link_to 'Show', @usersmodulo %> |
<%= link_to 'Back', usersmodulos_path %>