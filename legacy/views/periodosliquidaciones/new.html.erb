<h1>New periodosliquidacion</h1>

<% form_for(@periodosliquidacion) do |f| %>
  <%= f.error_messages %>

  <p>
    <%= f.label :inicio %><br />
    <%= f.date_select :inicio %>
  </p>
  <p>
    <%= f.label :fin %><br />
    <%= f.date_select :fin %>
  </p>
  <p>
    <%= f.label :estado %><br />
    <%= f.text_field :estado %>
  </p>
  <p>
    <%= f.submit 'Create' %>
  </p>
<% end %>

<%= link_to 'Back', periodosliquidaciones_path %>