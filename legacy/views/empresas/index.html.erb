<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;INFORMACION EMPRESAS</span>
</div>
<br/>
<div align="center">
<% if permiso("empresa","C").to_s == "S" %>
<table width="80%" height="40" border="0" cellpadding="0" cellspacing="0">
   <tr>
    <td><% form_remote_tag :url => {:action => 'add_empresa'}, :complete => "empresa_nombre.value=nil empresa_identificacion.value=nil empresa_direccion.value=nil empresa_telefono.value=nil" do %>
<table width="100%" height="40" border="0" cellpadding="0" cellspacing="0">
   <tr>
     <td width="30%" class="campos">Identificacion</td>
     <td width="70%" class="campos">Nombre</td>
   </tr>
   <tr>
     <td>
<%= select('empresa', 'documento', { "C.C." => "CC",
                                     "T.I." => "TI",
                                   "NIT" => "NIT",
                                 "PAS" => "PAS",
                                 "C.E." => "CE"},
                                  { :include_blank => true },
                                { :style=>"width:70px", :class => "campo", :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb'" })%> -
                              <%= text_field 'empresa', 'identificacion',{ :class => "campo",
                :size => 20,
                :onFocus => "this.style.border='1px solid #f00',this.value=''",
                :onBlur => "this.style.border='1px solid #bbb'",
                :onChange=> "javascript:this.value=this.value.toUpperCase();"
                 }  %></td>
     <td><%= text_field 'empresa', 'nombre',{ :class => "campo",
                :size => 70,
                :onFocus => "this.style.border='1px solid #f00',this.value=''",
                :onBlur => "this.style.border='1px solid #bbb'"
                 }  %></td>
   </tr>
</table>

<table width="100%" height="40" border="0" cellpadding="0" cellspacing="0">
   <tr>
     <td width="50%" class="campos">Direccion</td>
     <td width="30%" class="campos">Telefono</td>
     <td width="20%" class="campos"></td>
   </tr>
   <tr>
     <td><%= text_field 'empresa', 'direccion',{ :class => "campo",
                :size => 50,
                :onFocus => "this.style.border='1px solid #f00',this.value=''",
                :onBlur => "this.style.border='1px solid #bbb'",
                :onChange=> "javascript:this.value=this.value.toUpperCase();"
                 }  %></td>
     <td><%= text_field 'empresa', 'telefono',{ :class => "campo",
                :size => 20,
                :onFocus => "this.style.border='1px solid #f00',this.value=''",
                :onBlur => "this.style.border='1px solid #bbb'"
                 }  %></td>
      <td><%= submit_tag "Guardar", :class=>"buttonAsLink"%></td>
   </tr>
</table>

     <% end %></td>
  </tr>
</table>
<br />
<% end %>
<div id="empresa_list">
<%= render :partial => 'list' %>
  <div id="notice"><%= flash[:notice] %></div>
</div>
<br/>
</div>
