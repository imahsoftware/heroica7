<h1>Listing empresas</h1>

<table>
  <tr>
    <th>Documento</th>
    <th>Identificacion</th>
    <th>Nombre</th>
    <th>Direccion</th>
    <th>Telefono</th>
  </tr>

<% @empresas.each do |empresa| %>
  <tr>
    <td><%=h empresa.documento %></td>
    <td><%=h empresa.identificacion %></td>
    <td><%=h empresa.nombre %></td>
    <td><%=h empresa.direccion %></td>
    <td><%=h empresa.telefono %></td>
    <td><%= link_to 'Show', empresa %></td>
    <td><%= link_to 'Edit', edit_empresa_path(empresa) %></td>
    <td><%= link_to 'Destroy', empresa, :confirm => 'Are you sure?', :method => :delete %></td>
  </tr>
<% end %>
</table>

<br />

<%= link_to 'New empresa', new_empresa_path %>