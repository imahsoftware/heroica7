<%= stylesheet_link_tag 'tabs'%>
<%= javascript_include_tag 'fabtabulous' %>
<div id="productheader">
  <h2><img src="/images/mantenimientos.png"></h2>
  <div align="right">
   <%= link_to 'Buscar Registro', busqueda_mantenimientos_path, :class=>"regresarlink" %>&nbsp;&nbsp;</div>
</div>
<fieldset>
<%  form_for @mantenimiento do |f| %>
<div align="center">
<table width="80%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Placa :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" >
    <%=select("mantenimiento", "placa_id", Placa.find(:all,:order=>'descripcion').collect {|p| [ p.descripcion, p.id ] }, { :include_blank => true },
      { :style=>"width:100px", :class => "campo", :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb'" }) %></td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Descripción :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" >
      <%= f.text_area(:descripcion, :cols => 100, :rows => 5, :class => 'campo', :maxlength => 4000,
:onChange=> "javascript:this.value=this.value.toUpperCase();") %></td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Fecha de Ingreso :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" >
      <%= calendar_date_select "mantenimiento", "fecha", :year_range => 50.years.ago..0.years.ago, :time => false, :class=> "campo", :size => 10%>
    </td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Eficacia :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" >
      <%= select(:mantenimiento,
                :eficacia, { "SI" => "SI",
                           "NO" => "NO"},
                        { :include_blank => true },
                      { :style=>"width:100px", :class => "campo", :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb'" })%>
      </td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Kilometraje :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%= f.text_field :kilometraje,{ :class => "campo", :size => 15,
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }  %></td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Taller :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%= f.text_area(:taller, :cols => 100, :rows => 2, :class => 'campo', :maxlength => 4000,
:onChange=> "javascript:this.value=this.value.toUpperCase();") %></td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Costo Repuestos:&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%= f.text_field :costo_repuestos,{ :class => "campo", :size => 15,
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }  %></td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Costo Mano de Obra:&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%= f.text_field :costo_obra,{ :class => "campo", :size => 15,
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }  %></td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Costo Total:&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%= f.text_field :costo,{ :class => "campo", :size => 15,
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }  %></td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Observaciones :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" >
      <%= f.text_area(:observaciones, :cols => 100, :rows => 5, :class => 'campo', :maxlength => 4000,
:onChange=> "javascript:this.value=this.value.toUpperCase();") %></td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Fecha de Salida :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" >
      <%= calendar_date_select "mantenimiento", "fecha_salida", :year_range => 50.years.ago..0.years.ago, :time => false, :class=> "campo", :size => 10%>
    </td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Instructor a Cargo :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" >
      <%=select("mantenimiento", "instructor_id", Instructor.find(:all,:order=>'nombre').collect {|p| [ p.nombre, p.id ] }, { :include_blank => true },
      { :style=>"width:300px", :class => "campo", :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb'" }) %></td>
  </tr>
  <tr valign="middle">
    <td height="30"></td>
    <td height="30"><%= submit_tag "Guardar", :name => nil, :disable_with => "Guardando" , :class=>"buttonAsLink"%></td>
  </tr>
</table>
</div>
<% end %>
</fieldset>
<br/>
