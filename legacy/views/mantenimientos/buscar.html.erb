<div id="productheader">
  <h2>&nbsp;<img src="/images/mantenimientos.png"></h2>
  <div align="right">
     <%= link_to 'Buscar Registros', busqueda_mantenimientos_path, :class=>"regresarlink" %>&nbsp;&nbsp;
  </div>
</div>
<br/>
<table width="70%" border="0" align="center" cellpadding="0" cellspacing="0">
  <tr valign="middle">
    <td width="20%" height="30" class="oce-first">Placa</td>
    <td width="20%" class="oce-first">Fecha</td>
    <td width="20%" class="oce-first">Descripcion</td>
    <td width="20%" class="oce-first">Taller</td>
    <td width="20%" class="oce-first">&nbsp;</td>
  </tr>
</table>
<table width="70%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <% @mantenimientos.each do |mantenimiento| %>
  <tr valign="middle">
    <td width="20%" height="30" class="camposDesc"><%=h mantenimiento.placa.descripcion rescue nil %></td>
    <td width="20%" class="camposDesc"><%=mantenimiento.fecha%></td>
    <td width="20%" class="camposDesc"><%=mantenimiento.descripcion%></td>
    <td width="20%" class="camposDesc"><%=mantenimiento.taller%></td>
    <td width="20%"><div align="center">
        <%= link_to 'Editar', edit_mantenimiento_path(mantenimiento),:class=>"editarlink"%>
    </div></td>
  </tr>
  <% end %>
</table>
<table width="80%" height="0" align="center" border="0" cellpadding="0" cellspacing="0">
  <tr>
    <td height="10"><hr size="1" noshade class="hrlinea"></td>
  </tr>
</table>
<table width="80%" border="0" align="center" cellpadding="0" cellspacing="0">
  <tr valign="middle">
    <td width="100%" height="30" class="camposDescN"><div align="center">Nro Total de Registro : <%=@mantenimientos.count%></div></td>
  </tr>
</table> 
