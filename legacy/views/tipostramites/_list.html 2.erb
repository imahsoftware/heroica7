  <div align="center">
<table width="50%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr valign="middle">
    <td width="80%" height="30" class="oce-first">Descripcion</td>
    <td width="20%" class="oce-first"></td>
  </tr>
<% for tipostramite in @tipostramites%>
  <tr class="postS_<%=tipostramite.id%>">
    <td  class="camposDesc"><%=h tipostramite.descripcion %></td>
    <td  class="camposDesc"><div align="center">
        <% if permiso("tipostramite","A").to_s == "S" %>
        <%= link_to 'Editar', edit_tipostramite_path(tipostramite), :class=>"editarlink" %>
        <%= link_to_remote 'Borrar',{
                :url => tipostramite_path(tipostramite),
                :method => :delete,
                :confirm => "¿Seguro?",
                :before => "$(this).up('.postS_#{tipostramite.id}').remove()"},
                :class=>"borrarlink"%>
        <% end %>
        </div>
   </td>
  </tr>
<% end %>
</table>
</div>


