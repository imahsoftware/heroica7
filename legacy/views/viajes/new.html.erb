<h1>New viaje</h1>

<% form_for(@viaje) do |f| %>
  <%= f.error_messages %>

  <p>
    <%= f.label :tiposviaje_id %><br />
    <%= f.text_field :tiposviaje_id %>
  </p>
  <p>
    <%= f.label :identificacion %><br />
    <%= f.text_field :identificacion %>
  </p>
  <p>
    <%= f.label :nombre %><br />
    <%= f.text_field :nombre %>
  </p>
  <p>
    <%= f.label :apellido %><br />
    <%= f.text_field :apellido %>
  </p>
  <p>
    <%= f.label :peso %><br />
    <%= f.text_field :peso %>
  </p>
  <p>
    <%= f.label :horario %><br />
    <%= f.text_field :horario %>
  </p>
  <p>
    <%= f.label :habitacionhotel %><br />
    <%= f.text_field :habitacionhotel %>
  </p>
  <p>
    <%= f.submit 'Create' %>
  </p>
<% end %>

<%= link_to 'Back', viajes_path %>