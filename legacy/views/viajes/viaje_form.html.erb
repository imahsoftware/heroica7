<%= stylesheet_link_tag 'tabs'%>
<%= javascript_include_tag 'fabtabulous' %>
<div id="productheader">
  <h2><img src="/images/tours.png"></h2>
  <div align="right">
   <%= link_to 'Buscar Registro', busqueda_viajes_path, :class=>"regresarlink" %>&nbsp;&nbsp;</div>
</div>
<fieldset>
<%  form_for @viaje do |f| %>
<div align="center">
<table width="80%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Tipo de Tour : *&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" >
    <%=select("viaje", "tiposviaje_id", Tiposviaje.find(:all,:order=>'descripcion').collect {|p| [ p.descripcion, p.id ] }, { :include_blank => true },
      { :style=>"width:300px", :class => "campo", :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb'" }) %>
      <%= error_message_on :viaje, :tiposviaje_id, :css_class =>"cerror"%></td>
  </tr>
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Identificacion : *&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%= f.text_field :identificacion,{ :class => "campo", :size => 30,
              :onChange=> "javascript:this.value=this.value.toUpperCase();",
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }  %>
    <%= error_message_on :viaje, :identificacion, :css_class =>"cerror"%></td>
  </tr>
<tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Nombre : *&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%= f.text_field :nombre,{ :class => "campo", :size => 50,
  :onChange=> "javascript:this.value=this.value.toUpperCase();",
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }  %>
    <%= error_message_on :viaje, :nombre, :css_class =>"cerror"%></td>
  </tr>
<tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Apellido : *&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%= f.text_field :apellido,{ :class => "campo", :size => 50,
  :onChange=> "javascript:this.value=this.value.toUpperCase();",
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }  %>
      <%= error_message_on :viaje, :apellido, :css_class =>"cerror"%></td>
  </tr>
<tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Peso (En libras): *&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%= f.text_field :peso,{ :class => "campo", :size => 15,
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }  %>
      <%= error_message_on :viaje, :peso, :css_class =>"cerror"%></td>
  </tr>
<tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Horario :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%= f.text_field :horario,{ :class => "campo", :size => 30,
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }  %></td>
  </tr>
<tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Habitacion Hotel :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%= f.text_field :habitacionhotel,{ :class => "campo", :size => 15,
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }  %></td>
  </tr>
  <tr valign="middle">
    <td height="30"></td>
    <td height="30"><%= submit_tag "Guardar", :name => nil, :disable_with => "Guardando" , :class=>"buttonAsLink"%>
      <% unless @viaje.new_record? %>
        <% if Viajesrecibo.exists?(["viaje_id = ? and estado = 0", @viaje.id]) == false %>
        &nbsp;|&nbsp; <%=link_to 'Generar Recibo', {:controller => "viajesrecibos", :action=>"crearrecibo", :viaje_id => @viaje.id, :tiposviaje => @viaje.tiposviaje_id}, :confirm=>"Esta seguro?"%>
        <% else %>
         &nbsp;|&nbsp; <%=link_to 'Ver Recibo', {:controller => "viajesrecibos", :action=>"show", :viaje_id => @viaje.id},:popup => ['new_window','height=330,width=700,scrollbars=yes']%>
         &nbsp;|&nbsp; <%=link_to 'Anular Recibo', {:controller => "viajesrecibos", :action=>"eliminar", :viaje_id => @viaje.id}, :confirm=>"Esta seguro?"%>
        <% end %>
      <% end %>
    </td>
  </tr>
</table>
</div>
<% end %>
</fieldset>
<br/>
