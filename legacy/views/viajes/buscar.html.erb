<div id="productheader">
  <h2>&nbsp;<img src="/images/tours.png"></h2>
  <div align="right">
     <%= link_to 'Buscar Registros', busqueda_viajes_path, :class=>"regresarlink" %>&nbsp;&nbsp;
  </div>
</div>
<br/>
<table width="70%" border="0" align="center" cellpadding="0" cellspacing="0">
  <tr valign="middle">
    <td width="30%" height="30" class="oce-first">Tipo de Tour</td>
    <td width="15%" class="oce-first">Identificacion</td>
    <td width="45%" class="oce-first">Nombre</td>
    <td width="10%" class="oce-first">&nbsp;</td>
  </tr>
</table>

<table width="70%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <% @viajes.each do |viaje| %>
  <tr valign="middle">
    <td width="30%" height="30" class="camposDesc"><%=h viaje.tiposviaje.descripcion rescue nil %></td>
    <td width="15%" class="camposDesc"><%=viaje.identificacion%></td>
    <td width="45%" class="camposDesc"><%=viaje.nombre%> <%=viaje.apellido%></td>
    <td width="10%"><div align="center">
        <%= link_to 'Editar', edit_viaje_path(viaje),:class=>"editarlink"%>
    </div></td>
  </tr>
  <% end %>
</table>
<table width="80%" height="0" align="center" border="0" cellpadding="0" cellspacing="0">
  <tr>
    <td height="10"><hr size="1" noshade class="hrlinea"></td>
  </tr>
</table>
<table width="80%" border="0" align="center" cellpadding="0" cellspacing="0">
  <tr valign="middle">
    <td width="100%" height="30" class="camposDescN"><div align="center">Nro Total de Registro : <%=@viajes.count%></div></td>
  </tr>
</table> 
