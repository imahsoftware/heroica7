<div id="productheader">
  <h2>&nbsp;<img src="/images/tours.png"></h2>
  <div align="right">
     <%= link_to "Nuevo",new_viaje_path,:class=>"nuevolink"%>&nbsp;&nbsp;
  </div>
</div>
<br/>
<% form_tag buscar_viajes_path, :method => 'get' do %>
<table width="80%" border="0" align="center" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Tipo de Tour :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%=select("ubicacion", "tour", Tiposviaje.find(:all,:order=>'descripcion').collect {|p| [ p.descripcion, p.id ] }, { :include_blank => true },
      { :style=>"width:300px", :class => "campo", :onFocus => "this.style.border='1px solid #f00'", :onBlur => "this.style.border='1px solid #bbb'" }) %></td>
  </tr>
   <tr valign="middle">
    <td width="30%" height="30" ><div align="right"><strong>Identificacion :&nbsp;&nbsp;</strong></div></td>
    <td width="70%" height="30" ><%= text_field_tag :identificacion, params[:identificacion],{ :class => "campo", :size => 15,
              :onFocus => "this.style.border='1px solid #f00'",
              :onBlur => "this.style.border='1px solid #bbb'" }  %></td>
  </tr>
  <tr valign="middle">
    <td height="30"></td>
    <td height="30">
<%= submit_tag "Buscar", :name => nil, :disable_with => "Buscando..." , :class=>"buttonAsLink"%></td>
  </tr>
</table>
<% end %>
<br/>
<br/>
<br/>
<div id="productheader">
  <h2>&nbsp;<img src="/images/informerecibos.png"></h2>
</div>
<% form_tag informe_viajes_path, :method => 'get' do %>
      <%= submit_tag "Informe",:class=>"buttonAsLink" %>
<% end %>

