<% form_for :personastramiteshora, @personastramiteshora,
            :url => hora_personastramiteshora_path(@personastramite, @personastramiteshora),
            :html => {:method => :put} do |f| %>
  <%= render :partial => 'form', :locals => { :f => f } %>
<div align="center">
<table width="90%" height="0" border="0" cellpadding="0" cellspacing="0">
  <tr>
    <td height="20"><hr size="1" noshade class="hrlinea"></td>
  </tr>
</table>
<table width="90%" height="20" border="0" cellpadding="0" cellspacing="0">
   <tr>
     <td><div align="right"><%= f.submit "Guardar",:class=>"buttonAsLink" %>
         <%= link_to 'Regresar',hora_personastramiteshoras_path(@personastramite),:class=>"regresarlink" %></div></td>
  </tr>
</table>
</div>
<% end %>

