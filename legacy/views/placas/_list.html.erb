  <div align="center">
<table width="50%" border="0" cellpadding="0" cellspacing="0" id="one-column-emphasis">
  <tr>
    <td class="oce-first" width="20%">Id</td>
    <td class="oce-first" width="60%">Placa</td>
    <td class="oce-first" width="20%"></td>
  </tr>
<% for placa in @placas%>
  <tr class="postS_<%=placa.id%>">
    <td ><%=h placa.id %></td>
    <td ><%=h placa.descripcion %></td>
    <td ><div align="center">
                <%= link_to 'Editar', edit_placa_path(placa), :class=>"editarlink" %>
        <%= link_to_remote 'Borrar',{
                :url => placa_path(placa),
                :method => :delete,
                :confirm => "¿Seguro?",
                :before => "$(this).up('.postS_#{placa.id}').remove()"},
                :class=>"borrarlink"%>
        </div>
   </td>
  </tr>
<% end %>
</table>
</div>