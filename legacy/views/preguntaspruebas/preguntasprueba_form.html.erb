        <td width="86%"><strong><div align="left"><%=h @preguntasprueba.opcion1 %></div></strong></td>
        <td width="5%"><div align="center">
            <%= link_to image_tag('teoricor.png', { :border => 0, :title => "pulse para borrar esta opcion!"}),
                                {:controller=>"preguntaspruebas", :action =>"desmarcar", :id =>@preguntasprueba.id}%>
          </div></td>
      </tr>
      <%  else %>
      <tr>
        <td width="8%" height="60"><div align="left">Opcion 1:</div></td>
        <td width="87%"><div align="left"><%=h @preguntasprueba.opcion1 %></div></td>
        <td width="5%"><div align="center">
            <%= link_to image_tag('teoricop.png', { :border => 0, :title => "pulse para elegir esta opcion!"}),
                                {:controller=>"preguntaspruebas", :action =>"marcar", :id =>@preguntasprueba.id, :opc=>1}%>
          </div></td>
      </tr>
      <%  end %>
      <%  if @preguntasprueba.respuesta.to_s == '2' %>
