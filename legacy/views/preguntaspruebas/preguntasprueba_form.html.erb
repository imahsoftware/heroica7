          </div></td>
      </tr>
      <%  end %>
      <%  if @preguntasprueba.respuesta.to_s == '3' %>
      <tr bgcolor="#00FF00">
        <td width="9%" height="60"><strong><div align="left">Opcion 3:</div></strong></td>
