<div id="productheader">
  <span class="tit_gr_azul">&nbsp;&nbsp;PRUEBA TEORICA</span> - NNNN
</div>
<% form_for(@preguntasprueba) do |f| %>
  <div align="right"><span class="tit_gr_red">&nbsp;&nbsp;<%=h @preguntasprueba.id %>&nbsp;&nbsp;</span>&nbsp;&nbsp;</div>
  <br/>
  <div align="center">
    <table width="90%" border="0" cellspacing="1" cellpadding="1">
      <tr>
        <td class="tit_gr_red2">
