      <tr>
        <% if @preguntasprueba.id == 1 %>
        <td>
          <div align="left">&nbsp;&nbsp;<img src="/images/preguntaizquierda.png"></img></div>
        </td>
        <% else %>
        <td>
          <div align="left">&nbsp;&nbsp;<%= link_to image_tag('preguntaizquierda.png', { :border => 0, :title => "Retroceder"}),
