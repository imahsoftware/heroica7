<h1>Listing preguntas</h1>

<table>
  <tr>
    <th>Descripcion</th>
    <th>Opcion1</th>
    <th>Opcion2</th>
    <th>Opcion3</th>
    <th>Opcion4</th>
    <th>Opcion5</th>
    <th>Grafica</th>
    <th>Grupo</th>
    <th>Codigo</th>
    <th>Multiple</th>
  </tr>

<% @preguntas.each do |pregunta| %>
  <tr>
    <td><%=h pregunta.descripcion %></td>
    <td><%=h pregunta.opcion1 %></td>
    <td><%=h pregunta.opcion2 %></td>
    <td><%=h pregunta.opcion3 %></td>
    <td><%=h pregunta.opcion4 %></td>
    <td><%=h pregunta.opcion5 %></td>
    <td><%=h pregunta.grafica %></td>
    <td><%=h pregunta.grupo %></td>
    <td><%=h pregunta.codigo %></td>
    <td><%=h pregunta.multiple %></td>
    <td><%= link_to 'Show', pregunta %></td>
    <td><%= link_to 'Edit', edit_pregunta_path(pregunta) %></td>
    <td><%= link_to 'Destroy', pregunta, :confirm => 'Are you sure?', :method => :delete %></td>
  </tr>
<% end %>
</table>

<br />

<%= link_to 'New pregunta', new_pregunta_path %>