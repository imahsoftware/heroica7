<%= simple_form_for([@portafolio, @portafolioscuenta], remote: true) do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :descripcion, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %></div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :portafoliosccontable_id, collection: Portafoliosccontable.order(:descripcion).collect {|p| [ p.descripcion_contables, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: 'Contables' %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :nro_cuenta, input_html: {:onchange => "javascript:this.value=this.value.toUpperCase();"} %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :tipo, collection: Iparametro.where(campo: 'clasedecuenta').order(:descripcion).collect {|p| [ p.descripcion, p.descripcion ] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
      <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2"><%= f.input :estado, collection: Iparametro.where(campo: 'estados').order(:descripcion).collect {|p| [ p.descripcion, p.descripcion ] }, input_html: { class: 'select2' }, as: :select, include_blank: true %></div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :contrapartida_nomina, collection: Portafoliosccontable.where("portafolio_id = #{@portafolio.id}").order(:descripcion).collect {|p| [ p.descripcion_contables, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: 'Contrapartida Nomina' %></div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :contrapartida_vacaciones, collection: Portafoliosccontable.where("portafolio_id = #{@portafolio.id}").order(:descripcion).collect {|p| [ p.descripcion_contables, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: 'Contrapartida Vacaciones' %></div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :contrapartida, collection: Portafoliosccontable.where("portafolio_id = #{@portafolio.id}").order(:descripcion).collect {|p| [ p.descripcion_contables, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: 'Contrapartida Liquidación' %></div>

      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :contrapartida_prima, collection: Portafoliosccontable.where("portafolio_id = #{@portafolio.id}").order(:descripcion).collect {|p| [ p.descripcion_contables, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: 'Contrapartida Prima' %></div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :contrapartida_int_cesantias, collection: Portafoliosccontable.where("portafolio_id = #{@portafolio.id}").order(:descripcion).collect {|p| [ p.descripcion_contables, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: 'Contrapartida Int Cesantias' %></div>
      <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :contrapartida_cesantias, collection: Portafoliosccontable.where("portafolio_id = #{@portafolio.id}").order(:descripcion).collect {|p| [ p.descripcion_contables, p.id ] }, input_html: { class: 'select2' }, as: :select, include_blank: true, label: 'Contrapartida Cesantias' %></div>

    </div>
    <div class="row">
      <div class="col-md-6">
        <% if @portafolioscuenta.new_record? %>
          <%= button_tag "#{t :cancelar}", type: 'button', data: {target: '#portafolioscuenta_form'}, class: 'cancel_button btn btn-flat btn-default pull-left', aria_hidden: true %>
        <% else %>
          <%= link_to "#{t :cancelar}", portafolio_portafolioscuenta_path(@portafolio, @portafolioscuenta), class: 'btn btn-flat btn-default pull-left', aria_hidden: true, remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, "#{t :guardar}", class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<br/>
