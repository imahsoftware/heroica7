<div class="box box-default color-palette-box">
  <div class="box-header with-border">
    <h3 class="box-title"> Cuentas</h3>
    <div class="box-tools pull-right">
      <%= link_to new_portafolio_portafolioscuenta_path(@portafolio), id: 'new_portafolioscuenta_button', class: 'btn btn-sm btn-warning', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%= t :agregar %></span>
      <% end %>
    </div>
  </div>

  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="portafolioscuenta_form" class="collapse"></div>
    <div id="portafolioscuentas">
      <% if @portafolio.portafolioscuentas.present? %>
        <%= render 'portafolioscuentas/tabla' %>
      <% else %>
        <div class="alert alert-danger">
          <h4><i class="icon fa fa-info"></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>
      <% end %>
    </div>
  </div>
</div>