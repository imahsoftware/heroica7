<div class="box box-primary">
  <%= simple_form_for(@portafolio) do |f| %>
    <div class="box-header">
      <legend>Editar Compañia</legend>
      <% unless @portafolio.new_record? %>
        <div class="box-tools pull-right">
          <span class="label label-danger">Creacion: <%= @portafolio.created_at.strftime("%Y-%m-%d %X") rescue nil %></span>
        </div>
      <% end %>
    </div><!-- /.box-header -->
    <div class="box-body">
      <div class="row">
        <div class="col-md-4"><%= f.input :nombre %></div>
        <div class="col-md-2"><%= f.input :nombrecorto, label: 'Nombre Corto' %></div>
        <div class="col-md-2"><%= f.input :estado, collection: select_estado_portafolios, as: :select, input_html: { data: { width: '100%' }, class: 'select2' } %></div>
        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
          <%= f.input :municipio_id, collection: Municipio.where("municipiosdian_id is not null").order(:autobuscar).collect { |p| [p.autobuscar, p.id] }, input_html: { class: 'select2' }, as: :select, include_blank: true %>
        </div>
      </div>
      <legend>Datos para formatos - cartas</legend>
      <div class="row">
        <div class="col-md-4"><%= f.input :razon_social, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
        <div class="col-md-2"><%= f.input :identificacion, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
        <div class="col-md-1"><%= f.input :digito, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
        <div class="col-md-5"><%= f.input :direccion, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
      </div>
      <div class="row">
        <div class="col-md-2"><%= f.input :telefono_empresa, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
        <div class="col-md-4"><%= f.input :email_empresa, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
        <div class="col-md-6">
          <label>Responsable recurso humano
            <i class="fa fa-question-circle" title="Solo aparecen los empleados que tengan imagen de tipo firma."></i></label>
          <%= f.input :user_recursohumano, collection: User.where(["tipoconsulta not in ('PERSONA','CANDIDATO') and activo = 'S' and id in (select distinct user_id from usersimagenes)"]).order(:nombre).collect { |p| [p.nombrecompleto, p.id] }, input_html: { class: 'select2 clean' }, as: :select, include_blank: true, label: false %>
        </div>
      </div>
      <div class="row">
        <div class="col-md-2"><%= f.input :codigo_sucursal, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
        <div class="col-md-4"><%= f.input :nombre_sucursal, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" } %></div>
        <div class="col-md-2"><%= f.input :forma_presentacion, collection: Iparametro.where(campo: 'forma_presentacion_aportes').order(:descripcion).collect {|p| [ p.descripcion, p.codigo_aportes ] }, input_html: { class: 'select2' }, as: :select, include_blank: true%></div>
        <div class="col-md-4"><%= f.input :cod_actividad_eco, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: "Cod Actividad Econominca"%></div>
      </div>
      <legend>Representante Legal</legend>
      <div class="row">
        <div class="col-md-2"><%= f.input :identificacion_rep, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: 'Nro. Identificacion' %></div>
        <div class="col-md-2"><%= f.input :digito_rep, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: 'Digito' %></div>
        <div class="col-md-2"><%= f.input :nombre_rep, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: 'Primer Nombre' %></div>
        <div class="col-md-2"><%= f.input :segundo_nombre_rep, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: 'Segundo Nombre' %></div>
        <div class="col-md-2"><%= f.input :primer_apellido_rep, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: 'Primer Apellido' %></div>
        <div class="col-md-2"><%= f.input :segundo_apellido_rep, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: 'Segundo Apellido' %></div>
      </div>
      <div class="row">
        <div class="col-md-4"><%= f.input :expedicion_rep, input_html: { :onchange => "javascript:this.value=this.value.toUpperCase();" }, label: 'Expedida en?' %></div>
        <div class="col-md-4"><%= f.input :tipo_aportante, collection: Iparametro.where(campo: 'tipo_aportante_aportes').order(:descripcion).collect {|p| [ p.descripcion, p.codigo_aportes ] }, input_html: { class: 'select2' }, as: :select, include_blank: true%></div>
        <div class="col-md-4">
          <label>Representante Legal
            <i class="fa fa-question-circle" title="Solo aparecen los empleados que tengan imagen de tipo firma."></i></label>
          <%= f.input :user_replegal, collection: User.where(["tipoconsulta not in ('PERSONA','CANDIDATO') and activo = 'S' and id in (select distinct user_id from usersimagenes)"]).order(:nombre).collect { |p| [p.nombrecompleto, p.id] }, input_html: { class: 'select2 clean' }, as: :select, include_blank: true, label: false %>
        </div>
      </div>
      <div class="row">
        <div class="col-md-3"><%= f.input :logo, as: :file %></div>
      </div>
    </div>
    <div class="box-footer">
      <div class="box-tools pull-right">
        <%= f.button :submit, "#{t :guardar}", class: 'btn btn-danger' %>
      </div>
    </div>
  <% end %>
</div>

<div class="row">
  <div class="col-xs-12">
    <legend>Servicios</legend>
    <div class="nav-tabs-custom">
      <ul class="nav nav-tabs">
        <li class="active"><a href="#alegra" data-toggle="tab">Alegra</a></li>
        <li><a href="#siigo" data-toggle="tab">Siigo</a></li>
        <li><a href="#payu" data-toggle="tab">Payu</a></li>
        <li><a href="#aportes" data-toggle="tab">Aportes en Linea</a></li>
      </ul>
      <div class="tab-content">
        <div class="tab-pane" id="payu">
          <div class="alert alert-danger"><strong><%= t :atencion %> Servicio no Activado</strong></div>
        </div>
        <div class="tab-pane" id="siigo">
          <div class="alert alert-danger"><strong><%= t :atencion %> Servicio no Activado</strong></div>
        </div>
        <div class="tab-pane active" id="alegra">
          <%= simple_form_for(@portafolio) do |f| %>
            <div class="box-header">
                <span class="pull-right-container">
          <% if @portafolio.id_alegra.present? && @portafolio.habilita_alegra.present? %>
              <small class="label pull-right bg-red">Habilitada</small><% end %>
                  <% if @portafolio.id_alegra.present? %>
          <small class="label pull-right bg-blue" style="margin-right: 10px;">Creada</small>
            <% end %>
        </span>
            </div>
            <div class="box-body">
              <div class="row">
                <div class="col-md-4"><%= f.input :id_alegra, label: "Id Compañia" %></div>
                <div class="col-md-6"><%= f.input :name_alegra, label: "Nombre" %></div>
                <div class="col-md-2"><%= f.input :identificacion_alegra, label: "Nit Alegra" %></div>
              </div>
            </div>
            <div class="box-body">
              <div class="row">
                <div class="col-md-2"><%= f.input :dv_alegra, label: "Digito Verificación" %></div>
                <div class="col-md-3"><%= f.input :type_alegra, label: "Tipo", disabled: true, hint: "main: Principal, associated: Secundaria" %></div>
                <div class="col-md-5"><%= f.input :token_alegra, label: "Token" %></div>
                <div class="col-md-2"><%= f.input :habilita_alegra, disabled: true, label: "Compañia Habilitada" %></div>
              </div>
            </div>
            <div class="box-body">
              <div class="row">
                <div class="col-md-4"><%= f.input :setid_alegra, label: "Set Id" %></div>
                <div class="col-md-4"><%= f.input :governmentid_alegra, label: "Government Id" %></div>
                <div class="col-md-4"><%= f.input :url_alegra, as: :select, label: 'Servicio - URL Emitir Nomina', input_html: { class: 'select2', style: 'width: 100%' }, collection: select_url_alegra_emitir_nomina %></div>
              </div>
            </div>
            <div class="box-body">
              <div class="row">
                <div class="col-md-3"><%= f.input :url_crear_empresa_alegra, as: :select, label: 'Servicio - URL Crear Empresa', input_html: { class: 'select2', style: 'width: 100%' }, collection: select_url_alegra_crear_empresa %></div>
                <div class="col-md-3"><%= f.input :url_habilitar_empresa_alegra, as: :select, label: 'Servicio - URL Habiliar Empresa', input_html: { class: 'select2', style: 'width: 100%' }, collection: select_url_alegra_habilitar_empresa %></div>
              </div>
            </div>


            <legend>Parametrización Facturación</legend>
            <div class="row">
              <div class="col-md-4"><%= f.input :url_item, label: 'URL Crear Items' %></div>
              <div class="col-md-4"><%= f.input :url_client, label: 'URL Crear Cliente' %></div>
              <div class="col-md-4"><%= f.input :url_factura, label: 'URL Crear Factura' %></div>
            </div>
            <div class="row">
              <div class="col-md-6"><%= f.input :token_factura, label: 'Token Facturación' %></div>
            </div>


            <legend>Parametrización Soporte Documentos</legend>
            <div class="row">
              <div class="col-md-3"><%= f.input :alegra_resolution_number, label: 'Nro Resolución', hint: "Número de Resolución o de Autorización." %></div>
              <div class="col-md-3"><%= f.input :alegra_prefix, label: 'Prefix', hint: "Prefijo de la Resolución o Autorización." %></div>
              <div class="col-md-3"><%= f.input :alegra_min_number, label: 'Inicio Numeración', hint: "Valor inicial del rango de numeración." %></div>
              <div class="col-md-3"><%= f.input :alegra_max_number, label: 'Fin Numeración', hint: "Valor final del rango de numeración." %></div>
            </div>
            <div class="row">
              <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :alegra_start_date, as: :string, input_html: { class: 'datepicker', data: { date_options: { format: 'DD/MM/YYYY', ignoreReadonly: true } }, readonly: true }, label: "Fecha Inicio", hint: "Fecha de inicio de la autorización de la numeración." %></div>
              <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3"><%= f.input :alegra_end_date, as: :string, input_html: { class: 'datepicker', data: { date_options: { format: 'DD/MM/YYYY', ignoreReadonly: true } }, readonly: true }, label: "Fecha Fin", hint: "Fecha final de la autorización de la numeración." %></div>
              <div class="col-xs-12 col-sm-12 col-md-6 col-lg-6"><%= f.input :alegra_id_compania, label: 'Id Compañia', hint: "Id de la empresa. Id único generado por la API" %></div>
              <!-- # Para identificar este id se debe de consumir el servicio de consultar por medio de token https://e-provider-docs.alegra.com/reference/getcompanies -->
            </div>
            <div class="row">
              <div class="col-md-4"><%= f.input :alegra_regime_code, label: 'Codigo Regimen', hint: "Régimen o tipo de obligación o responsabilidad del emisor" %></div>
              <div class="col-md-4"><%= f.input :alegra_organization_type, label: 'Tipo de organización jurídica', hint: "Identificador de tipo de organización jurídica de la persona o empresa" %></div>
              <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4"><%= f.input :alegra_token_documentos, label: 'Token', hint: "Token Sanbox: 8mpfIimRdtPgLvcPX4MEDyrGGjsQJIkti0ivfDmv" %></div>
            </div>
            <div class="row">
              <div class="col-md-2"><%= f.input :url_alegra_documentos, as: :select, label: false, input_html: { class: 'select2', style: 'width: 100%' }, collection: select_url_documentos, label: 'Ambiente URL' %></div>
              <div class="col-md-4"><%= f.input :consecutivo_control, label: 'Control Consecutivo', hint: "Numero que permite el control del rango(Debe estar entre Inicio Numeración y Fin Numeración)" %></div>
            </div>

            <div class="box-footer">
              <div class="box-tools pull-right">
                <%= f.button :submit, "#{t :guardar}", class: 'btn btn-danger' %>
              </div>
            </div>
          <% end %>
        </div>
        <div class="tab-pane" id="aportes">
          <div class="col-md-12">
            <div class="box box-widget widget-user-2">
              <div class="widget-user-header bg-yellow">
                <div class="widget-user-image">
                  <%= image_tag("logo_aportes.png", style: "width: 90px;") %>
                </div>
                <h3 class="widget-user-username" style="margin-left: 100px;">Orden del proceso</h3>
              </div>
              <div class="box-footer no-padding">
                <ul class="nav nav-stacked" style="background-color: #DFDFDF">
                  <div class="row">
                    <div class="col-md-3 text-center" style="padding: 8px;">1. Generación del Token</div>
                    <div class="col-md-3 text-center" style="padding: 8px;">2. Creación del cotizante</div>
                    <div class="col-md-3 text-center" style="padding: 8px;">3. Envio de novedades</div>
                    <div class="col-md-3 text-center" style="padding: 8px;">4. Generación del certificado</div>
                  </div>
                </ul>
              </div>
            </div>

          </div>
          <%= simple_form_for(@portafolio) do |f| %>
            <div class="box-body">
              <div class="row">
                <div class="col-md-3"><%= f.input :aportes_username, label: 'Username' %></div>
                <div class="col-md-3"><%= f.input :aportes_contrasena, label: 'Password' %></div>
                <div class="col-md-3">
                  <%= f.input :aportes_aplicacion, as: :select, label: false, input_html: { class: 'select2', style: 'width: 100%' }, collection: select_aplicacion_aportes, label: 'Aplicacion' %>
                </div>
                <div class="col-md-3">
                  <label for="">Url Token</label>
                  <%= f.input :aportes_url, as: :select, label: false, input_html: { class: 'select2', style: 'width: 100%' }, collection: select_url_aportes %>
                </div>
              </div>

              <div class="row">
                <div class="col-md-3">
                  <label for="">Url Crear Cotizante</label>
                  <%= f.input :aportes_url_cotizante, as: :select, label: false, input_html: { class: 'select2', style: 'width: 100%' }, collection: select_url_aportes_cotizante %>
                </div>
                <div class="col-md-3">
                  <label for="">Url Generar Certificado</label>
                  <%= f.input :aportes_url_certificado, as: :select, label: false, input_html: { class: 'select2', style: 'width: 100%' }, collection: select_url_aportes_certificado %>
                </div>
                <div class="col-md-3"><%= f.input :aportes_tipoidaportante, label: 'Tipo Id Aportes' %></div>
                <div class="col-md-3"><%= f.input :aportes_numeroidaportante, label: 'Número Id Aportante' %></div>
              </div>
              <div class="row">
                <div class="col-md-2"><%= f.input :aportes_sucursalprincipal, label: 'Sucursal Princial' %></div>
                <div class="col-md-2"><%= f.input :aportes_centro_trabajo, label: 'Centro de Trabajo' %></div>
                <div class="col-md-3">
                  <label for="">Url Creación de Novedades</label>
                  <%= f.input :aportes_url_novedades, as: :select, label: false, input_html: { class: 'select2', style: 'width: 100%' }, collection: select_url_aportes_novedades %>
                </div>
              </div>
            </div>
            <div class="box-footer">
              <div class="box-tools pull-right">
                <%= f.button :submit, "#{t :guardar}", class: 'btn btn-danger' %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>