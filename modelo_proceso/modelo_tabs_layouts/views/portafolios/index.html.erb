  <div class="box box-primary">
    <div class="box-header with-border">
      <legend>Compañias</legend>
      <div class="box-tools pull-right">
      </div><!-- /.box-tools -->
    </div><!-- /.box-header -->
    <div class="box-body">
      <div class="row">
        <div class="col-md-12">
          <div id="portafolios-form" hidden></div>
        </div>
      </div>
      <div class="row">
        <div class="col-md-12">
          <div class="box-body table-responsive">
            <table class="table table-bordered table-condensed table-striped">
              <thead>
              <tr class="thcolor">
                <th width="10%"></th>
                <th width="35%">Nombre</th>
                <th width="20%">Nombre Corto</th>
              </tr>
              </thead>
              <tbody id="portafolios-tbody">
              <% @portafolios.order(:nombre).each do |portafolio| %>
                <%= render 'rows', portafolio: portafolio %>
              <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div><!-- /.box-body -->
  </div><!-- /.box -->
