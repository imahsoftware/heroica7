<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th width="20%">Descripción</th>
        <th width="20%">Controlador</th>
        <th width="5%" class="text-center">Nivel</th>
        <th width="8%" class="text-center">Imagen</th>
        <th>Mensaje</th>
      </tr>
    </thead>
    <tbody id="tbody_modulos">
      <% @modulos.each do |modulo| %>
        <%= render 'modulos/tr', modulo: modulo %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="row" style="margin-top: 12px;">
  <div class="col-xs-12 text-right">
    <%= will_paginate @modulos, renderer: BootstrapPagination::Rails %>
  </div>
</div>
