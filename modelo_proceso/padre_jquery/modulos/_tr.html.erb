<tr id="modulo_<%= modulo.id %>">
  <td class="text-center">
    <%= link_to edit_modulo_path(modulo), remote: true,
        class: 'edit_modulo_button',
        title: t(:title_editar),
        data: { toggle: 'tooltip' } do %>
      <button class="btn btn-xs btn-warning btn-accion"><i class="fa fa-edit"></i></button>
    <% end %>
    <%= link_to modulo_path(modulo), remote: true,
        method: :delete,
        title: t(:title_elimina),
        data: { confirm: t(:elimina_confirma), toggle: 'tooltip' } do %>
      <button class="btn btn-xs btn-danger btn-accion"><i class="fa fa-trash"></i></button>
    <% end %>
  </td>
  <td><%= modulo.descripcion %></td>
  <td>
    <code style="font-size: 11px; background: #f1f5f9; color: #394959; padding: 2px 6px; border-radius: 4px;">
      <%= modulo.controlador %>
    </code>
  </td>
  <td class="text-center">
    <span class="badge-activo si" style="background:#e0e7ff; color:#3730a3; border-color:#c7d2fe;">
      <%= modulo.nivel %>
    </span>
  </td>
  <td class="text-center">
    <% if modulo.imagen.present? %>
      <i class="<%= modulo.imagen %>" style="font-size: 16px; color: #394959;"></i>
    <% else %>
      <span class="text-muted">—</span>
    <% end %>
  </td>
  <td style="font-size: 12px; color: #64748b;"><%= modulo.mensaje.presence || '—' %></td>
</tr>
