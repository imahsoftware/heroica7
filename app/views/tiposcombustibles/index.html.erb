<% title 'Tipos de Combustible' %>

<div class="box box-usuarios">
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-fire"></i> Tipos de Combustible
      <span class="users-count-badge"><%= @tiposcombustibles.total_entries rescue @tiposcombustibles.count %> registros</span>
    </span>
    <div class="box-tools pull-right" style="margin-top: -2px;">
      <%= link_to new_tiposcombustible_path, remote: true, id: 'new_tiposcombustible_button',
          class: 'btn btn-sm btn-success',
          title: 'Agregar tipo de combustible' do %>
        <i class="fa fa-plus"></i> Nuevo
      <% end %>
    </div>
  </div>

  <div class="box-body">

    <div class="row" style="margin-bottom: 16px;">
      <div class="col-md-5 col-sm-7 col-xs-12 search-bar">
        <%= search_form_for @q do |f| %>
          <div class="input-group">
            <%= f.search_field :descripcion_cont,
                class: 'form-control',
                placeholder: 'Buscar por descripción...' %>
            <div class="input-group-btn">
              <%= button_tag type: 'submit', class: 'btn btn-search' do %>
                <i class="fa fa-search"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="flash_messages"></div>
    <div id="tiposcombustible_form" class="collapse" style="margin-bottom: 12px;"></div>

    <div id="tiposcombustibles">
      <% if @tiposcombustibles.any? %>
        <%= render 'tiposcombustibles/tabla' %>
      <% else %>
        <div class="empty-state">
          <i class="fa fa-fire"></i>
          <p>No se encontraron tipos de combustible.</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
