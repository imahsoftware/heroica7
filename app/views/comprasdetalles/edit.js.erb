$("#comprasdetalle_form").collapse("hide");
$("#comprasdetalle_form").empty();

<% if @active_record.present? %>
  $("#comprasdetalle_<%= @active_record.id %>").replaceWith("<%= j render 'tr', comprasdetalle: @active_record %>");
<% end %>

$("#comprasdetalle_<%= @comprasdetalle.id %>").html("<td colspan='8'><%= j render 'form' %></td>");
$("#comprasdetalle_<%= @comprasdetalle.id %>").addClass("active_comprasdetalle");

$(".select2").select2();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
