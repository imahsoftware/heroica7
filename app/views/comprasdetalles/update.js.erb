$(".alert_flash").fadeOut(300, function() {
  $(this).remove();
});

$("#comprasdetalle_<%= @comprasdetalle.id %>").replaceWith("<%= j render 'tr', comprasdetalle: @comprasdetalle %>");
$('[data-toggle="tooltip"]').tooltip();

$(".flash_messages_detalle").html("<%= j render 'layouts/flash_messages' %>");

setTimeout(function() {
  $(".alert_flash").fadeOut(300, function() {
    $(this).remove();
  });
}, 5000);
