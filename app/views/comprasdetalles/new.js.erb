<% if @active_record.present? %>
  $("#comprasdetalle_<%= @active_record.id %>").replaceWith("<%= j render 'tr', comprasdetalle: @active_record %>");
<% end %>
$("#comprasdetalle_form").html("<%= j render 'form' %>");
$(".datetimepicker").datetimepicker();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#comprasdetalle_form").collapse("show");
$(".select2").select2();
