<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th>Producto</th>
        <th width="8%" class="text-center">Unidad</th>
        <th width="8%" class="text-center">Cantidad</th>
        <th width="12%" class="text-right">Valor Unitario</th>
        <th width="12%" class="text-right">Valor Descuento</th>
        <th width="12%" class="text-right">Valor IVA</th>
        <th width="12%" class="text-right">Valor Total</th>
      </tr>
    </thead>
    <tbody id="tbody_comprasdetalles">
      <% @compra.comprasdetalles.includes(:producto).order(id: :desc).each do |comprasdetalle| %>
        <%= render 'comprasdetalles/tr', comprasdetalle: comprasdetalle %>
      <% end %>
    </tbody>
  </table>
</div>
