$(".alert_flash").fadeOut(300, function() {
  $(this).remove();
});

<% if @compra.comprasdetalles.count == 0 %>
  $("#comprasdetalles").html("<div class='alert alert-warning'><h4><i class='icon fa fa-info'></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>");
<% else %>
  $("#comprasdetalle_<%= @comprasdetalle.id %>").remove();
<% end %>

$(".flash_messages_detalle").html("<%= j render 'layouts/flash_messages' %>");

setTimeout(function() {
  $(".alert_flash").fadeOut(300, function() {
    $(this).remove();
  });
}, 5000);

$('.tooltip').tooltip('hide');
