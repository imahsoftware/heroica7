<div class="box box-usuarios">
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-list"></i> DETALLE DE LA FACTURA
    </span>
  </div>
  <div class="box-body">

    <%# ── Formulario nuevo detalle ────────────────────────────────────────────── %>
    <% if is_auth_c('detallesfactura') && @detallesfactura && !@detallesfactura.persisted? %>
      <% if @factura.estado == 'C' %>
        <div class="alert alert-warning text-center">LA FACTURA SE ENCUENTRA CANCELADA</div>
      <% elsif @factura.estado == 'A' %>
        <div class="alert alert-danger text-center">LA FACTURA SE ENCUENTRA ANULADA</div>
      <% else %>
        <%= render partial: '/detallesfacturas/detallesfacturas_form' %>
      <% end %>
    <% end %>

    <%# ── Listado de detalles ──────────────────────────────────────────────────── %>
    <% if @factura.detallesfacturas.exists? %>
      <table class="table table-bordered table-condensed table-striped table-usuarios">
        <thead>
          <tr>
            <th>Usuario</th>
            <th>Categoría / Trámite</th>
            <th>Concepto</th>
            <th class="text-center">Cant.</th>
            <th class="text-right">Valor</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @factura.detallesfacturas.each do |det| %>
            <% editing_this = @detallesfactura && det.id == @detallesfactura.id %>

            <% if editing_this %>
              <%# ── fila en modo edición: cada campo va en su columna ── %>
              <tr id="detallesfactura_<%= det.id %>" class="warning">
                <td>
                  <small><i class="fa fa-pencil"></i> editando</small>
                </td>
                <td>
                  <%= det.categoria&.nombre %><br>
                  <small><%= det.tipostramite&.descripcion %></small>
                </td>
                <td>
                  <%# El <form> vive aquí; los otros inputs lo referencian con form="id" %>
                  <form id="edit_det_<%= det.id %>"
                        action="<%= factura_detallesfactura_path(@factura, det) %>"
                        method="post"
                        data-remote="true">
                    <%= hidden_field_tag :_method, :patch %>
                    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                    <%= select_tag 'detallesfactura[concepto_id]',
                          options_from_collection_for_select(
                            Concepto.order(:descripcion), :id, :descripcion, det.concepto_id),
                          include_blank: true,
                          class: 'form-control select2',
                          style: 'width:100%' %>
                  </form>
                </td>
                <td>
                  <input form="edit_det_<%= det.id %>"
                         type="text" name="detallesfactura[cantidad]"
                         value="<%= det.cantidad %>"
                         class="form-control input-sm" style="width:70px">
                </td>
                <td>
                  <input form="edit_det_<%= det.id %>"
                         type="text" name="detallesfactura[valor]"
                         value="<%= det.valor %>"
                         class="form-control input-sm">
                </td>
                <td class="text-center">
                  <button form="edit_det_<%= det.id %>"
                          type="submit"
                          class="btn btn-xs btn-primary">
                    <i class="fa fa-check"></i> Guardar
                  </button>
                  <%= link_to edit_factura_path(@factura),
                        class: 'btn btn-xs btn-default' do %>
                    <i class="fa fa-times"></i> Cancelar
                  <% end %>
                </td>
              </tr>
              <script>
                (function(){
                  var sel = document.querySelector('#edit_det_<%= det.id %> select');
                  if (sel && typeof $ !== 'undefined' && $.fn.select2) {
                    $(sel).select2({ width: '100%', dropdownParent: $(sel).closest('td') });
                  }
                })();
              </script>

            <% else %>
              <%# ── fila normal ── %>
              <tr id="detallesfactura_<%= det.id %>" class="<%= cycle('odd', 'even') %>">
                <td>
                  <small>
                    <%= det.created_at.strftime('%Y-%m-%d %H:%M:%S') %> - <%= det.user&.username %><br>
                    <%= det.updated_at.strftime('%Y-%m-%d %H:%M:%S') %> - <%= User.find(det.user_actualiza).username rescue nil %>
                  </small>
                </td>
                <td>
                  <%= det.categoria&.nombre %><br>
                  <small><%= det.tipostramite&.descripcion %></small>
                </td>
                <td><%= det.concepto&.descripcion %></td>
                <td class="text-center"><%= det.cantidad.presence || 1 %></td>
                <td class="text-right"><%= camponumerico(det.valor) %></td>
                <td class="text-center">
                  <% if is_auth_a('detallesfactura') && @factura.estado == 'P' %>
                    <%= link_to 'Editar',
                          edit_factura_detallesfactura_path(@factura, det),
                          remote: true,
                          class: 'btn btn-xs btn-warning' %>
                  <% end %>
                  <% if is_auth_e('detallesfactura') && @factura.estado.to_s == 'P' %>
                    <%= link_to 'Borrar',
                          factura_detallesfactura_path(@factura, det),
                          method: :delete,
                          remote: true,
                          data: { confirm: '¿Seguro?' },
                          class: 'btn btn-xs btn-danger' %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="4" class="text-right"><strong>VALOR TOTAL FACTURA:</strong></td>
            <td class="text-right"><strong><%= camponumerico(@factura.detallesfacturas.sum('valor')) %></strong></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    <% else %>
      <div class="alert alert-info">No hay datos asociados.</div>
    <% end %>

    <% if flash[:detallesfactura] %>
      <div id="flash_detallesfactura" class="alert alert-success">
        <%= flash[:detallesfactura] %>
      </div>
      <script>setTimeout(function(){ var el = document.getElementById('flash_detallesfactura'); if(el){ el.style.transition='opacity 1s'; el.style.opacity=0; setTimeout(function(){ el.remove(); }, 1000); } }, 4000);</script>
    <% end %>

  </div>
</div>
