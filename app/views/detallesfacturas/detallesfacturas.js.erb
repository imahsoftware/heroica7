$("#detallesfacturas_form").html("<%= j render partial: '/detallesfacturas/detallesfacturas' %>");
<% if flash[:detallesfactura] %>
  setTimeout(function(){
    var el = document.getElementById('flash_detallesfactura');
    if(el){ el.style.transition='opacity 1s'; el.style.opacity=0; setTimeout(function(){ el.remove(); }, 1000); }
  }, 4000);
<% end %>
