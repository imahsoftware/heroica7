$("#empresa_form").collapse("hide");
$("#empresa_form").empty();
<% if flash[:notice] %>
  $(".flash_messages").html("<div class='alert alert-success alert-dismissible'><button type='button' class='close' data-dismiss='alert'>&times;</button><%= j flash[:notice] %></div>");
  <% flash.discard(:notice) %>
<% end %>
$("#empresa_<%= @empresa.id %>").replaceWith("<%= j render 'tr', empresa: @empresa %>");
$('[data-toggle="tooltip"]').tooltip();
