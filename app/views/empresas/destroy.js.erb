$("#empresa_<%= @empresa.id %>").fadeOut(300, function() { $(this).remove(); });
<% if flash[:success] %>
  $(".flash_messages").html("<div class='alert alert-success alert-dismissible'><button type='button' class='close' data-dismiss='alert'>&times;</button><%= j flash[:success] %></div>");
  <% flash.discard(:success) %>
<% end %>
