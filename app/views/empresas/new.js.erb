<% if @active_record.present? %>
  $("#empresa_<%= @active_record.id %>").replaceWith("<%= j render 'tr', empresa: @active_record %>");
<% end %>
$("#empresa_form").html("<%= j render 'form' %>");
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
$("#empresa_form").collapse("show");
$(".select2").select2();
