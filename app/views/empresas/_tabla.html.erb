<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th width="15%">Identificación</th>
        <th width="30%">Razón Social</th>
        <th width="30%">Dirección</th>
        <th width="17%">Teléfono</th>
      </tr>
    </thead>
    <tbody id="tbody_empresas">
      <% @empresas.each do |empresa| %>
        <%= render 'empresas/tr', empresa: empresa %>
      <% end %>
    </tbody>
  </table>
</div>
