<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recuperar Contraseña</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      height: 100%;
      font-family: 'Inter', sans-serif;
    }

    /* ── Layout principal ── */
    .login-wrapper {
      display: flex;
      min-height: 100vh;
    }

    /* ── Panel izquierdo: logo ── */
    .login-left {
      flex: 1;
      background: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 3rem;
      position: relative;
      overflow: hidden;
    }

    .login-left::before {
      content: '';
      position: absolute;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(180, 20, 20, 0.06) 0%, transparent 70%);
      top: -100px;
      left: -100px;
      pointer-events: none;
    }

    .login-left::after {
      content: '';
      position: absolute;
      width: 300px;
      height: 300px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(180, 20, 20, 0.05) 0%, transparent 70%);
      bottom: -80px;
      right: -60px;
      pointer-events: none;
    }

    .logo-wrapper {
      position: relative;
      z-index: 1;
      text-align: center;
    }

    .logo-wrapper img {
      max-width: 100%;
      width: 100%;
      height: auto;
      filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.10));
      transition: transform 0.4s ease;
    }

    .logo-wrapper img:hover {
      transform: scale(1.03);
    }

    .logo-tagline {
      margin-top: 1.5rem;
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #94a3b8;
    }

    /* Divisor vertical */
    .login-divider {
      width: 1px;
      background: linear-gradient(to bottom, transparent, #e2e8f0 20%, #e2e8f0 80%, transparent);
      flex-shrink: 0;
    }

    /* ── Panel derecho ── */
    .login-right {
      flex: 1;
      background: #f1f5f9;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 2rem;
      position: relative;
      overflow: hidden;
    }

    .login-right::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 200px;
      height: 200px;
      background: linear-gradient(135deg, rgba(180, 20, 20, 0.12), transparent);
      border-radius: 0 0 0 100%;
      pointer-events: none;
    }

    .login-right::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 160px;
      height: 160px;
      background: linear-gradient(315deg, rgba(180, 20, 20, 0.08), transparent);
      border-radius: 0 100% 0 0;
      pointer-events: none;
    }

    /* Tarjeta */
    .login-card {
      background: #ffffff;
      border-radius: 20px;
      padding: 2.8rem 2.5rem;
      width: 100%;
      max-width: 420px;
      box-shadow:
        0 4px 6px -1px rgba(0, 0, 0, 0.07),
        0 20px 60px -10px rgba(185, 28, 28, 0.12);
      position: relative;
      z-index: 1;
    }

    /* Barra de acento superior */
    .login-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 2rem;
      right: 2rem;
      height: 3px;
      background: linear-gradient(90deg, #b91c1c, #ef4444, #b91c1c);
      border-radius: 0 0 4px 4px;
    }

    /* Ícono central decorativo */
    .card-icon {
      width: 60px;
      height: 60px;
      background: linear-gradient(135deg, #b91c1c, #ef4444);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.25rem;
      box-shadow: 0 6px 16px rgba(185, 28, 28, 0.3);
    }

    .card-icon i {
      color: #ffffff;
      font-size: 1.4rem;
    }

    .card-header-text {
      text-align: center;
      margin-bottom: 2rem;
    }

    .card-header-text h2 {
      font-size: 1.5rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 0.5rem;
    }

    .card-header-text p {
      font-size: 0.85rem;
      color: #64748b;
      font-weight: 400;
      line-height: 1.5;
    }

    /* Grupos de inputs */
    .form-group {
      margin-bottom: 1.25rem;
    }

    .form-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: #374151;
      margin-bottom: 0.45rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-icon {
      position: absolute;
      left: 1rem;
      color: #94a3b8;
      font-size: 0.95rem;
      pointer-events: none;
      transition: color 0.2s;
    }

    .form-control {
      width: 100%;
      padding: 0.75rem 1rem 0.75rem 2.75rem;
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      color: #1e293b;
      background: #f8fafc;
      transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
      outline: none;
    }

    .form-control::placeholder {
      color: #cbd5e1;
    }

    .form-control:focus {
      border-color: #ef4444;
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12);
    }

    .input-wrapper:focus-within .input-icon {
      color: #ef4444;
    }

    /* Botón principal */
    .btn-login {
      width: 100%;
      padding: 0.85rem;
      background: linear-gradient(135deg, #b91c1c 0%, #ef4444 100%);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      font-family: 'Inter', sans-serif;
      letter-spacing: 0.03em;
      cursor: pointer;
      margin-top: 0.5rem;
      transition: transform 0.15s ease, box-shadow 0.2s ease, opacity 0.2s;
      box-shadow: 0 4px 14px rgba(185, 28, 28, 0.35);
    }

    .btn-login:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(185, 28, 28, 0.45);
      opacity: 0.95;
    }

    .btn-login:active {
      transform: translateY(0);
      box-shadow: 0 2px 8px rgba(185, 28, 28, 0.3);
    }

    /* Link volver */
    .login-links {
      text-align: center;
      margin-top: 1.5rem;
    }

    .login-links a {
      font-size: 0.82rem;
      color: #64748b;
      text-decoration: none;
      transition: color 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }

    .login-links a:hover {
      color: #ef4444;
    }

    /* Alertas */
    .alert-box {
      border-radius: 10px;
      padding: 0.75rem 1rem;
      margin-bottom: 1.25rem;
      font-size: 0.82rem;
      font-weight: 500;
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .alert-danger {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #dc2626;
    }

    .alert-notice {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      color: #16a34a;
    }

    /* Footer */
    .card-footer-text {
      text-align: center;
      margin-top: 1.75rem;
      padding-top: 1.25rem;
      border-top: 1px solid #f1f5f9;
      font-size: 0.75rem;
      color: #94a3b8;
      letter-spacing: 0.05em;
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      .login-wrapper {
        flex-direction: column;
      }

      .login-left {
        padding: 2.5rem 2rem 2rem;
        flex: none;
        min-height: 220px;
      }

      .logo-wrapper img {
        max-width: 200px;
      }

      .logo-tagline {
        font-size: 0.75rem;
      }

      .login-divider {
        width: 100%;
        height: 1px;
        background: linear-gradient(to right, transparent, #e2e8f0 20%, #e2e8f0 80%, transparent);
      }

      .login-right {
        flex: none;
        padding: 2rem 1.25rem 3rem;
      }

      .login-card {
        padding: 2rem 1.5rem;
        box-shadow: none;
        background: transparent;
      }

      .login-card::before {
        display: none;
      }
    }

    @media (max-width: 400px) {
      .login-card {
        padding: 1.5rem 1rem;
      }
    }
  </style>
</head>
<body>

<div class="login-wrapper">

  <!-- ══ Panel izquierdo ══ -->
  <div class="login-left">
    <div class="logo-wrapper">
      <%= image_tag "logo_heroica.png", alt: "Logo Heroica", title: "Sistema Institucional" %>
      <p class="logo-tagline">Sistema Institucional</p>
    </div>
  </div>

  <!-- Divisor vertical -->
  <div class="login-divider"></div>

  <!-- ══ Panel derecho ══ -->
  <div class="login-right">
    <div class="login-card">

      <!-- Ícono decorativo -->
      <div class="card-icon">
        <i class="fa-solid fa-key"></i>
      </div>

      <!-- Encabezado -->
      <div class="card-header-text">
        <h2>¿Olvidaste tu contraseña?</h2>
        <p>Ingresa tu correo electrónico y te enviaremos las instrucciones para restablecerla.</p>
      </div>

      <!-- Alertas -->
      <% if flash[:alert].present? %>
        <div class="alert-box alert-danger">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>

      <% if flash[:notice].present? %>
        <div class="alert-box alert-notice">
          <i class="fa-solid fa-circle-check"></i>
          <span><%= flash[:notice] %></span>
        </div>
      <% end %>

      <!-- Formulario -->
      <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>

        <div class="form-group">
          <label for="user_email">Correo electrónico</label>
          <div class="input-wrapper">
            <i class="fa-solid fa-envelope input-icon"></i>
            <%= f.input :email,
                required: true,
                autofocus: true,
                label: false,
                wrapper: false,
                input_html: {
                  autocomplete: "email",
                  class: "form-control",
                  placeholder: "correo@ejemplo.com",
                  id: "user_email"
                } %>
          </div>
        </div>

        <button type="submit" class="btn-login">
          <i class="fa-solid fa-paper-plane" style="margin-right: 0.4rem;"></i>
          Enviar instrucciones
        </button>

      <% end %>

      <!-- Link volver -->
      <div class="login-links">
        <%= link_to new_session_path(resource_name) do %>
          <i class="fa-solid fa-arrow-left"></i> Volver al inicio de sesión
        <% end %>
      </div>

      <!-- Footer -->
      <div class="card-footer-text">
        IMAH &nbsp;·&nbsp; <%= Time.now.year %>
      </div>

    </div>
  </div>

</div>

</body>
</html>
