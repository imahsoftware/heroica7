<% content_for :title, 'Recuperar contraseña' %>

<style>
  .card-icon {
    width: 60px; height: 60px;
    background: linear-gradient(135deg, #b91c1c, #ef4444);
    border-radius: 16px; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.25rem; box-shadow: 0 6px 16px rgba(185, 28, 28, 0.3);
  }
  .card-icon i { color: #fff; font-size: 1.4rem; }
  .login-links { text-align: center; margin-top: 1.5rem; }
  .login-links a {
    font-size: 0.82rem; color: #64748b; text-decoration: none;
    display: inline-flex; align-items: center; gap: 0.35rem; transition: color 0.2s;
  }
  .login-links a:hover { color: #ef4444; }
</style>

<div class="card-icon">
  <i class="fa-solid fa-key"></i>
</div>

<div class="card-header-text">
  <h2>¿Olvidaste tu contraseña?</h2>
  <p>Ingresa tu correo electrónico y te enviaremos las instrucciones para restablecerla.</p>
</div>

<% if flash[:alert].present? %>
  <div class="alert-box alert-danger">
    <i class="fa-solid fa-circle-exclamation"></i>
    <span><%= flash[:alert] %></span>
  </div>
<% end %>

<% if flash[:notice].present? %>
  <div class="alert-box alert-notice">
    <i class="fa-solid fa-circle-check"></i>
    <span><%= flash[:notice] %></span>
  </div>
<% end %>

<%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <div class="form-group">
    <label for="user_email">Correo electrónico</label>
    <div class="input-wrapper">
      <i class="fa-solid fa-envelope input-icon"></i>
      <%= f.input :email,
          required: true,
          autofocus: true,
          label: false,
          wrapper: false,
          input_html: {
            autocomplete: 'email',
            class: 'form-control',
            placeholder: 'correo@ejemplo.com',
            id: 'user_email'
          } %>
    </div>
  </div>

  <button type="submit" class="btn-login">
    <i class="fa-solid fa-paper-plane" style="margin-right: 0.4rem;"></i>
    Enviar instrucciones
  </button>
<% end %>

<div class="login-links">
  <%= link_to new_session_path(resource_name) do %>
    <i class="fa-solid fa-arrow-left"></i> Volver al inicio de sesión
  <% end %>
</div>

<div class="card-footer-text">
  IMAH &nbsp;·&nbsp; <%= Time.current.year %>
</div>
