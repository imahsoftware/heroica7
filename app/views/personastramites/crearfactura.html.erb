<div style="max-width:600px; margin:40px auto; text-align:center;">

  <%# ── Logo ── %>
  <div style="margin-bottom:20px;">
    <%= image_tag 'logo_heroica.png', style: 'max-width:160px; max-height:90px;' %>
  </div>

  <% creada = flash[:factura].to_s.include?('Creada') %>
  <% factura = @personastramite.reload.factura rescue nil %>

  <% if creada %>
    <div class="alert alert-success" style="font-size:18px;">
      <i class="fa fa-check-circle"></i>
      <strong><%= flash[:factura] %></strong>
    </div>
    <p style="color:#555; margin-bottom:20px;">
      La factura fue generada con los conceptos de cobro del trámite.<br>
      Puede ir directamente a la factura para registrar abonos.
    </p>
  <% else %>
    <div class="alert alert-warning" style="font-size:16px;">
      <i class="fa fa-exclamation-triangle"></i>
      <strong><%= flash[:factura] %></strong>
    </div>
  <% end %>

  <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top:20px;">
    <% if factura %>
      <%= link_to edit_factura_path(factura),
            class: "btn btn-#{creada ? 'primary' : 'info'} btn-lg" do %>
        <i class="fa fa-file-text"></i> <%= creada ? 'Ir a la Factura' : 'Ver Factura Existente' %>
      <% end %>
    <% end %>
    <%= link_to edit_persona_personastramite_path(@persona, @personastramite),
          class: 'btn btn-default btn-lg' do %>
      <i class="fa fa-arrow-left"></i> Volver al Trámite
    <% end %>
  </div>

</div>
