<style>
  .registro-clase-sheet {
    width: 850px;
    max-width: 100%;
    margin: 0 auto;
    font-family: Tahoma, Geneva, Verdana, sans-serif;
    overflow-x: auto;
  }

  .informe-document .registro-clase-sheet table[width="850"],
  .registro-clase-sheet table.sample {
    width: 850px !important;
    max-width: 850px !important;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .registro-clase-sheet table.sample td,
  .registro-clase-sheet table.sample th {
    border: 1px solid #000;
    vertical-align: middle;
    padding: 2px 4px;
    line-height: 1.1;
    box-sizing: border-box;
    overflow: hidden;
    word-wrap: break-word;
  }

  .registro-clase-sheet .camposDescN16 { font-size: 14px; font-weight: bold; line-height: 1.2; }
  .registro-clase-sheet .camposDescN12 { font-size: 12px; font-weight: bold; }
  .registro-clase-sheet .camposDesc12  { font-size: 12px; }
  .registro-clase-sheet .camposDescN11 { font-size: 11px; font-weight: bold; }
  .registro-clase-sheet .camposDesc11  { font-size: 11px; }
  .registro-clase-sheet .camposDesc10  { font-size: 10px; }

  .registro-clase-foto img {
    max-height: 120px;
    max-width: 150px;
  }

  .registro-clase-header .registro-clase-logo img {
    max-width: 220px !important;
    max-height: 70px !important;
    width: auto !important;
    height: auto !important;
  }

  .registro-clase-instructor table.registro-clase-cumplio {
    width: 100% !important;
    max-width: 100% !important;
    table-layout: fixed;
    border-collapse: collapse;
    border: 0 !important;
    margin: 0;
  }

  .registro-clase-instructor table.registro-clase-cumplio td {
    border: 1px solid #000;
    padding: 2px 4px;
    box-sizing: border-box;
  }

  .registro-clase-practica tr.fila-clase td { height: 18px; }
  .registro-clase-teoria tr.fila-teoria td { height: 16px; }
  .registro-clase-instructor .observaciones td { height: 36px; }

  @media print {
    @page {
      size: letter portrait;
      margin: 0.1in 0.15in;
    }

    html, body {
      margin: 0 !important;
      padding: 0 !important;
      background: #fff !important;
    }

    .informe-document {
      max-width: none !important;
      width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .registro-clase-sheet {
      width: 100% !important;
      max-width: none !important;
      min-height: 10.8in;
      box-sizing: border-box;
      page-break-inside: avoid;
      page-break-after: avoid;
    }

    .registro-clase-sheet table[width="850"],
    .registro-clase-sheet table.sample {
      width: 100% !important;
      max-width: 100% !important;
    }

    .registro-clase-sheet .camposDescN16 { font-size: 15px !important; }
    .registro-clase-sheet .camposDescN12,
    .registro-clase-sheet .camposDesc12  { font-size: 12px !important; }
    .registro-clase-sheet .camposDescN11,
    .registro-clase-sheet .camposDesc11  { font-size: 11px !important; }
    .registro-clase-sheet .camposDesc10  { font-size: 10px !important; }

    .registro-clase-sheet td,
    .registro-clase-sheet th {
      padding: 2px 5px !important;
      line-height: 1.18 !important;
    }

    .registro-clase-header td { height: 0.38in; }

    .registro-clase-alumno td { height: 0.24in; }

    .registro-clase-foto img {
      max-height: 1.28in !important;
      max-width: 1.55in !important;
      width: auto !important;
    }

    .registro-clase-practica tr.fila-clase td { height: 0.198in; }

    .registro-clase-teoria tr.fila-teoria td { height: 0.164in; }

    .registro-clase-instructor tr:not(.observaciones) td { height: 0.28in; }

    .registro-clase-instructor .observaciones td { height: 0.58in; }

    .registro-clase-footer td { height: 0.17in; }

    .imprimirlink { display: none !important; }
  }
</style>

<div class="registro-clase-sheet" align="center">
<table width="850" border="0" cellpadding="0" cellspacing="0" class="sample registro-clase-header">
  <tr>
    <td width="250" rowspan="2" valign="middle"><div align="center" class="registro-clase-logo"><%= informe_image_tag 'logo_heroica.png', style: 'max-width:220px; max-height:70px;' %></div></td>
    <td width="395" rowspan="2"><div align="center" class="camposDescN16">REGISTRO DE CLASES<br/>PRACTICAS Y TEORICAS</div></td>
    <td width="92"><div align="center" class="camposDesc12">VERSION</div></td>
    <td width="113"><div align="center" class="camposDesc12">03</div></td>
  </tr>
  <tr>
    <td><div align="center" class="camposDesc12">FECHA</div></td>
    <td><div align="center" class="camposDesc12">28/04/2011</div></td>
  </tr>
</table>
<table width="850" border="0" cellspacing="0" cellpadding="0">
  <tr>
    <td><table width="850" border="0" cellspacing="0" cellpadding="0">
      <tr>
        <td width="20%" valign="top"><div align="center" class="registro-clase-foto">
           <%= persona_informe_foto(@personastramite.persona, height: 120, width: 150) %>
          </div></td>
        <td width="80%"><table width="100%"  border="0" cellspacing="0" cellpadding="0" class="sample registro-clase-alumno">
          <tr>
            <td width="132" class="camposDescN12"><div align="left">Alumno:</div></td>
            <td colspan="3" class="camposDesc12"><div align="left">&nbsp;<%=@personastramite.persona.identificacion rescue nil%> - <%=@personastramite.persona.nombres rescue nil%></div></td>
          </tr>
          <tr>
            <td class="camposDescN12"><div align="left">Fecha Nacimiento:</div> </td>
            <td colspan="3" class="camposDesc12"><div align="left">&nbsp;<%=@personastramite.persona.fecha_nacimiento rescue nil%> - <%=@personastramite.persona.lugar_nacimiento rescue nil%></div></td>
          </tr>
          <tr>
            <td class="camposDescN12"><div align="left">Direccion:</div></td>
            <td colspan="3" class="camposDesc12"><div align="left">&nbsp;<%=@personastramite.persona.direccion rescue nil%></div></td>
          </tr>
          <tr>
            <td class="camposDescN12"><div align="left">Telefonos:</div></td>
            <td colspan="3" class="camposDesc12"><div align="left">&nbsp;<%=@personastramite.persona.telefono rescue nil%> - <%=@personastramite.persona.telefono_oficina rescue nil%> - <%=@personastramite.persona.celular rescue nil%></div></td>
          </tr>
          <%# horario y fechainicial vienen del controlador %>
          <tr>
            <td class="camposDescN12"><div align="left">Horario:</div></td>
            <td width="238" class="camposDesc12"><div align="left">&nbsp;<%= @horario %></div></td>
            <td width="100" class="camposDescN12"><div align="left">Fecha Inicial: </div></td>
            <td width="88" class="camposDesc12"><div align="left">&nbsp;<%= @fechainicial %></div></td>
          </tr>
          <tr>
            <td class="camposDescN12"><div align="left">Instructor:</div></td>
            <td class="camposDesc12"><div align="left">&nbsp;<%=@personastramite.placa.descripcion rescue nil%> - <%=@personastramite.placa.instructor.nombre rescue nil%></div></td>
            <td class="camposDescN12"><div align="left">Categoria:</div></td>
            <td class="camposDesc12"><div align="left">&nbsp;<%=@personastramite.categoria.codigo_nuevo rescue nil%></div></td>
          </tr>
        </table></td>
      </tr>
    </table>
<table width="850" border="0" cellspacing="0" cellpadding="0" class="sample registro-clase-practica">
  <tr>
    <td><div align="center" class="camposDescN11">CLASE</div></td>
    <td width="122"><div align="center" class="camposDescN11">FECHA</div></td>
    <td width="428"><div align="center" class="camposDescN11">TEMA</div></td>
    <td width="236"><div align="center" class="camposDescN11">FIRMA</div></td>
  </tr>
  <% (1..30).each do |n| %>
    <tr class="fila-clase">
      <td><div align="center" class="camposDescN11" style="padding: 3px;"><%= n %></div></td>
      <td>&nbsp;</td>
      <td>&nbsp;</td>
      <td>&nbsp;</td>
    </tr>
  <% end %>
</table>
    </td>
  </tr>
</table>
<table width="850" border="0" cellspacing="0" cellpadding="0" class="sample registro-clase-teoria">
  <tr>
    <td rowspan="9" width="200"><div align="center" class="camposDescN12">FORMACION TEORICA Y BASICA APLICADA </div></td>
  </tr>
  <tr>
    <td><div align="center" class="camposDescN11">INT.</div></td>
    <td width="15%"><div align="center" class="camposDescN11">FECHA</div></td>
    <td width="30%"><div align="center" class="camposDescN11">TEMA</div></td>
    <td width="30%"><div align="center" class="camposDescN11">FIRMA</div></td>
  </tr>
  <% [
    '1- Movilidad segura y sostenible',
    '2- Normas de Tránsito',
    '3- Señalización vial',
    '4- Infraestructura Vial',
    '5- Saberes Específicos',
    '6- Primeros Auxilios',
    '7- Horas Vehículo'
  ].each do |tema| %>
    <tr class="fila-teoria">
      <td><div align="center" class="camposDescN11">&nbsp;</div></td>
      <td>&nbsp;</td>
      <td><div align="left" class="camposDesc11"><%= tema %></div></td>
      <td>&nbsp;</td>
    </tr>
  <% end %>
</table>
<table width="850" border="0" cellspacing="0" cellpadding="0" class="sample registro-clase-instructor">
  <tr>
    <td  colspan="3"><div align="center" class="camposDescN12">ESTE ESPACIO ES DE USO EXCLUSIVO DEL INSTRUCTOR DE CONDUCCI&Oacute;N</div></td>
  </tr>
  <tr>
    <td width="30%"><div align="center" class="camposDescN12">APROBACION DEL PROGRAMA PRACTICO</div></td>
    <td width="29%"><div align="center" class="camposDescN12">
      <table width="100%" border="0" cellpadding="0" cellspacing="0" class="registro-clase-cumplio">
        <tr>
          <td width="60%">CUMPLIO</td>
          <td width="20%"><div align="center">SI</div></td>
          <td width="20%"><div align="center">NO</div></td>
        </tr>
      </table>
    </div></td>
    <td width="42%" valign="bottom"><div align="center" class="camposDescN12">FIRMA INSTRUCTOR</div></td>
  </tr>
  <tr>
    <td  colspan="3"><div align="center" class="camposDescN12">OBSERVACIONES</div></td>
  </tr>
  <tr class="observaciones">
    <td colspan="3">&nbsp;</td>
  </tr>
</table>
<table width="850" border="0" cellspacing="0" cellpadding="0" class="registro-clase-footer">
  <tr>
    <td width="60%" class="camposDesc10"><div align="left"><%= Time.current.strftime("%Y-%m-%d %X") %> - <%= User.find(is_admin).nombre rescue nil %></div></td>
    <td width="40%" class="camposDesc10"><div align="right"><a href="javascript:window.print()" class="imprimirlink">Imprimir</a>&nbsp;&nbsp;</div></td>
  </tr>
</table>
<%= flash[:factura] %>
</div>
<% unless pdf_request? %>
<script>window.onload = function() { window.print(); };</script>
<% end %>