<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%"  class="text-center">Acciones</th>
        <th width="20%">Usuario / Fecha</th>
        <th width="22%">Categoría / Trámite</th>
        <th width="8%">Placa</th>
        <th width="22%" class="text-center">Documentos</th>
        <th width="10%" class="text-center">Factura</th>
        <th width="10%" class="text-center">Horas</th>
      </tr>
    </thead>
    <tbody id="tbody_personastramites">
      <% persona.personastramites.each do |pt| %>
        <%= render 'personastramites/tr', personastramite: pt, persona: persona %>
      <% end %>
    </tbody>
  </table>
</div>
