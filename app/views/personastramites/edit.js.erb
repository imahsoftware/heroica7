$("#personastramite_form").collapse("hide");
$("#personastramite_form").empty();

<% if @active_record.present? %>
  $("#personastramite_<%= @active_record.id %>").replaceWith("<%= j render 'tr', personastramite: @active_record, persona: @persona %>");
<% end %>

$("#personastramite_<%= @personastramite.id %>").html("<td colspan='7'><%= j render 'form' %></td>");
$("#personastramite_<%= @personastramite.id %>").addClass("active_personastramite");

$(".select2").select2();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
