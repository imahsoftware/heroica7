<%
  # Fecha del diploma: parametro 24 si existe, si no la de hoy
  datoFch =
    (Parametro.find_by(id: 24)&.valor&.to_date) ||
    (defined?(Time.zone) && Time.zone ? Time.zone.today : Date.today)
%>
<%= render partial: 'certificado_imagen', locals: {
      persona: @personastramite.persona,
      curso:   @nombre,
      fecha:   datoFch
    } %>
