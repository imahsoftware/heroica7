<tr id="personastramite_<%= personastramite.id %>">
  <td class="text-center">
    <% unless personastramite.factura_id %>
      <% if is_auth_a("personastramite") %>
        <%= link_to edit_persona_personastramite_path(persona, personastramite),
            remote: true, title: 'Editar', data: { toggle: 'tooltip' } do %>
          <button class="btn btn-xs btn-warning btn-accion"><i class="fa fa-edit"></i></button>
        <% end %>
      <% end %>
      <% if is_auth_e("personastramite") %>
        <%= link_to persona_personastramite_path(persona, personastramite),
            remote: true, method: :delete,
            data: { confirm: '¿Seguro que desea eliminar?', toggle: 'tooltip' },
            title: 'Eliminar' do %>
          <button class="btn btn-xs btn-danger btn-accion"><i class="fa fa-trash"></i></button>
        <% end %>
      <% end %>
    <% else %>
      <% if is_auth_a("personastramiteesp") %>
        <%= link_to edit_persona_personastramite_path(persona, personastramite),
            remote: true, title: 'Editar (especial)', data: { toggle: 'tooltip' } do %>
          <button class="btn btn-xs btn-warning btn-accion"><i class="fa fa-edit"></i></button>
        <% end %>
      <% end %>
    <% end %>
  </td>

  <td>
    <small>
      <%= personastramite.created_at.strftime('%Y-%m-%d %X') rescue nil %> -
      <%= personastramite.user.username rescue nil %><br>
      <%= personastramite.updated_at.strftime('%Y-%m-%d %X') rescue nil %> -
      <%= User.find(personastramite.user_actualiza).username rescue nil %>
    </small>
  </td>

  <td>
    <%= personastramite.categoria.nombre rescue nil %><br>
    <small><%= personastramite.tipostramite.descripcion rescue nil %></small>
    <% if personastramite.empresa_id %>
      <br><small>Empresa: <%= personastramite.empresa.nombre rescue nil %></small>
    <% end %>
  </td>

  <td><%= personastramite.placa.descripcion rescue nil %></td>

  <td class="text-center">
    <div class="btn-group btn-group-xs" style="white-space: normal;">
      <%= link_to_popup registroclase_persona_personastramite_path(persona, personastramite, format: :pdf),
          popup: popup_ventana_grande,
          class: 'btn btn-xs btn-default', title: 'Registro Clase',
          data: { toggle: 'tooltip', turbo: false } do %>
        <i class="fa fa-list-alt"></i>
      <% end %>
      <%= link_to_popup registrosolicitud_persona_personastramite_path(persona, personastramite, format: :pdf),
          popup: popup_ventana_grande,
          class: 'btn btn-xs btn-default', title: 'Registro Solicitud',
          data: { toggle: 'tooltip', turbo: false } do %>
        <i class="fa fa-sticky-note"></i>
      <% end %>
      <%= link_to_popup teorico_persona_personastramite_path(persona, personastramite),
          popup: ['new_window', 'height=500,width=800,scrollbars=yes'],
          class: 'btn btn-xs btn-info', title: 'Programar Teórico',
          data: { toggle: 'tooltip', turbo: false } do %>
        <i class="fa fa-book"></i>
      <% end %>
      <%= link_to_popup acuerdocomercial_persona_personastramite_path(persona, personastramite, format: :pdf),
          popup: popup_ventana_grande,
          class: 'btn btn-xs btn-default', title: 'Acuerdo Comercial',
          data: { toggle: 'tooltip', turbo: false } do %>
        <i class="fa fa-info-circle"></i>
      <% end %>
      <%= link_to_popup contrato_persona_personastramite_path(persona, personastramite, format: :pdf),
          popup: popup_ventana_grande,
          class: 'btn btn-xs btn-default', title: 'Contrato',
          data: { toggle: 'tooltip', turbo: false } do %>
        <i class="fa fa-file-text-o"></i>
      <% end %>

      <div class="btn-group btn-group-xs">
        <button type="button"
                class="btn btn-xs btn-success dropdown-toggle"
                data-toggle="dropdown"
                aria-haspopup="true"
                aria-expanded="false"
                title="Diplomas">
          <i class="fa fa-certificate"></i> <span class="caret"></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-right">
          <li>
            <%= link_to_popup diploma_persona_personastramite_path(persona, personastramite,
                  nombredip: 'MANEJO DEFENSIVO, NORMAS DE TRANSITO Y SEGURIDAD VIAL', format: :pdf),
                popup: popup_ventana_grande, data: { turbo: false } do %>
              <i class="fa fa-shield"></i> Manejo defensivo
            <% end %>
          </li>
          <li>
            <%= link_to_popup diploma_persona_personastramite_path(persona, personastramite, nombredip: 'MECANICA BASICA', format: :pdf),
                popup: popup_ventana_grande, data: { turbo: false } do %>
              <i class="fa fa-cog"></i> Mecánica básica
            <% end %>
          </li>
          <li>
            <%= link_to_popup diploma_persona_personastramite_path(persona, personastramite, nombredip: 'PRIMEROS AUXILIOS', format: :pdf),
                popup: popup_ventana_grande, data: { turbo: false } do %>
              <i class="fa fa-ambulance"></i> Primeros auxilios
            <% end %>
          </li>
          <li>
            <%= link_to_popup diploma_persona_personastramite_path(persona, personastramite, nombredip: 'TECNICAS DE CONDUCCIÓN', format: :pdf),
                popup: popup_ventana_grande, data: { turbo: false } do %>
              <i class="fa fa-road"></i> Técnicas de conducción
            <% end %>
          </li>
          <li>
            <%= link_to_popup diploma_persona_personastramite_path(persona, personastramite, nombredip: 'INSPECCIÓN PREOPERACIONAL', format: :pdf),
                popup: popup_ventana_grande, data: { turbo: false } do %>
              <i class="fa fa-search"></i> Inspección preoperacional
            <% end %>
          </li>
          <li>
            <%= link_to_popup diploma_persona_personastramite_path(persona, personastramite, nombredip: 'CONTROL DE INCENDIOS EN CARRETERA', format: :pdf),
                popup: popup_ventana_grande, data: { turbo: false } do %>
              <i class="fa fa-fire"></i> Control incendios carretera
            <% end %>
          </li>
          <li>
            <%= link_to_popup diploma_persona_personastramite_path(persona, personastramite, nombredip: 'COMPORTAMIENTO DE LOS ESTUDIANTES', format: :pdf),
                popup: popup_ventana_grande, data: { turbo: false } do %>
              <i class="fa fa-users"></i> Comportamiento estudiantes
            <% end %>
          </li>
        </ul>
      </div>

      <%= link_to_popup practica_persona_personastramite_path(persona, personastramite),
          popup: popup_ventana_grande,
          class: 'btn btn-xs btn-primary', title: 'Evaluación Práctica Vehículo',
          data: { toggle: 'tooltip', turbo: false } do %>
        <i class="fa fa-car"></i>
      <% end %>
      <%= link_to_popup practicam_persona_personastramite_path(persona, personastramite),
          popup: popup_ventana_grande,
          class: 'btn btn-xs btn-primary', title: 'Evaluación Práctica Motos',
          data: { toggle: 'tooltip', turbo: false } do %>
        <i class="fa fa-motorcycle"></i>
      <% end %>
    </div>
  </td>

  <td class="text-center">
    <% factura = personastramite.factura_id ? personastramite.factura : nil %>
    <% if factura %>
      <%= link_to_popup facturacero(factura.nro_factura),
          verfactura_facturas_path(factura_id: factura.id),
          popup: popup_ventana_grande,
          title: 'Ver Factura',
          data: { turbo: false },
          class: 'btn btn-xs btn-success' %>
    <% else %>
      <%= link_to crearfactura_persona_personastramite_path(persona, personastramite,
              tipostramite_id: personastramite.tipostramite_id,
              categoria_id:    personastramite.categoria_id),
          target: '_blank', rel: 'noopener',
          data: { confirm: '¿Está seguro que desea Generar Factura?', turbo: false },
          class: 'btn btn-xs btn-warning', title: 'Generar Factura' do %>
        <i class="fa fa-file-invoice-dollar"></i> Facturar
      <% end %>
    <% end %>
  </td>

  <td class="text-center">
    <%= link_to hora_personastramiteshoras_path(personastramite_id: personastramite.id),
        class: 'btn btn-xs btn-info', title: 'Ver Horas',
        data: { turbo: false } do %>
      <i class="fa fa-clock-o"></i> Horas
    <% end %>
  </td>
</tr>

<%# Sub-tabla de horas si existen %>
<% if personastramite.personastramiteshoras.exists? %>
  <tr>
    <td colspan="7">
      <div class="box box-default" style="margin: 6px 0 0; border: 1px solid #e5e7eb;">
        <div class="box-header with-border" style="padding: 6px 10px; background: #f5f5f5; color: #333;">
          <h3 class="box-title" style="font-size: 12px; font-weight: 700; margin: 0; color: #333;">
            <i class="fa fa-clock-o" style="color:#333;"></i> REGISTRO DE HORAS
          </h3>
        </div>
        <div class="box-body" style="padding: 0;">
          <table class="table table-condensed table-bordered table-striped text-table" style="margin:0;">
            <thead>
              <tr>
                <th style="width: 110px; background:#394959; color:#fff;">Fecha</th>
                <th class="text-center" style="width: 120px; background:#394959; color:#fff;">Prácticas</th>
                <th class="text-center" style="width: 120px; background:#394959; color:#fff;">Teóricas</th>
                <th class="text-center" style="width: 110px; background:#394959; color:#fff;">Taller</th>
                <th class="text-center" style="width: 90px; background:#394959; color:#fff;">Total</th>
                <th style="background:#394959; color:#fff;">Instructor</th>
              </tr>
            </thead>
            <tbody>
              <% personastramite.personastramiteshoras.each do |hora| %>
                <tr>
                  <td><%= hora.fecha %></td>
                  <td class="text-center"><%= hora.practicas %></td>
                  <td class="text-center"><%= hora.teoricas %></td>
                  <td class="text-center"><%= hora.taller %></td>
                  <td class="text-center"><strong><%= hora.dtotal rescue nil %></strong></td>
                  <td><%= hora.instructor.nombre rescue nil %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </td>
  </tr>
<% end %>
