$(".alert_flash").fadeOut(300, function() { $(this).remove(); });

<% if @persona.personastramites.count == 1 %>
  $("#personastramites").html("<%= j render 'tabla', persona: @persona, personastramite: @personastramite %>");
<% else %>
  $("#tbody_personastramites").prepend("<%= j render 'tr', personastramite: @personastramite, persona: @persona %>");
<% end %>

$(".clean").val("").trigger('change');
$("#personastramite_form").collapse("hide");
$('[data-toggle="tooltip"]').tooltip();
$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");
$(".form-group").removeClass("has-error");
$(".form-group > .help-block.help-block-error").remove();

setTimeout(function() {
  $(".alert_flash").fadeOut(300, function() { $(this).remove(); });
}, 5000);
