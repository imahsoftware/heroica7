<div class="box box-default color-palette-box">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-file-text"></i> Información Trámite</h3>
    <div class="box-tools pull-right">
      <% if permiso("personastramite","C").to_s == "S" %>
        <%= link_to new_persona_personastramite_path(persona),
            id: 'new_personastramite_button',
            class: 'btn btn-sm btn-warning',
            remote: true do %>
          <i class="fa fa-plus-square"></i> Agregar
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="personastramite_form" class="collapse"></div>

    <div id="personastramites">
      <% if persona.personastramites.exists? %>
        <%= render 'personastramites/tabla', persona: persona, personastramite: personastramite %>
      <% else %>
        <div class="alert alert-warning">
          <h4><i class="icon fa fa-info"></i> Atención</h4>
          No hay trámites registrados para esta persona.
        </div>
      <% end %>
    </div>
  </div>
</div>
