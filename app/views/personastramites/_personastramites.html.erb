<div class="box box-usuarios">
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-file-text"></i> Información Trámite
      <span class="users-count-badge"><%= persona.personastramites.count %> registros</span>
    </span>
    <div class="box-tools pull-right" style="margin-top: -2px;">
      <% if permiso("personastramite", "C").to_s == "S" %>
        <%= link_to new_persona_personastramite_path(persona),
            id: 'new_personastramite_button',
            class: 'btn btn-sm btn-success',
            remote: true,
            title: 'Agregar trámite' do %>
          <i class="fa fa-plus"></i> Agregar
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="personastramite_form" class="collapse" style="margin-bottom: 12px;"></div>

    <div id="personastramites">
      <% if persona.personastramites.exists? %>
        <%= render 'personastramites/tabla', persona: persona, personastramite: personastramite %>
      <% else %>
        <div class="empty-state">
          <i class="fa fa-file-text"></i>
          <p>No hay trámites registrados para esta persona.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
