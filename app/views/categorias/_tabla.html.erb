<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th>Nombre</th>
        <th width="10%">Cód. Nuevo</th>
        <th width="10%">Código</th>
        <th width="12%">Tipo Servicio</th>
        <th width="7%" class="text-center">Prácticas</th>
        <th width="7%" class="text-center">Teóricas</th>
        <th width="7%" class="text-center">Taller</th>
        <th width="8%" class="text-center">Alerta Práct.</th>
      </tr>
    </thead>
    <tbody id="tbody_categorias">
      <% @categorias.each do |categoria| %>
        <%= render 'categorias/tr', categoria: categoria %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="row" style="margin-top: 12px;">
  <div class="col-xs-12 text-right">
    <%= will_paginate @categorias, renderer: BootstrapPagination::Rails %>
  </div>
</div>
