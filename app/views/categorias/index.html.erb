<% title 'Categorías' %>

<div class="box box-usuarios">
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-tags"></i> Categorías
      <span class="users-count-badge"><%= @categorias.total_entries rescue @categorias.count %> registros</span>
    </span>
    <div class="box-tools pull-right" style="margin-top: -2px;">
      <%= link_to new_categoria_path, remote: true, id: 'new_categoria_button',
          class: 'btn btn-sm btn-success',
          title: 'Agregar categoría' do %>
        <i class="fa fa-plus"></i> Nueva
      <% end %>
    </div>
  </div>

  <div class="box-body">

    <div class="row" style="margin-bottom: 16px;">
      <div class="col-md-5 col-sm-7 col-xs-12 search-bar">
        <%= search_form_for @q do |f| %>
          <div class="input-group">
            <%= f.search_field :nombre_or_codigo_or_codigo_nuevo_cont,
                class: 'form-control',
                placeholder: 'Buscar por nombre o código...' %>
            <div class="input-group-btn">
              <%= button_tag type: 'submit', class: 'btn btn-search' do %>
                <i class="fa fa-search"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="flash_messages"></div>
    <div id="categoria_form" class="collapse" style="margin-bottom: 12px;"></div>

    <div id="categorias">
      <% if @categorias.any? %>
        <%= render 'categorias/tabla' %>
      <% else %>
        <div class="empty-state">
          <i class="fa fa-tags"></i>
          <p>No se encontraron categorías.</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
