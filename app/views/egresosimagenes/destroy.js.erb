$(".alert_flash").fadeOut(300, function() { $(this).remove(); });

<% if @egreso.egresosimagenes.count == 0 %>
  $("#egresosimagenes").html("<div class='alert alert-warning'><h4><i class='icon fa fa-info'></i> <%= t :atencion %></h4><%= t :atencion_msj %></div>");
<% else %>
  $("#egresosimagen_<%= @egresosimagen.id %>").remove();
<% end %>

$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");

setTimeout(function() {
  $(".alert_flash").fadeOut(300, function() { $(this).remove(); });
}, 5000);

$('.tooltip').tooltip('hide');
