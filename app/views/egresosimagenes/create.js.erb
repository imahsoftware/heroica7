$(".alert_flash").fadeOut(300, function() { $(this).remove(); });

<% if @egreso.egresosimagenes.count == 1 %>
  $("#egresosimagenes").html("<%= j render 'tabla' %>");
<% else %>
  $("#tbody_egresosimagenes").prepend("<%= j render 'tr', egresosimagen: @egresosimagen %>");
<% end %>

$(".clean").val("").trigger('change');
$("#egresosimagen_form").collapse("hide");
$('[data-toggle="tooltip"]').tooltip();
$(".flash_messages").html("<%= j render 'layouts/flash_messages' %>");
$(".form-group").removeClass("has-error");
$(".form-group > .help-block.help-block-error").remove();

setTimeout(function() {
  $(".alert_flash").fadeOut(300, function() { $(this).remove(); });
}, 5000);
