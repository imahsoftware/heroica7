<tr id="egresosimagen_<%= egresosimagen.id %>">
  <td class="text-center">
    <%= link_to egreso_egresosimagen_path(@egreso, egresosimagen),
        remote: true, method: :delete,
        title: t(:title_elimina),
        data: { confirm: t(:elimina_confirma), toggle: 'tooltip' } do %>
      <button class="btn btn-xs btn-danger btn-accion"><i class="fa fa-trash"></i></button>
    <% end %>
    <%= link_to egresosimagen.egreso.url,
        title: 'Ver Documento',
        data: { toggle: 'tooltip' },
        onclick: 'window.open(this.href,"new_window","height=450,width=600,scrollbars=yes");return false;' do %>
      <button class="btn btn-xs btn-primary btn-accion"><i class="fa fa-file"></i></button>
    <% end %>
  </td>
  <td style="font-size: 11px; color: #64748b;">
    <%= egresosimagen.created_at.strftime('%Y-%m-%d %H:%M') rescue '—' %>
  </td>
  <td><%= egresosimagen.descripcion %></td>
  <td style="font-size: 11px; color: #64748b;">
    <code style="font-size: 11px; background: #f1f5f9; color: #394959; padding: 2px 6px; border-radius: 4px;">
      <%= egresosimagen.egreso_file_name %>
    </code>
  </td>
</tr>
