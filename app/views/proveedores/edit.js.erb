$("#proveedor_form").collapse("hide");
$("#proveedor_form").empty();

<% if @active_record.present? %>
  $("#proveedor_<%= @active_record.id %>").replaceWith("<%= j render 'tr', proveedor: @active_record %>");
<% end %>

$("#proveedor_<%= @proveedor.id %>").html("<td colspan='7'><%= j render 'form' %></td>");
$("#proveedor_<%= @proveedor.id %>").addClass("active_proveedor");

$(".select2").select2();
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
