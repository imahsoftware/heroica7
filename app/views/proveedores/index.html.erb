<% title 'Proveedores' %>

<div class="box box-usuarios">
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-truck"></i> Proveedores
      <span class="users-count-badge"><%= @proveedores.total_entries rescue @proveedores.count %> registros</span>
    </span>
    <div class="box-tools pull-right" style="margin-top: -2px;">
      <%= link_to new_proveedor_path, remote: true, id: 'new_proveedor_button',
          class: 'btn btn-sm btn-success',
          title: 'Agregar proveedor' do %>
        <i class="fa fa-plus"></i> Nuevo
      <% end %>
    </div>
  </div>

  <div class="box-body">

    <div class="row" style="margin-bottom: 16px;">
      <div class="col-md-5 col-sm-7 col-xs-12 search-bar">
        <%= search_form_for @q do |f| %>
          <div class="input-group">
            <%= f.search_field :autobuscar_or_identificacion_or_email_cont,
                class: 'form-control',
                placeholder: 'Buscar por nombre, identificación o email...' %>
            <div class="input-group-btn">
              <%= button_tag type: 'submit', class: 'btn btn-search' do %>
                <i class="fa fa-search"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="flash_messages"></div>
    <div id="proveedor_form" class="collapse" style="margin-bottom: 12px;"></div>

    <div id="proveedores">
      <% if @proveedores.any? %>
        <%= render 'proveedores/tabla' %>
      <% else %>
        <div class="empty-state">
          <i class="fa fa-truck"></i>
          <p>No se encontraron proveedores.</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
