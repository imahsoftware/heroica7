<div class="box box-primary">
  <div class="box-header with-border">
    <h3 class="box-title">
      <i class="fa fa-clock-o"></i> Nuevo registro de horas
      <small>[<%= @personastramite&.persona&.nombres %>]</small>
    </h3>
  </div>

  <div class="box-body">
    <%= render 'form',
      personastramiteshora: @personastramiteshora,
      personastramite: @personastramite,
      url: personastramiteshoras_path(personastramite_id: @personastramite.id),
      method: :post %>
  </div>
</div>

<script>
  $('.select2').select2({ width: '100%' });
</script>

