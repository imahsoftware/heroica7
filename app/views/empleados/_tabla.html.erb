<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th width="15%">Identificación</th>
        <th width="25%">Nombre</th>
        <th width="20%">Cargo</th>
        <th width="10%" class="text-center">Instructor</th>
        <th width="10%" class="text-center">Estado</th>
      </tr>
    </thead>
    <tbody id="tbody_empleados">
      <% @empleados.each do |empleado| %>
        <%= render 'empleados/tr', empleado: empleado %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="row" style="margin-top: 12px;">
  <div class="col-xs-12 text-right">
    <%= will_paginate @empleados, renderer: BootstrapPagination::Rails %>
  </div>
</div>
