$("#empleado_form").collapse("hide");

$("#empleado_form").empty();

<% if @active_record.present? %>
  $("#empleado_<%= @active_record.id %>").replaceWith("<%= j render 'tr', empleado: @active_record %>");
<% end %>

$("#empleado_<%= @empleado.id %>").html("<td colspan='6'><%= j render 'form' %></td>");

$("#empleado_<%= @empleado.id %>").addClass("active_empleado");

$(".select2").select2();

$(".tooltip").tooltip("hide");

$('[data-toggle="tooltip"]').tooltip();
