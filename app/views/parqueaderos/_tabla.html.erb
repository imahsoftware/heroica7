<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th width="12%">Placa</th>
        <th width="16%">Fecha y hora</th>
        <th width="10%" class="text-center">Tipo</th>
        <th width="18%">Instructor</th>
        <th width="12%" class="text-right">Kilometraje</th>
        <th width="12%" class="text-right">Combustible</th>
      </tr>
    </thead>
    <tbody id="tbody_parqueaderos">
      <% @parqueaderos.each do |parqueadero| %>
        <%= render 'parqueaderos/tr', parqueadero: parqueadero %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="row" style="margin-top: 12px;">
  <div class="col-xs-12 text-right">
    <%= will_paginate @parqueaderos, renderer: BootstrapPagination::Rails %>
  </div>
</div>
