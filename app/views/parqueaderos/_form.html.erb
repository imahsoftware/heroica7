<%= simple_form_for @parqueadero, remote: true do |f| %>
  <div class="bs-callout">

    <p class="section-label">Registro entrada / salida</p>
    <div class="row">
      <div class="col-md-3">
        <%= f.input :fecha_hora, as: :string, label: 'Fecha y hora',
            input_html: { class: 'form-control datetimepicker clean', readonly: true } %>
      </div>
      <div class="col-md-2">
        <%= f.input :tipo, as: :select,
            collection: [['', nil], ['ENTRADA', 'ENTRADA'], ['SALIDA', 'SALIDA']],
            include_blank: false,
            input_html: { class: 'form-control' },
            label: 'Tipo registro' %>
      </div>
      <div class="col-md-3">
        <%= f.input :placa_id, as: :select,
            collection: Placa.order(:descripcion).collect { |p| [p.descripcion, p.id] },
            include_blank: true,
            input_html: { class: 'select2 clean' },
            label: 'Placa' %>
      </div>
      <div class="col-md-4">
        <%= f.input :instructor_id, as: :select,
            collection: Instructor.order(:nombre).collect { |i| [i.nombre, i.id] },
            include_blank: true,
            input_html: { class: 'select2 clean' },
            label: 'Instructor a cargo' %>
      </div>
    </div>

    <div class="row" style="margin-top: 8px;">
      <div class="col-md-3">
        <%= f.input :kilometraje_entrada, label: 'Kilometraje',
            input_html: { class: 'form-control' } %>
      </div>
      <div class="col-md-3">
        <%= f.input :cant_combustible, label: 'Cantidad combustible',
            input_html: { class: 'form-control' } %>
      </div>
    </div>

    <div class="row" style="margin-top: 12px;">
      <div class="col-md-6">
        <% if @parqueadero.new_record? %>
          <%= button_tag t(:cancelar), type: 'button',
              onclick: "$('#parqueadero_form').html('').removeClass('in').css({height:'0px',overflow:'hidden'}); return false;",
              class: 'btn btn-flat btn-default' %>
        <% else %>
          <%= link_to t(:cancelar), parqueadero_path(@parqueadero),
              class: 'btn btn-flat btn-default', remote: true %>
        <% end %>
      </div>
      <div class="col-md-6 text-right">
        <%= f.button :submit, t(:guardar), class: 'btn-guardar' %>
      </div>
    </div>

  </div>
<% end %>
