<style type="text/css">
  /* Responsive: keep layout, no horizontal scroll */
  table.sample,
  table[width="850"] {
    width: 100% !important;
    max-width: 100% !important;
    table-layout: fixed;
  }

  td, th {
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  input.campo,
  textarea.campoMultiLinea,
  select.span2,
  input.campodisabled {
    width: 100% !important;
    box-sizing: border-box;
  }

  /* Print: mimic legacy Rails2 (fixed 850px, inputs honor size=) */
  @media print {
    table.sample,
    table[width="850"] {
      width: 850px !important;
      max-width: 850px !important;
      table-layout: auto !important;
    }

    input.campo,
    textarea.campoMultiLinea,
    select.span2,
    input.campodisabled {
      width: auto !important;
      max-width: none !important;
    }

    .no-print { display: none !important; }
  }
</style>

