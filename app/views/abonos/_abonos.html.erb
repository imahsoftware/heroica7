<div class="box box-usuarios">
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-money"></i> ABONOS
    </span>
  </div>
  <div class="box-body">

    <%# ── Formulario nuevo abono ─────────────────────────────────────────────── %>
    <% if is_auth_c('abono') && @abono && !@abono.persisted? %>
      <% if @factura.estado == 'C' %>
        <div class="alert alert-warning text-center">LA FACTURA SE ENCUENTRA CANCELADA</div>
      <% elsif @factura.estado == 'A' %>
        <div class="alert alert-danger text-center">LA FACTURA SE ENCUENTRA ANULADA</div>
      <% else %>
        <%= render partial: '/abonos/abonos_form' %>
      <% end %>
    <% end %>

    <%# ── Listado de abonos ────────────────────────────────────────────────────── %>
    <% if @factura.abonos.exists? %>
      <table class="table table-bordered table-condensed table-striped table-usuarios">
        <thead>
          <tr>
            <th>Usuario</th>
            <th class="text-center">Nro Abono</th>
            <th class="text-right">Valor Abono</th>
            <th class="text-right">Saldo</th>
            <th class="text-center">Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @factura.abonos.each do |abono| %>
            <% if @abono && abono.id == @abono.id %>
              <tr id="abono_<%= abono.id %>">
                <td colspan="6">
                  <strong>EDITAR ABONO</strong><br>
                  <%= render partial: '/abonos/abonos_form', locals: { editing: true, ab: abono } %>
                </td>
              </tr>
            <% else %>
              <tr id="abono_<%= abono.id %>" class="<%= cycle('odd', 'even') %>">
                <td>
                  <small>
                    <%= abono.created_at.strftime('%Y-%m-%d %H:%M:%S') %> - <%= abono.user&.username %><br>
                    <%= abono.updated_at.strftime('%Y-%m-%d %H:%M:%S') %> - <%= User.find(abono.user_anula).username rescue nil %>
                  </small>
                </td>
                <td class="text-center"><%= facturacero(abono.nro_abono) %></td>
                <td class="text-right"><%= camponumerico(abono.valor) %></td>
                <td class="text-right"><%= camponumerico(abono.saldo) %></td>
                <td class="text-center"><%= abono.destado %></td>
                <td class="text-center">
                  <% if abono.estado.to_s != 'A' %>
                    <%= link_to_popup verabono_abono_path(abono_id: abono.id),
                        popup: popup_ventana_grande,
                        class: 'btn btn-xs btn-info',
                        title: 'Ver Abono',
                        data: { turbo: false } do %>
                      <i class="fa fa-eye"></i>
                    <% end %>
                    <% if is_auth_e('abono') %>
                      <%= link_to 'Anular Abono',
                            anula_factura_abono_path(@factura, abono),
                            remote: true,
                            data: { confirm: '¿Seguro?' },
                            class: 'btn btn-xs btn-danger' %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="alert alert-info">No hay datos asociados.</div>
    <% end %>

    <% if flash[:abono] %>
      <div id="flash_abono" class="alert alert-success">
        <%= flash[:abono] %>
      </div>
      <script>setTimeout(function(){ var el = document.getElementById('flash_abono'); if(el){ el.style.transition='opacity 1s'; el.style.opacity=0; setTimeout(function(){ el.remove(); }, 1000); } }, 4000);</script>
    <% end %>

  </div>
</div>
