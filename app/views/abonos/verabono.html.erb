<style>
  .verabono-sheet {
    max-width: 720px;
    margin: 0 auto;
  }

  @media print {
    @page {
      <% if pdf_request? %>
      size: Letter portrait;
      margin: 10mm;
      <% else %>
      size: 8.5in 5.5in;
      margin: 0 0.15in 0.1in 0.15in;
      <% end %>
    }

    html, body {
      margin: 0 !important;
      padding: 0 !important;
    }

    .informe-document {
      max-width: none !important;
      width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .verabono-sheet {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
      page-break-inside: avoid;
      page-break-after: avoid;
    }

    .verabono-sheet br,
    .verabono-sheet .verabono-spacer {
      display: none !important;
    }

    .verabono-sheet .verabono-concepto {
      height: auto !important;
    }

    .verabono-sheet img {
      max-height: 0.75in !important;
      max-width: 1.1in !important;
    }

    .verabono-sheet td,
    .verabono-sheet th {
      padding: 1px 3px !important;
      line-height: 1.15 !important;
    }

    .imprimirlink {
      display: none !important;
    }
  }
</style>

<div class="verabono-sheet" align="center">
  <table width="100%" border="0" cellspacing="0" cellpadding="1">
    <tr>
      <td width="20%" valign="center">
        <div align="center">
          <%= informe_image_tag 'logo_heroica.png', style: 'max-width:130px; max-height:110px;' %>
        </div>
      </td>
      <td>
        <table width="100%" border="0" cellspacing="0" cellpadding="0">
          <tr><td class="camposDescN12"><div align="center"><%= Parametro.find(1).valor.to_s rescue '' %></div></td></tr>
          <tr><td class="camposDescN11"><div align="center">NIT: <%= Parametro.find(2).valor.to_s rescue '' %></div></td></tr>
          <tr><td class="camposDescN11"><div align="center"><%= Parametro.find(13).valor.to_s rescue '' %></div></td></tr>
          <tr><td class="camposDescN11"><div align="center">Sede Bocagrande: <%= Parametro.find(14).valor.to_s rescue '' %></div></td></tr>
          <tr><td class="camposDescN11"><div align="center">Sede Turbaco: <%= Parametro.find(15).valor.to_s rescue '' %></div></td></tr>
          <tr><td class="camposDescN11"><div align="center">Sitio Web: <%= Parametro.find(9).valor.to_s rescue '' %></div></td></tr>
        </table>
      </td>
    </tr>
  </table>

  <div class="verabono-spacer"><br></div>

  <table width="100%" border="0" cellspacing="0" cellpadding="1">
    <tr>
      <td width="72%">
        <table width="100%" border="0" cellpadding="0" cellspacing="0" class="sample">
          <tr>
            <thead><td colspan="4" class="camposDescN11" height="20">INFORMACION CLIENTE</td></thead>
          </tr>
          <tr>
            <td class="camposDescN11" height="20">Nombre:</td>
            <td colspan="3" class="camposDesc11"><%= @abono.factura&.persona&.nombres %></td>
          </tr>
          <tr>
            <td class="camposDescN11" height="20">Identificación:</td>
            <td colspan="3" class="camposDesc11"><%= @abono.factura&.persona&.identificacion %></td>
          </tr>
          <tr>
            <td class="camposDescN11" height="20">Dirección:</td>
            <td colspan="3" class="camposDesc11"><%= @abono.factura&.persona&.direccion %></td>
          </tr>
          <tr>
            <td width="20%" class="camposDescN11" height="20">Teléfonos:</td>
            <td width="39%" class="camposDesc11">
              <%= @abono.factura&.persona&.telefono %> - <%= @abono.factura&.persona&.celular %>
            </td>
            <td width="15%" class="camposDesc11"><div align="center" class="camposDescN11">Estado:</div></td>
            <td width="26%" class="camposDesc11"><div align="center" class="camposDescN12"><%= @abono.destado %></div></td>
          </tr>
        </table>
      </td>
      <td width="1%">&nbsp;</td>
      <td width="26%">
        <table width="100%" border="0" cellpadding="0" cellspacing="0">
          <tr><td class="camposDescN16"><div align="center">RECIBO DE CAJA</div></td></tr>
          <tr>
            <td class="camposDescN16">
              <div align="center">N&ordm; <%= Parametro.find(17).valor.to_s rescue '' %><%= facturacero(@abono.nro_abono) %></div>
            </td>
          </tr>
          <tr><td class="camposDescN12"><div align="center">REGIMEN ORDINARIO</div></td></tr>
          <tr>
            <td class="camposDescN12">
              <div align="center">Fecha: <%= @abono.created_at.strftime('%Y-%m-%d') %></div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  <div class="verabono-spacer"><br></div>

  <table width="100%" height="150" border="0" cellpadding="0" cellspacing="0" class="sample verabono-concepto">
    <tr>
      <td valign="top">
        <table width="100%" border="0" cellspacing="0" cellpadding="0" class="sample">
          <thead>
            <tr>
              <td width="83%" class="camposDescN11">Concepto</td>
              <td width="17%" class="camposDescN11"><div align="center">Subtotal</div></td>
            </tr>
          </thead>
          <tr>
            <td class="camposDesc14">
              Abono en <span class="camposDescN14"><%= @abono.forma_pago %></span>
              a la Factura Nro <span class="camposDescN14"><%= facturacero(@abono.factura&.nro_factura) %></span>
              por concepto de Trámite <span class="camposDescN14">(<%= @abono.factura&.tipostramite&.descripcion %>)</span>
              para la categoría <span class="camposDescN14">(<%= @abono.factura&.categoria&.nombre %>).</span>
              <br><br>
              Saldo de la Factura $ <span class="camposDescN14"><%= camponumerico(@abono.saldo) %></span>
            </td>
            <td class="camposDesc11"><div align="center"><%= camponumerico(@abono.valor) %></div></td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  <div class="verabono-spacer"><br></div>

  <table width="100%" border="0" cellpadding="0" cellspacing="0" class="sample">
    <tr valign="top">
      <td width="53%">
        <table width="100%" height="100%" border="0" cellspacing="0" cellpadding="0" class="sample">
          <tr>
            <td class="camposDesc10">
              AUTORIZADOS POR RESOLUCION DEL MINISTERIO DE TRANSPORTE <%= Parametro.find(5).valor.to_s rescue '' %>.
              RESOLUCION DE LA SECRETARIA DE EDUCACION <%= Parametro.find(4).valor.to_s rescue '' %>.
              RESOLUCION DE FACTURACION NRO <%= Parametro.find(18).valor.to_s rescue '' %>.
              EXCLUIDO DEL IMPUESTO A LAS VENTAS DE ACUERDO AL ARTICULO 476, NUMERAL 6 DEL ESTATUTO TRIBUTARIO
            </td>
          </tr>
        </table>
      </td>
      <td width="1%">&nbsp;</td>
      <td width="46%">
        <table width="100%" border="0" cellpadding="0" cellspacing="0" class="sample">
          <tr>
            <td height="30" class="camposDescN12">TOTAL A PAGAR</td>
            <td class="camposDescN12"><div align="right"><%= camponumerico(@abono.valor) %>&nbsp;&nbsp;</div></td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  <table width="100%" border="0" cellpadding="0" cellspacing="0">
    <tr>
      <td width="60%" height="20" class="camposDesc11">
        <div align="left"><%= Time.now.strftime('%Y-%m-%d %H:%M:%S') %> - <%= User.find(is_admin).nombre rescue nil %></div>
      </td>
      <td width="40%" height="20" class="camposDesc11">
        <div align="right">
          <a href="javascript:window.print()" class="imprimirlink">Imprimir</a>&nbsp;&nbsp;
        </div>
      </td>
    </tr>
  </table>
</div>
<% unless pdf_request? %>
<script>
  window.onload = function() { window.print(); };
</script>
<% end %>
