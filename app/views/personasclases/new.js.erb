<% if @active_record.present? %>
  $("#personasclase_<%= @active_record.id %>").replaceWith("<%= j render "tr", personasclase: @active_record, persona: @persona %>");
<% end %>
$("#personasclase_form").html("<%= j render "form" %>");
$(".tooltip").tooltip("hide");
$("[data-toggle=\"tooltip\"]").tooltip();
$("#personasclase_form").collapse("show");
$(".select2").select2();
