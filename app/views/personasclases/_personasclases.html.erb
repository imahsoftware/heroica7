<div class="box box-default color-palette-box">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-graduation-cap"></i> Informacion Clases Dictadas</h3>
    <div class="box-tools pull-right">
      <% if permiso("personasclase","C").to_s == "S" %>
        <%= link_to new_persona_personasclase_path(persona),
            id: "new_personasclase_button",
            class: "btn btn-sm btn-warning",
            remote: true do %>
          <i class="fa fa-plus-square"></i> Agregar
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="personasclase_form" class="collapse"></div>

    <div id="personasclases">
      <% if persona.personasclases.exists? %>
        <%= render "personasclases/tabla", persona: persona, personasclase: personasclase %>
      <% else %>
        <div class="alert alert-warning">
          <h4><i class="icon fa fa-info"></i> Atencion</h4>
          No hay clases registradas para esta persona.
        </div>
      <% end %>
    </div>
  </div>
</div>
