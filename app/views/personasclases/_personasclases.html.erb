<div class="box box-usuarios">
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-graduation-cap"></i> Clases Dictadas
      <span class="users-count-badge"><%= persona.personasclases.count %> registros</span>
    </span>
    <div class="box-tools pull-right" style="margin-top: -2px;">
      <% if permiso("personasclase", "C").to_s == "S" %>
        <%= link_to new_persona_personasclase_path(persona),
            id: 'new_personasclase_button',
            class: 'btn btn-sm btn-success',
            remote: true,
            title: 'Agregar clase' do %>
          <i class="fa fa-plus"></i> Agregar
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="personasclase_form" class="collapse" style="margin-bottom: 12px;"></div>

    <div id="personasclases">
      <% if persona.personasclases.exists? %>
        <%= render 'personasclases/tabla', persona: persona, personasclase: personasclase %>
      <% else %>
        <div class="empty-state">
          <i class="fa fa-graduation-cap"></i>
          <p>No hay clases registradas para esta persona.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
