$(".alert_flash").fadeOut(300, function() { $(this).remove(); });

<% if @persona.personasclases.count == 1 %>
  $("#personasclases").html("<%= j render "tabla", persona: @persona, personasclase: @personasclase %>");
<% else %>
  $("#tbody_personasclases").prepend("<%= j render "tr", personasclase: @personasclase, persona: @persona %>");
<% end %>

$(".clean").val("").trigger("change");
$("#personasclase_form").collapse("hide");
$("[data-toggle=\"tooltip\"]").tooltip();
$(".flash_messages").html("<%= j render "layouts/flash_messages" %>");
$(".form-group").removeClass("has-error");
$(".form-group > .help-block.help-block-error").remove();

setTimeout(function() {
  $(".alert_flash").fadeOut(300, function() { $(this).remove(); });
}, 5000);
