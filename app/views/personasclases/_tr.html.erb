<tr id="personasclase_<%= personasclase.id %>">
  <td class="text-center">
    <% if is_auth_a("personasclase") %>
      <%= link_to edit_persona_personasclase_path(persona, personasclase),
          remote: true, title: 'Editar', data: { toggle: 'tooltip' } do %>
        <button class="btn btn-xs btn-warning btn-accion"><i class="fa fa-edit"></i></button>
      <% end %>
    <% end %>
    <% if is_auth_e("personasclase") %>
      <a href="#"
         title="Eliminar"
         data-toggle="tooltip"
         onclick="if(confirm('¿Seguro?')){ $.ajax({ url: '<%= persona_personasclase_path(persona, personasclase) %>', type: 'DELETE', dataType: 'script' }); } return false;">
        <button class="btn btn-xs btn-danger btn-accion"><i class="fa fa-trash"></i></button>
      </a>
    <% end %>
  </td>
  <td>
    <small>
      <%= personasclase.created_at.strftime('%Y-%m-%d %X') rescue nil %> -
      <%= personasclase.user.username rescue nil %><br>
      <%= personasclase.updated_at.strftime('%Y-%m-%d %X') rescue nil %> -
      <%= User.find(personasclase.user_actualiza).username rescue nil %>
    </small>
  </td>
  <td><%= personasclase.tiposhorario.descripcion rescue nil %></td>
  <td><%= personasclase.placa.descripcion rescue nil %></td>
  <td><%= personasclase.instructor.nombre rescue nil %></td>
  <td><%= personasclase.fecha_clase %></td>
</tr>
