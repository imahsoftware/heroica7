<%= simple_form_for [@persona, @personasclase], remote: true do |f| %>
  <div class="bs-callout">
    <div class="row">
      <div class="col-md-3">
        <%= f.input :fecha_clase, as: :string,
            input_html: { class: "datepicker clean", readonly: true },
            label: "Fecha Clase" %>
      </div>
      <div class="col-md-3">
        <%= f.input :tiposhorario_id, as: :select,
            collection: Tiposhorario.all.collect { |p| [p.descripcion, p.id] },
            include_blank: true,
            input_html: { class: "select2 clean" },
            label: "Horario" %>
      </div>
      <div class="col-md-3">
        <%= f.input :placa_id, as: :select,
            collection: Placa.all.collect { |p| [p.descripcion, p.id] },
            include_blank: true,
            input_html: { class: "select2 clean" },
            label: "Placa" %>
      </div>
      <div class="col-md-3">
        <%= f.input :instructor_id, as: :select,
            collection: Instructor.all.collect { |p| [p.nombre, p.id] },
            include_blank: true,
            input_html: { class: "select2 clean" },
            label: "Instructor" %>
      </div>
    </div>
    <div class="row" style="margin-top:10px;">
      <div class="col-md-6">
        <% if @personasclase.new_record? %>
          <%= button_tag t(:cancelar), type: 'button',
              onclick: "$('#personasclase_form').html('').removeClass('in').css({height:'0px',overflow:'hidden'}); return false;",
              class: 'btn btn-flat btn-default' %>
        <% else %>
          <%= link_to t(:cancelar),
              persona_personasclase_path(@persona, @personasclase),
              class: "btn btn-flat btn-default pull-left",
              remote: true %>
        <% end %>
      </div>
      <div class="col-md-6">
        <%= f.button :submit, t(:guardar), class: "btn btn-danger pull-right" %>
      </div>
    </div>
  </div>
<% end %>
<script>
  $(".select2").select2();
  $(".datepicker").datepicker({
    dayNamesMin: ["Dom","Lun","Mar","Mie","Jue","Vie","Sab"],
    monthNamesShort: ["Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dic"],
    dateFormat: "yy-mm-dd", yearRange: "2000:2030",
    changeMonth: true, changeYear: true
  });
</script>
