<div class="box box-primary">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-calendar"></i> PROGRAMACIÓN HORARIOS</h3>
    <div class="box-tools pull-right">
      <%= link_to horario_programacioneshorarios_path, class: 'btn btn-sm btn-default' do %>
        <i class="fa fa-arrow-left"></i> Regresar al Horario
      <% end %>
    </div>
  </div>
  <div class="box-body">

    <% if @error_message.present? %>
      <div class="alert alert-danger">
        <i class="fa fa-exclamation-triangle"></i>
        <strong><%= @error_message %></strong>
      </div>
    <% end %>

    <%= form_with model: @programacioneshorario,
          url: (@programacioneshorario.new_record? ? programacioneshorarios_path : programacioneshorario_path(@programacioneshorario)),
          method: (@programacioneshorario.new_record? ? :post : :patch),
          local: true do |f| %>

      <%= f.hidden_field :tiposhorario_id %>
      <%= f.hidden_field :placa_id %>

      <div class="row">
        <%# ── Info de solo lectura ── %>
        <div class="col-md-6">
          <table class="table table-condensed table-bordered" style="font-size:13px;">
            <tr>
              <td width="35%"><strong>Horario</strong></td>
              <td><%= @programacioneshorario.tiposhorario&.descripcion %></td>
            </tr>
            <tr>
              <td><strong>Placa</strong></td>
              <td><%= @programacioneshorario.placa&.descripcion %></td>
            </tr>
            <tr>
              <td><strong>Instructor</strong></td>
              <td><%= @programacioneshorario.placa&.instructor&.nombre %></td>
            </tr>
          </table>
        </div>

        <div class="col-md-6">
          <%# ── Campos editables ── %>
          <div class="form-group">
            <label>Usuario / Persona</label>
            <%= f.hidden_field :persona_id, id: 'persona_id_hidden' %>
            <select id="persona_select" class="form-control select2-ajax"
                    style="width:100%"
                    data-ajax-url="<%= listar_personas_path(format: :json) %>"
                    data-placeholder="Buscar por identificación o nombre...">
              <% if @programacioneshorario.persona.present? %>
                <option value="<%= @programacioneshorario.persona_id %>" selected>
                  <%= @programacioneshorario.persona.autobuscar %>
                </option>
              <% end %>
            </select>
          </div>

          <div class="form-group">
            <label>Fecha Inicial</label>
            <%= f.text_field :fecha_inicial,
                  class: 'form-control datepicker',
                  placeholder: 'YYYY-MM-DD',
                  value: @programacioneshorario.fecha_inicial,
                  autocomplete: 'off' %>
          </div>

          <div class="form-group">
            <label>Nro. de Clases</label>
            <%= f.text_field :nro_clases,
                  class: 'form-control solo-numeros',
                  inputmode: 'numeric',
                  size: 10 %>
          </div>

          <% if @programacioneshorario.fecha_final.present? %>
            <div class="form-group">
              <label>Fecha Final</label>
              <p class="form-control-static"><%= @programacioneshorario.fecha_final %></p>
            </div>
          <% end %>

          <div class="form-group">
            <label>Recoge</label>
            <%= f.select :recoje,
                  [['SI', 'S'], ['NO', 'N']],
                  { include_blank: true },
                  { class: 'form-control select2', style: 'width:120px' } %>
          </div>

          <div class="form-group">
            <label>Fecha y Hora Teoría</label>
            <%= f.text_field :fecha_teoria,
                  class: 'form-control datepicker',
                  placeholder: 'YYYY-MM-DD',
                  value: (@programacioneshorario.fecha_teoria&.strftime('%Y-%m-%d')),
                  autocomplete: 'off' %>
          </div>

          <div class="form-group">
            <label>Observaciones</label>
            <%= f.text_area :observacion,
                  class: 'form-control',
                  rows: 3,
                  onchange: 'this.value=this.value.toUpperCase();' %>
          </div>

          <div class="form-group">
            <label>Persona en Espera</label>
            <%= f.text_field :enespera,
                  class: 'form-control',
                  onchange: 'this.value=this.value.toUpperCase();' %>
          </div>

          <%= f.submit 'Guardar', class: 'btn btn-primary' %>
        </div>
      </div>

    <% end %>

    <%# ── Historial de clases dictadas ── %>
    <% if @programacioneshorario.persona_id.present? &&
          Personasclase.exists?(persona_id: @programacioneshorario.persona_id) %>
      <hr>
      <h4><i class="fa fa-graduation-cap"></i> Clases Dictadas</h4>
      <table class="table table-bordered table-condensed table-striped table-usuarios">
        <thead>
          <tr>
            <th class="text-center">#</th>
            <th>Usuario / Fecha</th>
            <th>Horario</th>
            <th>Placa</th>
            <th>Instructor</th>
            <th class="text-center">Fecha Clase</th>
          </tr>
        </thead>
        <tbody>
          <% Personasclase.where(persona_id: @programacioneshorario.persona_id).each_with_index do |pc, i| %>
            <tr>
              <td class="text-center"><%= i + 1 %></td>
              <td><small><%= pc.created_at&.strftime('%Y-%m-%d %X') %> - <%= pc.user&.username %></small></td>
              <td><%= pc.tiposhorario&.descripcion %></td>
              <td><%= pc.placa&.descripcion %></td>
              <td><%= pc.placa&.instructor&.nombre %></td>
              <td class="text-center"><%= pc.fecha_clase %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

  </div>
</div>

<script>
$(function() {
  // Select2 AJAX para búsqueda de personas
  $('#persona_select').select2({
    width: '100%',
    minimumInputLength: 2,
    ajax: {
      url: '<%= listar_personas_path(format: :json) %>',
      dataType: 'json',
      delay: 300,
      data: function(params) { return { search: params.term }; },
      processResults: function(data) {
        return { results: data.map(function(p) {
          return { id: p.id, text: p.autobuscar };
        })};
      }
    }
  }).on('select2:select', function(e) {
    $('#persona_id_hidden').val(e.params.data.id);
  });

  // Solo números
  document.querySelectorAll('.solo-numeros').forEach(function(input) {
    input.addEventListener('keypress', function(e) {
      if (!/[0-9]/.test(e.key)) e.preventDefault();
    });
    input.addEventListener('input', function() {
      this.value = this.value.replace(/[^0-9]/g, '');
    });
  });

  $('select.select2').select2({ width: '100%' });
});
</script>
