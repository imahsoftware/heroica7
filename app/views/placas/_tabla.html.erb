<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th width="12%">Placa</th>
        <th width="12%">Marca</th>
        <th width="10%">Línea</th>
        <th width="8%">Modelo</th>
        <th width="12%">Tipo Vehículo</th>
        <th width="8%" class="text-center">Estado</th>
        <th>Motor / Serie</th>
      </tr>
    </thead>
    <tbody id="tbody_placas">
      <% @placas.each do |placa| %>
        <%= render 'placas/tr', placa: placa %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="row" style="margin-top: 12px;">
  <div class="col-xs-12 text-right">
    <%= will_paginate @placas, renderer: BootstrapPagination::Rails %>
  </div>
</div>
