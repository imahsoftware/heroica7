<% title 'Placas' %>

<div class="box box-usuarios">
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-car"></i> Placas
      <span class="users-count-badge"><%= @placas.total_entries rescue @placas.count %> registros</span>
    </span>
    <div class="box-tools pull-right" style="margin-top: -2px;">
      <%= link_to new_placa_path, remote: true, id: 'new_placa_button',
          class: 'btn btn-sm btn-success',
          title: 'Agregar placa' do %>
        <i class="fa fa-plus"></i> Nueva
      <% end %>
    </div>
  </div>

  <div class="box-body">

    <!-- Barra de búsqueda -->
    <div class="row" style="margin-bottom: 16px;">
      <div class="col-md-5 col-sm-7 col-xs-12 search-bar">
        <%= search_form_for @q do |f| %>
          <div class="input-group">
            <%= f.search_field :descripcion_or_marca_or_linea_or_modelo_cont,
                class: 'form-control',
                placeholder: 'Buscar por placa, marca, línea o modelo...' %>
            <div class="input-group-btn">
              <%= button_tag type: "submit", class: "btn btn-search" do %>
                <i class="fa fa-search"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="flash_messages"></div>
    <div id="placa_form" class="collapse" style="margin-bottom: 12px;"></div>

    <div id="placas">
      <% if @placas.any? %>
        <%= render 'placas/tabla' %>
      <% else %>
        <div class="empty-state">
          <i class="fa fa-car"></i>
          <p>No se encontraron placas con los criterios de búsqueda.</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
