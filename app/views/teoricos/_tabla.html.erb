<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped">
    <thead>
      <tr>
        <th width="8%"  class="text-center">Acciones</th>
        <th width="25%">Fecha / Usuario</th>
        <th width="20%">Categoria</th>
        <th width="12%" class="text-center">Correctas</th>
        <th width="12%" class="text-center">Incorrectas</th>
        <th width="15%" class="text-center">Estado</th>
      </tr>
    </thead>
    <tbody id="tbody_teoricos">
      <% persona.teoricos.each do |t| %>
        <%= render "teoricos/tr", teorico: t, persona: persona %>
      <% end %>
    </tbody>
  </table>
</div>
