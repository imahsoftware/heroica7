<div class="box box-default color-palette-box">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-book"></i> Informacion Prueba Teorica</h3>
  </div>

  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="teorico_form" class="collapse"></div>

    <div id="teoricos">
      <% if persona.teoricos.exists? %>
        <%= render "teoricos/tabla", persona: persona, teorico: teorico %>
      <% else %>
        <div class="alert alert-warning">
          <h4><i class="icon fa fa-info"></i> Atencion</h4>
          No hay pruebas teoricas registradas para esta persona.
        </div>
      <% end %>
    </div>
  </div>
</div>
