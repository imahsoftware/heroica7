<div class="box box-usuarios">
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-book"></i> Prueba Teórica
      <span class="users-count-badge"><%= persona.teoricos.count %> registros</span>
    </span>
  </div>

  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="teorico_form" class="collapse" style="margin-bottom: 12px;"></div>

    <div id="teoricos">
      <% if persona.teoricos.exists? %>
        <%= render 'teoricos/tabla', persona: persona, teorico: teorico %>
      <% else %>
        <div class="empty-state">
          <i class="fa fa-book"></i>
          <p>No hay pruebas teóricas registradas para esta persona.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
