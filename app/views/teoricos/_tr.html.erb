<tr id="teorico_<%= teorico.id %>">
  <td class="text-center">
    <%= link_to informe_persona_teorico_path(persona, teorico),
        onclick: "window.open(this.href,'teorico_informe','height=700,width=950,scrollbars=yes,resizable=yes');return false;",
        class: "btn btn-xs btn-info",
        title: "Informe Prueba", data: { toggle: "tooltip" } do %>
      <i class="fa fa-file-text-o"></i>
    <% end %>
    <% if is_auth_e("teorico") %>
      <%= link_to persona_teorico_path(persona, teorico),
          remote: true, method: :delete,
          data: { confirm: "Seguro?", toggle: "tooltip" },
          title: "Eliminar" do %>
        <button class="btn btn-xs btn-danger btn-accion"><i class="fa fa-trash"></i></button>
      <% end %>
    <% end %>
  </td>
  <td>
    <small>
      <%= teorico.created_at.strftime("%Y-%m-%d %X") rescue nil %> -
      <%= teorico.user.username rescue nil %>
    </small>
  </td>
  <td><%= teorico.categoria.codigo_nuevo rescue teorico.categoria.nombre rescue nil %></td>
  <td class="text-center" style="color:#3c763d; font-weight:bold;"><%= teorico.correctas.to_i %></td>
  <td class="text-center" style="color:#a94442; font-weight:bold;"><%= teorico.incorrectas.to_i %></td>
  <td class="text-center">
    <span class="label label-<%= teorico.estado == "PENDIENTE" ? "warning" : "success" %>">
      <%= teorico.estado %>
    </span>
  </td>
</tr>
