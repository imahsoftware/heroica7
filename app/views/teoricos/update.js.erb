$(".alert_flash").fadeOut(300, function() { $(this).remove(); });

$("#teorico_<%= @teorico.id %>").replaceWith("<%= j render "tr", teorico: @teorico, persona: @persona %>");

$("[data-toggle=\"tooltip\"]").tooltip();
$(".flash_messages").html("<%= j render "layouts/flash_messages" %>");

setTimeout(function() {
  $(".alert_flash").fadeOut(300, function() { $(this).remove(); });
}, 5000);
