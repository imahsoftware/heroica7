<div class="box box-primary">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-book"></i> Busqueda Prueba Teorica</h3>
  </div>
  <div class="box-body">
    <%= form_tag teoricos_busqueda_path, method: :get, data: { turbo: false } do %>
      <div class="row">
        <div class="col-md-4">
          <div class="form-group">
            <label>Identificacion del estudiante</label>
            <%= text_field_tag :buscarident, params[:buscarident],
                class: "form-control", placeholder: "Numero de identificacion",
                required: true, autofocus: true %>
          </div>
        </div>
        <div class="col-md-2">
          <div class="form-group">
            <label>&nbsp;</label><br>
            <%= submit_tag "Buscar", name: nil, class: "btn btn-primary",
                data: { disable_with: "Buscando..." } %>
          </div>
        </div>
      </div>
    <% end %>
    <% if flash[:warninglogin] %>
      <div class="alert alert-warning"><%= flash[:warninglogin] %></div>
    <% end %>
  </div>
</div>
