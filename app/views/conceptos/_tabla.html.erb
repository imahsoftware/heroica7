<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th>Descripción</th>
        <th width="15%" class="text-right">Valor</th>
        <th width="20%">Última modificación</th>
      </tr>
    </thead>
    <tbody id="tbody_conceptos">
      <% @conceptos.each do |concepto| %>
        <%= render 'conceptos/tr', concepto: concepto %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="row" style="margin-top: 12px;">
  <div class="col-xs-12 text-right">
    <%= will_paginate @conceptos, renderer: BootstrapPagination::Rails %>
  </div>
</div>
