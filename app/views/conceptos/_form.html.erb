<%= simple_form_for @concepto, remote: true do |f| %>
  <div class="bs-callout">

    <p class="section-label">Datos del concepto</p>
    <div class="row">
      <div class="col-md-6">
        <%= f.input :descripcion, label: 'Descripción',
            input_html: { onChange: 'this.value=this.value.toUpperCase()', class: 'form-control input_uppercase' } %>
      </div>
      <div class="col-md-3">
        <%= f.input :valor, label: 'Valor',
            input_html: { class: 'form-control' } %>
      </div>
    </div>

    <div class="row" style="margin-top: 12px;">
      <div class="col-md-6">
        <% if @concepto.new_record? %>
          <%= button_tag t(:cancelar), type: 'button',
              data: { toggle: 'collapse', target: '#concepto_form' },
              class: 'cancel_button btn btn-flat btn-default' %>
        <% else %>
          <%= link_to t(:cancelar), concepto_path(@concepto),
              class: 'btn btn-flat btn-default', remote: true %>
        <% end %>
      </div>
      <div class="col-md-6 text-right">
        <%= f.button :submit, t(:guardar), class: 'btn-guardar' %>
      </div>
    </div>

  </div>
<% end %>
