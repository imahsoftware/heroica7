$("#mantenimiento_form").collapse("hide");
$("#mantenimiento_form").empty();
<% if flash[:notice] %>
  $(".flash_messages").html("<div class='alert alert-success alert-dismissible'><button type='button' class='close' data-dismiss='alert'>&times;</button><%= j flash[:notice] %></div>");
  <% flash.discard(:notice) %>
<% end %>
$("#mantenimiento_<%= @mantenimiento.id %>").replaceWith("<%= j render 'tr', mantenimiento: @mantenimiento %>");
$('[data-toggle="tooltip"]').tooltip();
