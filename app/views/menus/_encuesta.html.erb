<div class="box-body">
  <div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <div class="callout callout-warning">
        <h4 style="color: white">Hola, <%= current_user.nombre rescue nil %></h4>
        <p>En este mommento vas a proceder a realizar la encuesta de selelcción multilpe. Por favor, tome un momento
          para
          responder a las preguntas cuidadosamente. ¡Gracias por su tiempo y por su valiosa
          contribución!".</p>
      </div>
    </div>
  </div>
  <%= form_tag '/personasforencuestas/update_individual', method: 'put' do %>
    <div class="table-responsive">
      <legend> <%= @encuesta.descripcion rescue nil %></legend>
      <table class="table table-bordered table-condensed table-striped  table-hover">
        <thead class="thcolor">
        <tr>
          <th width="2%" class="text-center text-table" rowspan="2">#</th>
          <th class="text-left text-table" rowspan="2">Pregunta</th>
          <th width="13%" class="text-center text-table">Imagen</th>
          <th width="1%" class="text-center text-table" style="background-color: #f4f4f4"></th>
          <th width="40%" class="text-center text-table">Respuesta</th>
        </tr>
        </thead>
        <% cnt = 0
           for personasforencuesta in Personasforencuesta.where("personastramite_id = #{@encuestasprueba.personastramite_id} and encuesta_id = #{@encuesta.id}").order("id asc") %>
          <tbody>
          <%= fields_for "personasforencuestas[]", personasforencuesta do |f| %>
            <%= hidden_field_tag :encuestasprueba_id, params[:encuestasprueba_id], value: @encuestasprueba.id %>
            <tr>
              <td class="text-center text-table">
                <%= cnt += 1 %>
              </td>
              <td class="text-table"><%= Encuestaspregunta.find(personasforencuesta.encuestaspregunta_id).pregunta.html_safe rescue nil %></td>
              <td class="text-table">
                <% if personasforencuesta.encuestaspregunta.imagen_file_name.present? %>
                  <%= image_tag personasforencuesta.encuestaspregunta.imagen.url(:little), alt: "User profile picture", class: "profile-user-img img-responsive" %>
                <% end %>
              </td>
              <td></td>
              <td class="text-table">
                <table class="table table-bordered table-condensed">
                  <% select_opcion(personasforencuesta.encuestaspregunta_id).each do |opcion| %>
                    <tr>
                      <td width="60%">
                        <%= f.radio_button :encuestaspreopcion_id, opcion[1], class: "form-check-input" %>
                        <%= f.label :encuestaspreopcion_id, opcion[0], class: "form-check-label mr-3" %>
                      </td>
                      <td width="40%">
                        <% opcionImagen = Encuestaspreopcion.find(opcion[1].to_i) %>
                        <% if opcionImagen.imagen_file_name.present? %>
                          <%= image_tag opcionImagen.imagen.url(:little), alt: "User profile picture", class: "profile-user-img img-responsive" %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </table>
              </td>

            </tr>
          <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
    <div class="box-tools pull-right">
      <%= submit_tag "Guardar", :disable_with => "Guardando...", :class => "btn btn-sm btn-danger" %>
    </div>
  <% end %>
  <% if !Personasforencuesta.where("personastramite_id = #{@encuestasprueba.personastramite_id} and encuesta_id = #{@encuesta.id} and encuestaspreopcion_id is null").present? %>
    <%= link_to finalizar_personasforencuestas_path(encuestasprueba_id: @encuestasprueba.id), data: { confirm: "Estas Seguro de Enviar tu encuesta?" } do %>
      <button class="btn btn-sm btn-success"><i class="fa fa-checkk"></i> Finalizar Encuesta</button>
    <% end %>
  <% end %>
</div>

<script type="text/javascript" charset="utf-8">
    $(".select2").select2();
</script>


<style>
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        text-align: left;
    }
</style>