<% if @is_auth_c_practica %>
  <% if @personasevapracticas.any? %>
    <div class="box box-danger">
      <div class="box-body">
        <legend>Evaluaciones Practicas Pendientes (<%= @personasevapracticas.count rescue 0 %>)</legend>
        <div class="table-responsive">
          <table class="table table-bordered table-condensed table-striped">
            <thead>
            <tr class="thcolor">
              <th width="2%" class="text-center">Opciones</th>
              <th width="40%" class="text-center">Identificación - Nombre</th>
              <th width="15%" class="text-center">Categoria</th>
            </tr>
            </thead>
            <tbody>
            <% @personasevapracticas.order(created_at: :desc).each do |t| %>
              <tr>
                <td>
                  <%= link_to edit_personasevapractica_path(id: t.id,), data: { toggle: 'tooltip', :"data-turbolinks" => true, title: "Editar" } do %>
                    <button class="btn btn-xs btn-warning text-center"><i class="fa fa-edit" aria-hidden="true"></i>
                    </button>
                  <% end %>
                  <td class="text-left"><%= t.persona.autobuscar rescue nil %></td>
                  <td class="text-center"><%= t.categoria.codigo_nuevo rescue nil %></td>
                  </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
<% if is_auth_c('registroplaca') %>
  <div class="box box-danger">
    <div class="box-body">
      <table class="table table-bordered">
        <thead>
        <tr class="thcolor">
          <th width="10%"></th>
          <th>Fecha</th>
        </tr>
        </thead>
        <tbody id="placas-tbody">
        <% Placasregistro.select("fecha").where("DATE_FORMAT(FECHA,'%Y-%m-%d') = DATE_FORMAT(now(),'%Y-%m-%d')").distinct.order(fecha: :desc).each do |placa| %>
          <tr>
            <td class="text-center">
              <%= link_to edit_individual_placasregistros_path(fecha: placa.fecha), class: 'edit_persona_button', data: { toggle: 'tooltip', :"data-turbolinks" => true }, title: "#{t :title_editar}" do %>
                <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
              <% end %>
            </td>
            <td><%= h placa.fecha %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
<% if @is_auth_c_agendainstuctor %>
  <%= render 'agenda' %>
<% end %>
<% if @is_auth_c_agendateorica %>
  <%= render 'agendateorica' %>
<% end %>
<% if @is_auth_c_programaexamenteo %>
  <%= render 'programaexamenteo' %>
<% end %>

