  <div class="box box-danger">
    <div class="box-body">
      <legend>Agenda Teórica </legend>
      <% if @agendas.count.to_i > 0 %>
        <table class="table table-bordered table-condensed table-striped">
          <thead>
          <tr class="thcolor">
            <th></th>
            <th width="10%" class="text-left">Salon</th>
            <th class="text-left">Materia</th>
            <th class="text-center">Capacidad</th>
            <th class="text-center">Disponibles</th>
            <th class="text-center">Fecha</th>
            <th class="text-center">Inicio</th>
            <th class="text-center">Fin</th>
          </tr>
          </thead>
          <tbody>
          <% @agendas.each do |agenda|
              @agenda = agenda
          %>
            <tr>
              <td rowspan="2" align="center">
                <a href="javascript:void(0);" onclick="SINO('agenda_<%=agenda.id%>')" style="font-size: 11px; font-family: Tahoma; color: red;">VER</a>
              </td>
              <td style="font-size: 11px;"><%=agenda.teoricossalon.descripcion rescue nil %></td>
              <td style="font-size: 11px;"><%=agenda.teoricosmateria.nombrelista rescue nil %></td>
              <td style="font-size: 11px;" class="text-center"><%=agenda.capacidad rescue nil %></td>
              <td style="font-size: 11px;" class="text-center"><%=agenda.disponible rescue nil %></td>
              <td style="font-size: 11px;" class="text-center"><%=agenda.fecha rescue nil %></td>
              <td style="font-size: 11px;" class="text-center"><%=agenda.horainicio rescue nil %></td>
              <td style="font-size: 11px;" class="text-center"><%=agenda.horafin rescue nil %></td>
            </tr>
            <tr>
              <td colspan="7">
                <div id="agenda_<%= agenda.id %>" style="display:none;">
                  <% if @agenda.agendaspersonas.any? %>
                    <%= render 'agendaspersonas/tabla3' %>
                  <% else %>
                    <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="alert alert-danger"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
      <%end %>
    </div>
  </div>


