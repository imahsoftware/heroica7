<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th width="10%" class="text-center">Id</th>
        <th>Descripción</th>
        <th width="20%" class="text-right">Valor</th>
      </tr>
    </thead>
    <tbody id="tbody_tiposviajes">
      <% @tiposviajes.each do |tiposviaje| %>
        <%= render 'tiposviajes/tr', tiposviaje: tiposviaje %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="row" style="margin-top: 12px;">
  <div class="col-xs-12 text-right">
    <%= will_paginate @tiposviajes, renderer: BootstrapPagination::Rails %>
  </div>
</div>
