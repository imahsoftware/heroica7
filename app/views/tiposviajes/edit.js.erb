$("#tiposviaje_form").collapse("hide");
$("#tiposviaje_form").empty();

<% if @active_record.present? %>
  $("#tiposviaje_<%= @active_record.id %>").replaceWith("<%= j render 'tr', tiposviaje: @active_record %>");
<% end %>

$("#tiposviaje_<%= @tiposviaje.id %>").html("<td colspan='4'><%= j render 'form' %></td>");
$("#tiposviaje_<%= @tiposviaje.id %>").addClass("active_tiposviaje");

$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
