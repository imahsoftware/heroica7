<% title 'Objetos' %>

<div class="box box-usuarios">
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-shield-alt"></i> Objetos
      <span class="users-count-badge"><%= @objetos.total_entries rescue @objetos.count %> registros</span>
    </span>
    <div class="box-tools pull-right" style="margin-top: -2px;">
      <%= link_to new_objeto_path, remote: true, id: 'new_objeto_button',
          class: 'btn btn-sm btn-success',
          title: 'Agregar objeto' do %>
        <i class="fa fa-plus"></i> Nuevo
      <% end %>
    </div>
  </div>

  <div class="box-body">

    <!-- Barra de búsqueda -->
    <div class="row" style="margin-bottom: 16px;">
      <div class="col-md-5 col-sm-7 col-xs-12 search-bar">
        <%= search_form_for @q do |f| %>
          <div class="input-group">
            <%= f.search_field :descripcion_or_descripcion_ampliada_cont,
                class: 'form-control',
                placeholder: 'Buscar por descripción...' %>
            <div class="input-group-btn">
              <%= button_tag type: "submit", class: "btn btn-search" do %>
                <i class="fa fa-search"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="flash_messages"></div>
    <div id="objeto_form" class="collapse" style="margin-bottom: 12px;"></div>

    <div id="objetos">
      <% if @objetos.any? %>
        <%= render 'objetos/tabla' %>
      <% else %>
        <div class="empty-state">
          <i class="fa fa-shield-alt"></i>
          <p>No se encontraron objetos con los criterios de búsqueda.</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
