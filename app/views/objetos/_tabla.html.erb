<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th width="25%">Descripción</th>
        <th>Descripción Ampliada</th>
      </tr>
    </thead>
    <tbody id="tbody_objetos">
      <% @objetos.each do |objeto| %>
        <%= render 'objetos/tr', objeto: objeto %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="row" style="margin-top: 12px;">
  <div class="col-xs-12 text-right">
    <%= will_paginate @objetos, renderer: BootstrapPagination::Rails %>
  </div>
</div>
