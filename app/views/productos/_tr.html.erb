<tr id="producto_<%= producto.id %>">
  <td class="text-center">
    <%= link_to edit_producto_path(producto), remote: true,
        class: 'edit_producto_button',
        title: t(:title_editar),
        data: { toggle: 'tooltip' } do %>
      <button class="btn btn-xs btn-warning btn-accion"><i class="fa fa-edit"></i></button>
    <% end %>
    <%= link_to producto_path(producto), remote: true,
        method: :delete,
        title: t(:title_elimina),
        data: { confirm: t(:elimina_confirma), toggle: 'tooltip' } do %>
      <button class="btn btn-xs btn-danger btn-accion"><i class="fa fa-trash"></i></button>
    <% end %>
  </td>
  <td><%= producto.descripcion %></td>
  <td style="font-size: 11px; color: #64748b;"><%= producto.user.try(:username) %></td>
  <td style="font-size: 11px; color: #64748b;"><%= producto.created_at.strftime('%Y-%m-%d %H:%M') rescue '—' %></td>
</tr>
