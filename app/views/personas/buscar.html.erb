<div class="box box-usuarios">
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-users"></i> Resultados de Búsqueda
    </span>
    <div class="box-tools pull-right">
      <%= link_to busqueda_personas_path, class: 'btn btn-sm btn-default' do %>
        <i class="fa fa-arrow-left"></i> Volver
      <% end %>
    </div>
  </div>

  <div class="box-body">
    <div class="table-responsive">
      <table class="table table-bordered table-condensed table-striped">
        <thead>
          <tr>
            <th width="20%">Identificación</th>
            <th width="60%">Nombre</th>
            <th width="20%" class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @personas.each do |persona| %>
            <tr>
              <td><%= persona.identificacion %></td>
              <td>
                <%= [persona.primer_nombre, persona.segundo_nombre,
                     persona.primer_apellido, persona.segundo_apellido]
                      .compact.reject(&:blank?).join(' ') %>
              </td>
              <td class="text-center">
                <%= link_to edit_persona_path(persona, etapa: 'A'), class: 'btn btn-xs btn-warning',
                    title: 'Editar' do %>
                  <i class="fa fa-edit"></i> Editar
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="row">
      <div class="col-xs-12 col-sm-6">
        <span class="badge"><%= @total_personas %></span> registros encontrados
        &nbsp;|&nbsp; Página <%= @personas.current_page %> de <%= @personas.total_pages %>
      </div>
      <div class="col-xs-12 col-sm-6 text-right">
        <%= will_paginate @personas,
              renderer:          'BootstrapPagination::Rails',
              previous_label:    '&laquo; Anterior'.html_safe,
              next_label:        'Siguiente &raquo;'.html_safe,
              inner_window:      2,
              outer_window:      1,
              params:            { buscarident: params[:buscarident],
                                   buscarnombre: params[:buscarnombre] } %>
      </div>
    </div>
  </div>
</div>
