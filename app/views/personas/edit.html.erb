<% if @etapa.to_s == 'A' %>
  <%= render 'form', persona: @persona %>
<% elsif !@persona.new_record? %>
  <% if @etapa.to_s == 'B' %>
    <%= render 'personastramites/personastramites',
          persona: @persona,
          personastramite: @personastramite %>
  <% elsif @etapa.to_s == 'C' %>
    <%= render 'personasclases/personasclases',
          persona: @persona,
          personasclase: @personasclase %>
  <% elsif @etapa.to_s == 'D' %>
    <%= render 'teoricos/teoricos',
          persona: @persona,
          teorico: @teorico %>
  <% else %>
    <%= render 'form', persona: @persona %>
  <% end %>
<% else %>
  <%= render 'form', persona: @persona %>
<% end %>
