<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th width="12%">Consecutivo</th>
        <th width="12%">Fecha Orden</th>
        <th>Proveedor</th>
        <th width="20%">Última modificación</th>
      </tr>
    </thead>
    <tbody id="tbody_compras">
      <% @compras.each do |compra| %>
        <%= render 'compras/tr', compra: compra %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="row" style="margin-top: 12px;">
  <div class="col-xs-12 text-right">
    <%= will_paginate @compras, renderer: BootstrapPagination::Rails %>
  </div>
</div>
