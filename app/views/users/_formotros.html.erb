<%= simple_form_for(@user) do |f| %>
  <div class="row">
    <div class="col-md-12">
      <div class="box box-usuarios user-form-box <%= @user.new_record? ? 'user-form-box--new' : 'user-form-box--edit' %>">

        <% if @user.new_record? %>
          <div class="box-form-header">
            <span class="box-title">
              <i class="fa fa-user-plus"></i> Nuevo Usuario
            </span>
            <div class="pull-right user-form-header-actions">
              <%= link_to users_path, class: 'btn btn-xs btn-default', title: 'Volver al listado' do %>
                <i class="fa fa-arrow-left"></i> Volver
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="box-body user-form-body">
          <% if @user.errors.any? %>
            <div class="alert alert-danger user-form-errors">
              <ul>
                <% @user.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <p class="section-label">Identificación y contacto</p>
          <div class="row">
            <div class="col-md-2 col-sm-4">
              <%= f.input :identificacion,
                  label: 'Identificación',
                  required: false,
                  input_html: { class: 'form-control' } %>
            </div>
            <div class="col-md-5 col-sm-8">
              <%= f.input :nombre,
                  label: 'Nombre completo',
                  input_html: { onChange: 'this.value=this.value.toUpperCase()', class: 'form-control input_uppercase' } %>
            </div>
            <div class="col-md-2 col-sm-4">
              <%= f.input :username,
                  label: 'Usuario',
                  input_html: { class: 'form-control', autocomplete: 'off' } %>
            </div>
            <div class="col-md-3 col-sm-8">
              <%= f.input :email,
                  label: 'Correo electrónico',
                  input_html: { class: 'form-control' } %>
            </div>
          </div>

          <div class="row">
            <div class="col-md-2 col-sm-4">
              <%= f.input :extension,
                  label: 'Nro. Licencia / Extensión',
                  input_html: { class: 'form-control' } %>
            </div>
            <div class="col-md-4 col-sm-6">
              <%= f.input :portafolio_id,
                  as: :select,
                  label: 'Compañía',
                  collection: Portafolio.order(:nombre).collect { |p| [p.nombre, p.id] },
                  include_blank: 'Seleccionar',
                  input_html: { class: 'select2 form-control' } %>
            </div>
            <div class="col-md-2 col-sm-4">
              <%= f.input :activo,
                  as: :select,
                  label: 'Activo',
                  collection: select_sinocorto,
                  input_html: { class: 'select2 form-control' } %>
            </div>
            <div class="col-md-4 col-sm-12">
              <%= f.input :observaciones,
                  label: 'Observaciones',
                  input_html: { class: 'form-control' } %>
            </div>
          </div>

          <p class="section-label">Contraseña</p>
          <div class="row">
            <div class="col-md-4 col-sm-6">
              <%= f.input :password,
                  label: 'Contraseña',
                  required: false,
                  input_html: { class: 'form-control', autocomplete: 'new-password' },
                  hint: @user.new_record? ? 'Opcional. Si se deja vacía se asignará clave temporal.' : 'Dejar en blanco para no cambiar' %>
            </div>
            <div class="col-md-4 col-sm-6">
              <%= f.input :password_confirmation,
                  label: 'Confirmar Contraseña',
                  required: false,
                  input_html: { class: 'form-control', autocomplete: 'new-password' } %>
            </div>
          </div>

        </div>

        <div class="box-footer user-form-footer">
          <div class="pull-right">
            <%= link_to users_path, class: 'btn btn-default user-form-cancel' do %>
              <i class="fa fa-times"></i> Cancelar
            <% end %>
            <%= f.button :submit, class: 'btn-guardar' do %>
              <i class="fa fa-save"></i> Guardar
            <% end %>
          </div>
        </div>

      </div>
    </div>
  </div>
<% end %>
