<%= simple_form_for(@user) do |f| %>
  <div class="row">
    <div class="col-md-12">
      <div class="box" style="border-top: none; border-radius: 6px; box-shadow: 0 2px 12px rgba(0,0,0,0.08);">

        <!-- Header -->
        <div class="box-form-header">
          <span class="box-title">
            <i class="fa fa-<%= @user.new_record? ? 'user-plus' : 'user-edit' %>"></i>
            <%= @user.new_record? ? 'Nuevo Usuario' : "Editando: #{@user.nombre}" %>
          </span>
          <div class="pull-right" style="margin-top: -2px;">
            <%= link_to users_path, class: 'btn btn-xs btn-default', title: 'Volver al listado' do %>
              <i class="fa fa-arrow-left"></i> Volver
            <% end %>
            <%= link_to new_user_path, class: 'btn btn-xs btn-success', title: 'Nuevo usuario' do %>
              <i class="fa fa-plus"></i> Nuevo
            <% end %>
          </div>
        </div>

        <div class="box-body">

          <!-- Fila 1: Identificación, Nombre, Usuario, Correo, Activo -->
          <div class="row">
            <div class="col-md-2">
              <%= f.input :identificacion,
                  label: 'Identificación',
                  required: false,
                  input_html: { class: 'form-control' } %>
            </div>
            <div class="col-md-4">
              <%= f.input :nombre,
                  label: 'Nombre completo',
                  input_html: { onChange: 'this.value=this.value.toUpperCase()', class: 'form-control input_uppercase' } %>
            </div>
            <div class="col-md-2">
              <%= f.input :username,
                  label: 'Usuario',
                  input_html: { class: 'form-control', autocomplete: 'off' } %>
            </div>
            <div class="col-md-3">
              <%= f.input :email,
                  label: 'Correo electrónico',
                  input_html: { class: 'form-control' } %>
            </div>
            <div class="col-md-1">
              <%= f.input :activo,
                  as: :select,
                  label: 'Activo',
                  collection: select_sinocorto,
                  input_html: { class: 'select2 form-control' } %>
            </div>
          </div>

          <!-- Fila 2: Extensión, Compañía, Observaciones -->
          <div class="row">
            <div class="col-md-2">
              <%= f.input :extension,
                  label: 'Nro. Licencia / Extensión',
                  input_html: { class: 'form-control' } %>
            </div>
            <div class="col-md-4">
              <%= f.input :portafolio_id,
                  as: :select,
                  label: 'Compañía',
                  collection: Portafolio.order(:nombre).collect { |p| [p.nombre, p.id] },
                  include_blank: 'Seleccionar',
                  input_html: { class: 'select2 form-control' } %>
            </div>
            <div class="col-md-4">
              <%= f.input :observaciones,
                  label: 'Observaciones',
                  input_html: { class: 'form-control' } %>
            </div>
          </div>

          <!-- Fila 3: Contraseña (solo si es nuevo o quiere cambiarla) -->
          <p class="section-label">Contraseña</p>
          <div class="row">
            <div class="col-md-3">
              <%= f.input :password,
                  label: 'Contraseña',
                  required: @user.new_record?,
                  input_html: { class: 'form-control', autocomplete: 'new-password' },
                  hint: @user.new_record? ? nil : 'Dejar en blanco para no cambiar' %>
            </div>
            <div class="col-md-3">
              <%= f.input :password_confirmation,
                  label: 'Confirmar Contraseña',
                  required: @user.new_record?,
                  input_html: { class: 'form-control', autocomplete: 'new-password' } %>
            </div>
          </div>

        </div><!-- /.box-body -->

        <!-- Footer -->
        <div class="box-footer">
          <div class="pull-right">
            <%= link_to users_path, class: 'btn btn-default', style: 'margin-right: 8px;' do %>
              <i class="fa fa-times"></i> Cancelar
            <% end %>
            <%= f.button :submit, class: 'btn-guardar' do %>
              <i class="fa fa-save"></i> Guardar
            <% end %>
          </div>
        </div>

      </div><!-- /.box -->
    </div>
  </div>
<% end %>


