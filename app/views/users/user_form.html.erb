<% title @user.new_record? ? 'Nuevo Usuario' : @user.nombre %>
<% if @user.etapa.to_s == "A" %>
  <div class="user-edit-shell">
    <%= render 'users/user_header' unless @user.new_record? %>
    <% if is_sygma %>
      <%= render partial: "form", locals: {user: @user} %>
    <% else %>
      <%= render partial: "formotros", locals: {user: @user} %>
    <% end %>
  </div>
<% elsif @user.etapa.to_s == "H" %>
  <%= render 'users/user_header' %>
  <%= render 'usersportafolios/usersportafolios' %>
<% elsif @user.etapa.to_s == "G" %>
  <%= render 'users/user_header' %>
  <%= render 'userssucursales/userssucursales' %>
<% elsif @user.etapa.to_s == "B" %>
  <%= render 'users/user_header' %>
  <% unless @user.new_record? %>
    <div class="box box-usuarios">
      <div class="box-header">
        <span class="box-title">
          <i class="fa fa-cubes"></i> Módulos Asociados
        </span>
        <div class="box-tools pull-right" style="margin-top: -2px;">
          <%= link_to new_user_usersmodulo_path(@user), remote: true, id: 'new_usersmodulo_button', class: 'btn btn-sm btn-success' do %>
            <i class="fa fa-plus"></i> <%= t :agregar %>
          <% end %>
        </div>
      </div>
      <div class="box-body">
        <div class="flash_messages"></div>
        <div id="usersmodulo_form" class="collapse" style="margin-bottom: 12px;"></div>
        <div id="usersmodulos">
          <% if @usersmodulos.any? %>
            <%= render 'usersmodulos/tabla' %>
          <% else %>
            <div class="empty-state">
              <i class="fa fa-cubes"></i>
              <p>No hay módulos asignados a este usuario.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% elsif @user.etapa.to_s == "C" %>
  <%= render 'users/user_header' %>
  <%= render 'userspermisos/userspermisos' %>
<% elsif @user.etapa.to_s == "I" %>
  <%= render 'users/user_header' %>
  <%= render 'usersreportes/usersreportes' %>
<% elsif @user.etapa.to_s == "E" %>
  <%= render 'users/user_header' %>
  <div class="box box-usuarios">
    <div class="box-body">
      <div class="row">
        <div class="col-xs-12">
          <%= render 'usersimagenes/usersimagenes' %>
        </div>
      </div>
    </div>
  </div>
<% end %>
