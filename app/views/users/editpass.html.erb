<% content_for :title, 'Cambiar contraseña' %>

<div class="card-header-text">
  <h2>Cambiar contraseña</h2>
  <p>Debes actualizar tu contraseña antes de ingresar al sistema</p>
</div>

<% if flash[:alert].present? %>
  <div class="alert-box alert-danger">
    <i class="fa-solid fa-circle-exclamation"></i>
    <span><%= flash[:alert] %></span>
  </div>
<% end %>

<% if flash[:notice].present? %>
  <div class="alert-box alert-notice">
    <i class="fa-solid fa-circle-check"></i>
    <span><%= flash[:notice] %></span>
  </div>
<% end %>

<div class="user-info">
  <div><strong>Usuario:</strong> <%= @user.username %></div>
  <div><strong>Nombre:</strong> <%= @user.nombre %></div>
</div>

<%= form_for @user, url: updatepass_user_path(@user), method: :patch do |f| %>
  <div class="form-group">
    <label for="user_password">Nueva contraseña</label>
    <div class="input-wrapper">
      <%= f.password_field :password,
          autofocus: true,
          autocomplete: 'new-password',
          class: 'form-control',
          placeholder: 'Nueva contraseña',
          id: 'user_password' %>
      <i class="fa-solid fa-lock input-icon"></i>
      <button type="button" class="toggle-password" onclick="togglePwd('user_password','toggle-icon-1')" aria-label="Mostrar contraseña">
        <i class="fa-solid fa-eye" id="toggle-icon-1"></i>
      </button>
    </div>
    <% @user.errors[:password].each do |msg| %>
      <div class="field-error"><%= msg %></div>
    <% end %>
  </div>

  <div class="form-group">
    <label for="user_password_confirmation">Confirmar contraseña</label>
    <div class="input-wrapper">
      <%= f.password_field :password_confirmation,
          autocomplete: 'new-password',
          class: 'form-control',
          placeholder: 'Confirmar contraseña',
          id: 'user_password_confirmation' %>
      <i class="fa-solid fa-lock input-icon"></i>
      <button type="button" class="toggle-password" onclick="togglePwd('user_password_confirmation','toggle-icon-2')" aria-label="Mostrar contraseña">
        <i class="fa-solid fa-eye" id="toggle-icon-2"></i>
      </button>
    </div>
    <% @user.errors[:password_confirmation].each do |msg| %>
      <div class="field-error"><%= msg %></div>
    <% end %>
  </div>

  <%= f.submit 'Guardar contraseña', class: 'btn-login' %>
<% end %>

<div class="card-footer-text">
  IMAH &nbsp;·&nbsp; <%= Time.now.year %>
</div>

<script>
  function togglePwd(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon  = document.getElementById(iconId);
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
  }
</script>
