<%= simple_form_for(@user) do |f| %>
  <div class="row">
    <div class="col-md-12">
      <div class="box" style="border-top: none; border-radius: 6px; box-shadow: 0 2px 12px rgba(0,0,0,0.08);">

        <!-- Header -->
        <div class="box-form-header">
          <span class="box-title">
            <i class="fa fa-<%= @user.new_record? ? 'user-plus' : 'user-edit' %>"></i>
            <%= @user.new_record? ? 'Nuevo Usuario' : "Editando: #{@user.nombre}" %>
          </span>
          <div class="pull-right" style="margin-top: -2px;">
            <% if @user.unlock_token %>
              <%= link_to desbloquearusuario_users_path(id: @user.id), data: { confirm: '¿Está seguro?' }, title: 'Desbloquear usuario' do %>
                <button type="button" class="btn btn-xs btn-info"><i class="fa fa-unlock"></i> Desbloquear</button>
              <% end %>
            <% end %>
            <% if is_sygma && !@user.new_record? %>
              <%= link_to resetpass_users_path(id: @user.id), data: { confirm: '¿Está seguro?' }, title: 'Restablecer clave' do %>
                <button type="button" class="btn btn-xs btn-warning"><i class="fa fa-key"></i> Reset Clave</button>
              <% end %>
            <% end %>
            <%= link_to users_path, class: 'btn btn-xs btn-default', title: 'Volver al listado' do %>
              <i class="fa fa-arrow-left"></i> Volver
            <% end %>
            <%= link_to new_user_path, class: 'btn btn-xs btn-success', title: 'Nuevo usuario' do %>
              <i class="fa fa-plus"></i> Nuevo
            <% end %>
          </div>
        </div>

        <!-- Tabs -->
        <div class="box-body" style="padding-top: 0;">
          <ul class="nav nav-tabs nav-tabs-form" style="margin-bottom: 0; margin-top: 12px;">
            <li class="active"><a href="#tab-datos" data-toggle="tab"><i class="fa fa-id-card"></i> Datos Personales</a></li>
            <li><a href="#tab-acceso" data-toggle="tab"><i class="fa fa-lock"></i> Acceso</a></li>
            <li><a href="#tab-nomina" data-toggle="tab"><i class="fa fa-money-bill"></i> Nómina</a></li>
            <li><a href="#tab-foto" data-toggle="tab"><i class="fa fa-camera"></i> Foto</a></li>
          </ul>

          <div class="tab-content" style="padding: 16px 4px 8px;">

            <!-- ── Tab: Datos Personales ── -->
            <div class="tab-pane active" id="tab-datos">
              <p class="section-label">Identificación y contacto</p>
              <div class="row">
                <div class="col-md-2">
                  <%= f.input :identificacion, label: 'Identificación',
                      input_html: { class: 'form-control' } %>
                </div>
                <div class="col-md-3">
                  <%= f.input :nombre, label: 'Nombre completo',
                      input_html: { onChange: 'this.value=this.value.toUpperCase()', class: 'form-control input_uppercase' } %>
                </div>
                <div class="col-md-2">
                  <%= f.input :username, label: 'Usuario',
                      input_html: { class: 'form-control', autocomplete: 'off' } %>
                </div>
                <div class="col-md-3">
                  <%= f.input :email, label: 'Correo electrónico',
                      input_html: { class: 'form-control' } %>
                </div>
                <div class="col-md-1">
                  <%= f.input :activo, as: :select, label: 'Activo',
                      collection: select_sinocorto,
                      input_html: { class: 'select2 form-control' } %>
                </div>
                <div class="col-md-1">
                  <%= f.input :genero, as: :select, label: 'Género',
                      collection: [['M','M'],['F','F'],['O','O']],
                      include_blank: '-',
                      input_html: { class: 'select2 form-control' } %>
                </div>
              </div>
              <div class="row">
                <div class="col-md-2">
                  <%= f.input :celular, label: 'Celular',
                      input_html: { class: 'form-control' } %>
                </div>
                <div class="col-md-2">
                  <%= f.input :telefonos, label: 'Teléfono',
                      input_html: { class: 'form-control' } %>
                </div>
                <div class="col-md-3">
                  <%= f.input :direccion, label: 'Dirección',
                      input_html: { onChange: 'this.value=this.value.toUpperCase()', class: 'form-control input_uppercase' } %>
                </div>
                <div class="col-md-2">
                  <%= f.input :fecha_nacimiento, as: :date_picker, label: 'Fecha nacimiento',
                      input_html: { class: 'form-control' } %>
                </div>
                <div class="col-md-3">
                  <%= f.input :extension, label: 'Nro. Licencia / Extensión',
                      input_html: { class: 'form-control' } %>
                </div>
              </div>

              <p class="section-label">Asignación</p>
              <div class="row">
                <div class="col-md-3">
                  <%= f.input :portafolio_id, as: :select, label: 'Compañía',
                      collection: Portafolio.order(:nombre).collect { |p| [p.nombre, p.id] },
                      include_blank: 'Seleccionar',
                      input_html: { class: 'select2 form-control' } %>
                </div>
                <div class="col-md-2">
                  <%= f.input :tipoconsulta, as: :select, label: 'Tipo Consulta',
                      collection: select_tipoconsulta,
                      include_blank: 'Seleccionar',
                      input_html: { class: 'select2 form-control' } %>
                </div>
                <div class="col-md-2">
                  <%= f.input :tipoconsulta2, as: :select, label: 'Tipo Consulta 2',
                      collection: select_tipoconsulta,
                      include_blank: 'Seleccionar',
                      input_html: { class: 'select2 form-control' } %>
                </div>
                <div class="col-md-2">
                  <%= f.input :geintac, as: :select, label: 'Acceso Global',
                      collection: select_sinocorto,
                      input_html: { class: 'select2 form-control' } %>
                </div>
                <div class="col-md-3">
                  <%= f.input :observaciones, label: 'Observaciones',
                      input_html: { class: 'form-control' } %>
                </div>
              </div>
            </div>

            <!-- ── Tab: Acceso ── -->
            <div class="tab-pane" id="tab-acceso">
              <p class="section-label">Contraseña</p>
              <div class="row">
                <div class="col-md-3">
                  <%= f.input :password, label: 'Nueva Contraseña',
                      input_html: { class: 'form-control', autocomplete: 'new-password' },
                      hint: @user.new_record? ? nil : 'Dejar en blanco para no cambiar' %>
                </div>
                <div class="col-md-3">
                  <%= f.input :password_confirmation, label: 'Confirmar Contraseña',
                      input_html: { class: 'form-control', autocomplete: 'new-password' } %>
                </div>
              </div>

              <p class="section-label">Configuración de sesión</p>
              <div class="row">
                <div class="col-md-2">
                  <%= f.input :directivo, as: :select, label: 'Directivo',
                      collection: select_sinocorto,
                      input_html: { class: 'select2 form-control' } %>
                </div>
                <div class="col-md-2">
                  <%= f.input :dashboard, label: 'Dashboard',
                      input_html: { class: 'form-control' } %>
                </div>
              </div>

              <% unless @user.new_record? %>
                <p class="section-label">Información de sesión (solo lectura)</p>
                <div class="row">
                  <div class="col-md-3">
                    <div class="form-group">
                      <label class="control-label">Último acceso</label>
                      <p class="form-control-static"><%= @user.last_sign_in_at&.strftime('%d/%m/%Y %H:%M') || '—' %></p>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="form-group">
                      <label class="control-label">IP último acceso</label>
                      <p class="form-control-static"><%= @user.last_sign_in_ip || '—' %></p>
                    </div>
                  </div>
                  <div class="col-md-2">
                    <div class="form-group">
                      <label class="control-label">Nro. de accesos</label>
                      <p class="form-control-static"><%= @user.sign_in_count %></p>
                    </div>
                  </div>
                  <div class="col-md-2">
                    <div class="form-group">
                      <label class="control-label">Intentos fallidos</label>
                      <p class="form-control-static">
                        <% if @user.failed_attempts.to_i > 0 %>
                          <span class="label label-danger"><%= @user.failed_attempts %></span>
                        <% else %>
                          <span class="label label-success">0</span>
                        <% end %>
                      </p>
                    </div>
                  </div>
                  <div class="col-md-2">
                    <div class="form-group">
                      <label class="control-label">Estado bloqueo</label>
                      <p class="form-control-static">
                        <% if @user.unlock_token.present? %>
                          <span class="label label-danger"><i class="fa fa-lock"></i> Bloqueado</span>
                        <% else %>
                          <span class="label label-success"><i class="fa fa-unlock"></i> Activo</span>
                        <% end %>
                      </p>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>

            <!-- ── Tab: Nómina ── -->
            <div class="tab-pane" id="tab-nomina">
              <p class="section-label">Datos salariales</p>
              <div class="row">
                <div class="col-md-2">
                  <%= f.input :salario, as: :moneda, label: 'Salario',
                      input_html: { class: 'form-control' } %>
                </div>
                <div class="col-md-2">
                  <%= f.input :tipo_cuenta, as: :select, label: 'Tipo de cuenta',
                      collection: [['Ahorros','AHORROS'],['Corriente','CORRIENTE']],
                      include_blank: 'Seleccionar',
                      input_html: { class: 'select2 form-control' } %>
                </div>
                <div class="col-md-3">
                  <%= f.input :nro_cuenta, label: 'Nro. Cuenta',
                      input_html: { class: 'form-control' } %>
                </div>
                <div class="col-md-3">
                  <%= f.input :banco, label: 'Banco',
                      input_html: { onChange: 'this.value=this.value.toUpperCase()', class: 'form-control input_uppercase' } %>
                </div>
              </div>
            </div>

            <!-- ── Tab: Foto ── -->
            <div class="tab-pane" id="tab-foto">
              <p class="section-label">Foto de perfil</p>
              <div class="row">
                <div class="col-md-3 text-center">
                  <% if @user.avatar_file_name.present? %>
                    <%= image_tag @user.avatar.url(:medium), class: 'avatar-preview' %>
                  <% else %>
                    <div class="avatar-placeholder">
                      <i class="fa fa-user"></i>
                    </div>
                  <% end %>
                  <small class="text-muted">Foto actual</small>
                </div>
                <div class="col-md-5">
                  <%= f.input :avatar, as: :file, label: 'Seleccionar nueva foto',
                      hint: 'Formatos permitidos: JPG, PNG, GIF. Tamaño recomendado: 300×300px' %>
                </div>
              </div>
            </div>

          </div><!-- /.tab-content -->
        </div><!-- /.box-body -->

        <!-- Footer -->
        <div class="box-footer">
          <div class="pull-right">
            <%= link_to users_path, class: 'btn btn-default', style: 'margin-right: 8px;' do %>
              <i class="fa fa-times"></i> Cancelar
            <% end %>
            <%= f.button :submit, class: 'btn-guardar' do %>
              <i class="fa fa-save"></i> Guardar cambios
            <% end %>
          </div>
        </div>

      </div><!-- /.box -->
    </div>
  </div>
<% end %>
