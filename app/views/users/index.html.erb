<% title 'Usuarios' %>
<% issygma = is_sygma %>

<div class="box box-usuarios" style="border-top: none; border-radius: 6px; box-shadow: 0 2px 12px rgba(0,0,0,0.08);">

  <!-- ── Header ── -->
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-users"></i> Usuarios
      <span class="users-count-badge"><%= @users.total_entries rescue @users.count %> registros</span>
    </span>
    <div class="box-tools pull-right" style="margin-top: -2px;">
      <%= link_to new_user_path, class: 'btn btn-sm btn-success' do %>
        <i class="fa fa-plus"></i> Nuevo usuario
      <% end %>
      <% if issygma %>
        <%= link_to carguemasivo_users_path, remote: true, class: 'btn btn-sm btn-warning' do %>
          <i class="fa fa-upload"></i> Cargue Masivo
        <% end %>
      <% end %>
      <%= link_to permisosymodulos_users_path(format: :xlsx), class: 'btn btn-sm btn-default' do %>
        <i class="fa fa-download"></i> Info. Usuarios
      <% end %>
    </div>
  </div>

  <!-- ── Body ── -->
  <div class="box-body">

    <!-- Barra de búsqueda -->
    <div class="row" style="margin-bottom: 16px;">
      <div class="col-md-6 col-sm-8 col-xs-12 search-bar">
        <%= search_form_for @q do |f| %>
          <div class="input-group">
            <%= f.search_field :email_or_username_or_nombre_or_identificacion_cont,
                onChange: 'javascript:this.value=this.value.toUpperCase();',
                class: 'form-control input_uppercase',
                placeholder: 'Buscar por nombre, usuario, email o identificación...' %>
            <div class="input-group-btn">
              <%= button_tag type: "submit", class: "btn btn-search" do %>
                <i class="fa fa-search"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Tabla -->
    <% if @users.any? %>
      <div class="table-responsive">
        <table class="table table-bordered table-condensed table-striped table-usuarios">
          <thead>
            <tr>
              <th class="text-center" width="12%">Acciones</th>
              <th width="15%">Usuario</th>
              <th>Nombre</th>
              <th class="text-center" width="7%">Activo</th>
              <th width="14%">Portafolio</th>
              <th width="13%">Tipo Consulta</th>
            </tr>
          </thead>
          <tbody>

            <%# ── Usuarios bloqueados (resaltados) ── %>
            <% if @blockedusers.present? %>
              <% @blockedusers.each do |user| %>
                <tr class="blocked-row" title="Usuario bloqueado">
                  <td class="text-center">
                    <%= link_to edit_user_path(etapa: "A", id: user.id), title: t(:title_editar) do %>
                      <button class="btn btn-xs btn-warning btn-accion"><i class="fa fa-edit"></i></button>
                    <% end %>
                    <% if user.activo == 'S' %>
                      <%= link_to inactivaruser_users_path(id: user.id), data: { confirm: '¿Está seguro?' }, title: 'Inactivar' do %>
                        <button class="btn btn-xs btn-danger btn-accion"><i class="fa fa-times-circle"></i></button>
                      <% end %>
                    <% else %>
                      <%= link_to activaruser_users_path(id: user.id), data: { confirm: '¿Está seguro?' }, title: 'Activar' do %>
                        <button class="btn btn-xs btn-success btn-accion"><i class="fa fa-check-circle"></i></button>
                      <% end %>
                    <% end %>
                    <% if user_account_locked?(user) %>
                      <%= link_to desbloquearusuario_users_path(id: user.id), data: { confirm: '¿Está seguro?' }, title: 'Desbloquear' do %>
                        <button class="btn btn-xs btn-info btn-accion"><i class="fa fa-unlock"></i></button>
                      <% end %>
                    <% end %>
                  </td>
                  <td>
                    <span class="label label-warning" style="font-size: 10px; margin-right: 4px;" title="Bloqueado">
                      <i class="fa fa-lock"></i>
                    </span>
                    <%= user.username %>
                  </td>
                  <td><%= user.nombre %></td>
                  <td class="text-center">
                    <span class="badge-activo <%= user.activo == 'S' ? 'si' : 'no' %>">
                      <%= user.activo == 'S' ? 'Sí' : 'No' %>
                    </span>
                  </td>
                  <td><%= user.portafolio.nombre rescue '—' %></td>
                  <td><%= user.tipoconsulta.presence || '—' %></td>
                </tr>
              <% end %>
            <% end %>

            <%# ── Usuarios normales ── %>
            <% @users.each do |user| %>
              <tr>
                <td class="text-center">
                  <%= link_to edit_user_path(etapa: "A", id: user.id), title: t(:title_editar) do %>
                    <button class="btn btn-xs btn-warning btn-accion"><i class="fa fa-edit"></i></button>
                  <% end %>
                  <% if user.activo == 'S' %>
                    <%= link_to inactivaruser_users_path(id: user.id), data: { confirm: '¿Está seguro?' }, title: 'Inactivar' do %>
                      <button class="btn btn-xs btn-danger btn-accion"><i class="fa fa-times-circle"></i></button>
                    <% end %>
                  <% else %>
                    <%= link_to activaruser_users_path(id: user.id), data: { confirm: '¿Está seguro?' }, title: 'Activar' do %>
                      <button class="btn btn-xs btn-success btn-accion"><i class="fa fa-check-circle"></i></button>
                    <% end %>
                  <% end %>
                  <% if user_account_locked?(user) %>
                    <%= link_to desbloquearusuario_users_path(id: user.id), data: { confirm: '¿Está seguro?' }, title: 'Desbloquear' do %>
                      <button class="btn btn-xs btn-info btn-accion"><i class="fa fa-unlock"></i></button>
                    <% end %>
                  <% end %>
                  <% if issygma %>
                    <%= link_to resetpass_users_path(id: user.id), data: { confirm: '¿Está seguro?' }, title: 'Restablecer Clave' do %>
                      <button class="btn btn-xs btn-default btn-accion"><i class="fa fa-key"></i></button>
                    <% end %>
                  <% end %>
                </td>
                <td><%= user.username %></td>
                <td><%= user.nombre %></td>
                <td class="text-center">
                  <span class="badge-activo <%= user.activo == 'S' ? 'si' : 'no' %>">
                    <%= user.activo == 'S' ? 'Sí' : 'No' %>
                  </span>
                </td>
                <td><%= user.portafolio.nombre rescue '—' %></td>
                <td><%= user.tipoconsulta.presence || '—' %></td>
              </tr>
            <% end %>

          </tbody>
        </table>
      </div>

      <!-- Paginación -->
      <div class="row" style="margin-top: 12px;">
        <div class="col-xs-12 text-right">
          <%= will_paginate @users, renderer: BootstrapPagination::Rails %>
        </div>
      </div>

    <% else %>
      <div class="empty-state">
        <i class="fa fa-users"></i>
        <p>No se encontraron usuarios con los criterios de búsqueda.</p>
      </div>
    <% end %>

  </div>
</div>

<!-- Modal cargue masivo -->
<div class="modal fade" id="carguemasivo">
  <div class="modal-dialog modal-lg">
    <div class="modal-content"></div>
  </div>
</div>
