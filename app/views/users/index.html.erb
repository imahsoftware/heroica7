<% title 'Usuarios' %>
<% issygma = is_sygma%>
<div class="box box-primary">
  <div class="box-header" style="margin-bottom: -32px;">
    <legend>Usuarios</legend>
    <div class="box-tools pull-right">
      <%= link_to new_user_path, class: 'btn btn-sm btn-success' do %>
        <i class="fa fa-plus-square"> </i> <span>Nuevo usuario</span>
      <% end %>
      <% if issygma %>
        <%= link_to carguemasivo_users_path, remote: true, class: 'btn btn-sm btn-warning' do %>
          <i class="fa fa-upload"> </i> <span>Cargue Masivo</span>
        <% end %>
      <% end %>
      <%= link_to permisosymodulos_users_path(format: :xlsx), class: 'btn btn-sm btn-info' do %>
          <i class="fa fa-download"> </i> <span>Info. Usuarios</span>
      <% end %>
    </div>
  </div>
  <div class="box-body">
    <div class="row">
      <div class="col-md-12">
        <div class="box-tools pull-right">
          <%= search_form_for @q do |f| %>
            <div class="input-group" style="width: 550px;">
              <%= f.search_field :email_or_username_or_nombre_or_identificacion_cont, onChange: 'javascript:this.value=this.value.toUpperCase();', class: 'form-control pull-right input_uppercase', placeholder: 'Buscar...' %>
              <div class="input-group-btn">
                <%= button_tag(type: "submit", class: "btn btn-default") do %>
                  <i class="fa fa-search"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <br/>
    <div class="row">
      <% if @users.any? %>
        <div class="col-md-12">
          <div class="table-responsive">
            <table class="table table-bordered table-condensed table-striped">
              <thead>
                <tr class="thcolor">
                  <th width="10%" class="text-center" style="font-size: 11px;">Acciones</th>
                  <th width="15%" style="font-size: 11px;">Usuario</th>
                  <th style="font-size: 11px;">Nombre</th>
                  <th width="5%" class="text-center" style="font-size: 11px;">Activo?</th>
                  <th width="13%" style="font-size: 11px;">Portafolio</th>
                  <th width="13%" style="font-size: 11px;">Tipo de Consulta</th>
                </tr>
              </thead>
              <tbody>
                <% if @blockedusers != nil %>
                  <% @blockedusers.each do |user| %>
                    <tr>
                      <td class="text-center">
                        <%= link_to edit_user_path(etapa: "A", id: user.id), data: { toggle: 'tooltip', :"data-turbolinks" => true  }, title: "#{t :title_editar}" do %>
                          <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                        <% end %>
                        <% if user.activo == 'S' %>
                          <%= link_to inactivaruser_users_path(id: user.id), data: { toggle: 'tooltip', :"data-turbolinks" => true , confirm: '¿Esta seguro?' }, title: 'Inactivar usuario' do %>
                            <button class="btn btn-xs btn-danger"><i class="fa fa-times-circle"></i></button>
                          <% end %>
                        <% else %>
                          <%= link_to activaruser_users_path(id: user.id), data: { toggle: 'tooltip', :"data-turbolinks" => true , confirm: '¿Esta seguro?' }, title: 'Activar usuario' do %>
                            <button class="btn btn-xs btn-success"><i class="fa fa-check-circle"></i></button>
                          <% end %>
                        <% end %>
                        <% if user.unlock_token %>
                          <%= link_to desbloquearusuario_users_path(id: user.id), data: { toggle: 'tooltip', :"data-turbolinks" => true , confirm: '¿Esta seguro?' }, title: 'Desbloquear' do %>
                            <button class="btn btn-xs btn-info"><i class="fa fa-unlock"></i></button>
                          <% end %>
                        <% end %>
                      </td>
                      <td style="font-size: 11px;"><%= user.username %></td>
                      <td style="font-size: 11px;"><%= user.nombre %></td>
                      <td class="text-center" style="font-size: 11px;"><%= user.activo %></td>
                      <td style="font-size: 11px;"><%= user.portafolio.nombre rescue nil %></td>
                      <td style="font-size: 11px;"><%= user.tipoconsulta rescue nil %></td>
                    </tr>
                  <% end %>
                <% end %>

                <% @users.each do |user| %>
                  <tr>
                    <td class="text-center">
                      <%= link_to edit_user_path(etapa: "A", id: user.id), data: { toggle: 'tooltip', :"data-turbolinks" => true  }, title: "#{t :title_editar}" do %>
                        <button class="btn btn-xs btn-warning"><i class="fa fa-edit"></i></button>
                      <% end %>
                      <% if user.activo == 'S' %>
                        <%= link_to inactivaruser_users_path(id: user.id), data: { toggle: 'tooltip', :"data-turbolinks" => true , confirm: '¿Esta seguro?' }, title: 'Inactivar usuario' do %>
                          <button class="btn btn-xs btn-danger"><i class="fa fa-circle"></i></button>
                        <% end %>
                      <% else %>
                        <%= link_to activaruser_users_path(id: user.id), data: { toggle: 'tooltip', :"data-turbolinks" => true , confirm: '¿Esta seguro?' }, title: 'Activar usuario' do %>
                          <button class="btn btn-xs btn-success"><i class="fa fa-circle"></i></button>
                        <% end %>
                      <% end %>
                      <% if user.unlock_token %>
                        <%= link_to desbloquearusuario_users_path(id: user.id), data: { toggle: 'tooltip', :"data-turbolinks" => true , confirm: '¿Esta seguro?' }, title: 'Desbloquear' do %>
                          <button class="btn btn-xs btn-info"><i class="fa fa-unlock"></i></button>
                        <% end %>
                      <% end %>
                      <% if issygma %>
                        <%= link_to resetpass_users_path(id: user.id), data: { toggle: 'tooltip', :"data-turbolinks" => true , confirm: '¿Esta seguro?' }, title: 'Reestablecer Clave' do %>
                          <button class="btn btn-xs btn-warning"><i class="fa fa-key"></i></button>
                        <% end %>
                      <% end %>
                    </td>
                    <td style="font-size: 11px;"><%= user.username %></td>
                    <td style="font-size: 11px;"><%= user.nombre %></td>
                    <td class="text-center" style="font-size: 11px;"><%= user.activo %></td>
                    <td style="font-size: 11px;"><%= user.portafolio.nombre rescue nil %></td>
                    <td style="font-size: 11px;"><%= user.tipoconsulta rescue nil %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <div class="box-tools pull-right">
            <%= will_paginate @users, renderer: BootstrapPagination::Rails %>
          </div>
        </div>
      <% else %>
        <h4 class="text-center">No se encontraron datos</h4>
      <% end %>
    </div>
  </div>
</div>

<div class="modal fade" id="carguemasivo">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
    </div>
  </div>
</div>
