<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th>Descripción</th>
        <th width="25%">Ministerio</th>
      </tr>
    </thead>
    <tbody id="tbody_tipostramites">
      <% @tipostramites.each do |tipostramite| %>
        <%= render 'tipostramites/tr', tipostramite: tipostramite %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="row" style="margin-top: 12px;">
  <div class="col-xs-12 text-right">
    <%= will_paginate @tipostramites, renderer: BootstrapPagination::Rails %>
  </div>
</div>
