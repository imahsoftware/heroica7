<% title 'Tipos de Trámite' %>

<div class="box box-usuarios">
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-file-text"></i> Tipos de Trámite
      <span class="users-count-badge"><%= @tipostramites.total_entries rescue @tipostramites.count %> registros</span>
    </span>
    <div class="box-tools pull-right" style="margin-top: -2px;">
      <%= link_to new_tipostramite_path, remote: true, id: 'new_tipostramite_button',
          class: 'btn btn-sm btn-success',
          title: 'Agregar tipo de trámite' do %>
        <i class="fa fa-plus"></i> Nuevo
      <% end %>
    </div>
  </div>

  <div class="box-body">

    <div class="row" style="margin-bottom: 16px;">
      <div class="col-md-5 col-sm-7 col-xs-12 search-bar">
        <%= search_form_for @q do |f| %>
          <div class="input-group">
            <%= f.search_field :descripcion_or_ministerio_cont,
                class: 'form-control',
                placeholder: 'Buscar por descripción o ministerio...' %>
            <div class="input-group-btn">
              <%= button_tag type: 'submit', class: 'btn btn-search' do %>
                <i class="fa fa-search"></i>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="flash_messages"></div>
    <div id="tipostramite_form" class="collapse" style="margin-bottom: 12px;"></div>

    <div id="tipostramites">
      <% if @tipostramites.any? %>
        <%= render 'tipostramites/tabla' %>
      <% else %>
        <div class="empty-state">
          <i class="fa fa-file-text"></i>
          <p>No se encontraron tipos de trámite.</p>
        </div>
      <% end %>
    </div>

  </div>
</div>
