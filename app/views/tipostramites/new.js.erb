<% if @active_record.present? %>
  $("#tipostramite_<%= @active_record.id %>").replaceWith("<%= j render 'tr', tipostramite: @active_record %>");
<% end %>
$("#tipostramite_form").html("<%= j render 'form' %>");
$("#tipostramite_form").collapse("show");
$(".tooltip").tooltip("hide");
$('[data-toggle="tooltip"]').tooltip();
