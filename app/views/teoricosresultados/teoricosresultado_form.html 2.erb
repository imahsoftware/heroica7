<div class="box box-primary">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-book"></i> Prueba Teórica</h3>
  </div>

  <div class="box-body">
    <% @pregunta = Pregunta.find(@teoricosresultado.pregunta_id) %>

    <div class="text-right">
      <span class="label label-danger" style="font-size: 14px;"><%= @teoricosresultado.consecutivo %></span>
    </div>

    <div class="callout callout-info" style="margin-top: 10px;">
      <strong><%= @pregunta.descripcion %></strong>
    </div>

    <% if @pregunta.grafica.to_s == 'N' %>
      <table class="table table-bordered table-condensed">
        <tbody>
          <% [1,2,3,4,5].each do |opc| %>
            <% texto = @pregunta.public_send("opcion#{opc}") rescue nil %>
            <% next if texto.blank? %>
            <% selected = (@teoricosresultado.respuesta.to_s == opc.to_s) %>
            <tr class="<%= selected ? 'success' : '' %>">
              <td style="width: 90px;"><strong>Opción <%= opc %>:</strong></td>
              <td><%= texto %></td>
              <td class="text-center" style="width: 60px;">
                <% if selected %>
                  <%= link_to desmarcar_teoricosresultados_path(id: @teoricosresultado.id),
                      title: 'Quitar', data: { toggle: 'tooltip' } do %>
                    <i class="fa fa-times-circle"></i>
                  <% end %>
                <% else %>
                  <%= link_to marcar_teoricosresultados_path(id: @teoricosresultado.id,
                        consecutivo: @teoricosresultado.consecutivo, opc: opc),
                      title: 'Marcar', data: { toggle: 'tooltip' } do %>
                    <i class="fa fa-check-circle"></i>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="alert alert-warning">Pregunta gráfica no migrada en esta vista.</div>
    <% end %>

    <div class="row" style="margin-top: 10px;">
      <div class="col-xs-6">
        <% if @teoricosresultado.consecutivo.to_i > 1 %>
          <%= link_to previous_teoricosresultados_path(id: @teoricosresultado.teorico_id, consecutivo: (@teoricosresultado.consecutivo - 1)),
              class: 'btn btn-default' do %>
            <i class="fa fa-arrow-left"></i> Anterior
          <% end %>
        <% end %>
      </div>
      <div class="col-xs-6 text-right">
        <% if @teoricosresultado.consecutivo.to_i >= 40 %>
          <%= link_to finalizar_teoricosresultados_path(id: @teoricosresultado.id),
              class: 'btn btn-danger',
              data: { confirm: 'Esta es la ultima pregunta. Seguro que desea finalizar la prueba teorica?' } do %>
            Finalizar <i class="fa fa-flag-checkered"></i>
          <% end %>
        <% else %>
          <%= link_to next_teoricosresultados_path(id: @teoricosresultado.teorico_id, consecutivo: (@teoricosresultado.consecutivo + 1)),
              class: 'btn btn-primary' do %>
            Siguiente <i class="fa fa-arrow-right"></i>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

