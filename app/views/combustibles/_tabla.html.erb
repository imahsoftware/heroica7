<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th width="14%">Fecha tanqueo</th>
        <th width="12%">Placa</th>
        <th width="14%">Tipo combustible</th>
        <th width="10%" class="text-right">Kilometraje</th>
        <th width="8%" class="text-right">Galones</th>
        <th width="10%" class="text-right">Valor galón</th>
        <th width="10%" class="text-right">Valor total</th>
        <th width="8%" class="text-center">Nro clases</th>
      </tr>
    </thead>
    <tbody id="tbody_combustibles">
      <% @combustibles.each do |combustible| %>
        <%= render 'combustibles/tr', combustible: combustible %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="row" style="margin-top: 12px;">
  <div class="col-xs-12 text-right">
    <%= will_paginate @combustibles, renderer: BootstrapPagination::Rails %>
  </div>
</div>
