<div class="box-header">
  <h3 class="box-title"><strong>Documentos Digitales</strong></h3>
  <div class="box-tools pull-right">
    <%# if is_auth_c('usersimagen') %>
      <%= link_to new_user_usersimagen_path(@user), id: 'new_usersimagen_button', class: 'btn btn-sm btn-success', remote: true do %>
        <i class="fa fa-plus-square"> </i> <span><%=t :agregar%></span>
      <% end %>
    <%# end %>
  </div>
</div>
<div class="box-body">
  <div class="flash_messages"></div>
  <div id="usersimagen_form" class="collapse"></div>
  <div id="usersimagenes">
    <% if @user.usersimagenes.any? %>
      <%= render 'usersimagenes/tabla' %>
    <% else %>
      <div class="alert alert-warning"><h4><i class="icon fa fa-info"></i> <%=t :atencion%></h4><%=t :atencion_msj%></div>
    <% end %>
  </div>
</div>

