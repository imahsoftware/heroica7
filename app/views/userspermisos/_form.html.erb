<%= simple_form_for([@user, @userspermiso], remote: true) do |f| %>
  <div class="row">
    <% if @userspermiso.id %>
      <div class="col-md-6">
        <%= f.input :objeto_id,
            label: 'Objeto / Permiso',
            collection: Objeto.all.collect { |p| [p.descripcionamp, p.id] }.sort_by { |label, _| label },
            input_html: { class: 'select2', style: 'width:100%' } %>
      </div>
    <% else %>
      <div class="col-md-6">
        <%= f.input :objeto_id,
            label: 'Objeto / Permiso',
            collection: Objeto.where(["id not in (select objeto_id from userspermisos where user_id = ?)", @user.id])
                               .collect { |p| [p.descripcionamp, p.id] }.sort_by { |label, _| label },
            input_html: { multiple: true, class: 'select2', style: 'width:100%' } %>
      </div>
    <% end %>
    <div class="col-md-2">
      <%= f.input :crea, as: :select, label: 'Crea',
          collection: select_sinocorto,
          include_blank: false,
          input_html: { class: 'select2 form-control' } %>
    </div>
    <div class="col-md-2">
      <%= f.input :actualiza, as: :select, label: 'Actualiza',
          collection: select_sinocorto,
          include_blank: false,
          input_html: { class: 'select2 form-control' } %>
    </div>
    <div class="col-md-2">
      <%= f.input :elimina, as: :select, label: 'Elimina',
          collection: select_sinocorto,
          include_blank: false,
          input_html: { class: 'select2 form-control' } %>
    </div>
  </div>
  <div class="row" style="margin-top: 10px;">
    <div class="col-md-6">
      <% if @userspermiso.new_record? %>
        <%= button_tag t(:cancelar), type: 'button',
            data: { target: '#userspermiso_form' },
            class: 'cancel_button btn btn-flat btn-default' %>
      <% else %>
        <%= link_to t(:cancelar), user_userspermiso_path(@user, @userspermiso),
            class: 'btn btn-flat btn-default', remote: true %>
      <% end %>
    </div>
    <div class="col-md-6 text-right">
      <%= f.button :submit, t(:guardar), class: 'btn-guardar' %>
    </div>
  </div>
<% end %>
