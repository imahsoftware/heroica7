<div class="box box-usuarios" style="margin-top: 0;">
  <div class="box-header">
    <span class="box-title">
      <i class="fa fa-shield-alt"></i> Permisos Asociados
    </span>
    <div class="box-tools pull-right" style="margin-top: -2px;">
      <%= link_to new_user_userspermiso_path(@user), remote: true,
          id: 'new_userspermiso_button',
          class: 'btn btn-sm btn-success' do %>
        <i class="fa fa-plus"></i> Agregar Permiso
      <% end %>
    </div>
  </div>
  <div class="box-body">
    <div class="flash_messages"></div>
    <div id="userspermiso_form" class="collapse" style="margin-bottom: 12px;"></div>
    <div id="userspermisos">
      <% if @user.userspermisos.any? %>
        <%= render 'userspermisos/tabla' %>
      <% else %>
        <div class="empty-state">
          <i class="fa fa-shield-alt"></i>
          <p>No hay permisos asignados a este usuario.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
