<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="10%" class="text-center">Acciones</th>
        <th>Permiso / Objeto</th>
        <th width="8%" class="text-center">Crea</th>
        <th width="10%" class="text-center">Actualiza</th>
        <th width="8%" class="text-center">Elimina</th>
      </tr>
    </thead>
    <tbody id="tbody_userspermisos">
      <% @user.userspermisos.order(updated_at: :desc).each do |userspermiso| %>
        <%= render 'userspermisos/tr', userspermiso: userspermiso %>
      <% end %>
    </tbody>
  </table>
</div>
