<% content_for :title, "Error del servidor" %>

<div class="error-code">500</div>
<i class="fa-solid fa-triangle-exclamation error-icon" aria-hidden="true"></i>
<h1 class="error-title">Algo salió mal</h1>
<p class="error-message">
  Se presentó un problema en el procedimiento. Por favor reporta al administrador si el error continúa.
</p>
<p class="error-time"><%= l(Time.zone.now, format: :long) %></p>
<%= link_to root_path, class: "btn-error" do %>
  <i class="fa-solid fa-house"></i> Volver al inicio
<% end %>
