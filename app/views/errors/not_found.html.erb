<% content_for :title, "Página no encontrada" %>

<div class="error-code">404</div>
<i class="fa-solid fa-map-location-dot error-icon" aria-hidden="true"></i>
<h1 class="error-title">La página que buscas no existe</h1>
<p class="error-message">
  La dirección puede estar incorrecta o el recurso fue movido o eliminado.
</p>
<p class="error-time"><%= l(Time.zone.now, format: :long) %></p>
<%= link_to root_path, class: "btn-error" do %>
  <i class="fa-solid fa-house"></i> Volver al inicio
<% end %>
