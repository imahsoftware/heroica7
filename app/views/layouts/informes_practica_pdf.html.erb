<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8"/>
    <%= wicked_pdf_stylesheet_link_tag 'ceasoft' %>
    <style>
      body {
        margin: 0;
        padding: 0;
        color: #000;
        background: #fff;
        font-family: Tahoma, Geneva, Verdana, sans-serif;
      }
      .informe-document,
      .informe-document table,
      .informe-document td,
      .informe-document th {
        font-family: Tahoma, Geneva, Verdana, sans-serif;
      }
      .informe-document {
        width: 850px;
        max-width: 850px;
        margin: 0 auto;
      }
      .informe-document > div[align="center"] {
        width: 850px;
        margin: 0 auto;
      }
      .informe-document table[width="850"] {
        width: 850px !important;
        max-width: 850px !important;
      }
      .informe-document table.informe-alumno {
        width: 850px !important;
        table-layout: fixed;
        border-collapse: collapse;
      }
      .informe-document table.informe-alumno td.practica-foto {
        width: 170px !important;
        max-width: 170px !important;
        vertical-align: top;
        padding: 4px;
      }
      .informe-document table.informe-alumno td.practica-datos {
        width: 680px !important;
        vertical-align: top;
        padding: 0;
      }
      .informe-document td.practica-foto img {
        display: block;
        width: 150px !important;
        height: 120px !important;
        max-width: 150px !important;
        margin: 0 auto;
      }
      .informe-document .no-print {
        display: none !important;
      }
      .informe-document table.sample {
        border-collapse: collapse;
        border-spacing: 0;
        border: 1px solid #000;
      }
      .informe-document table.sample td,
      .informe-document table.sample th {
        border: 1px solid #000;
        border-style: solid;
        padding: 3px 5px;
        vertical-align: middle;
      }
      .informe-document table.sample table.sample {
        border: 0;
      }
      .informe-document table.informe-bloque {
        border-collapse: collapse;
        border-spacing: 0;
        width: 850px;
      }
      .informe-document table.informe-bloque > tbody > tr > td {
        padding: 0;
        vertical-align: top;
        page-break-inside: auto !important;
      }
      .informe-document br {
        display: none;
      }
      table { page-break-inside: auto; }
      thead { display: table-header-group; }
      tr    { page-break-inside: auto; page-break-after: auto; }
      td, th { page-break-inside: auto; }
    </style>
  </head>
  <body>
    <div class="informe-document">
      <%= yield %>
    </div>
  </body>
</html>
