<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8"/>
    <%= wicked_pdf_stylesheet_link_tag 'ceasoft' %>
    <style>
      body {
        margin: 0;
        padding: 0;
        color: #000;
        background: #fff;
        font-family: Tahoma, Geneva, Verdana, sans-serif;
      }
      .informe-document,
      .informe-document table,
      .informe-document td,
      .informe-document th {
        font-family: Tahoma, Geneva, Verdana, sans-serif;
      }
      .informe-document {
        width: 850px;
        max-width: 850px;
        margin: 0 auto;
      }
      .informe-document > div[align="center"] {
        width: 850px;
        margin: 0 auto;
      }
      .informe-document table[width="850"] {
        width: 850px !important;
        max-width: 850px !important;
      }
      .informe-document table.practica-alumno-bloque {
        width: 850px !important;
        max-width: 850px !important;
        table-layout: fixed;
        border-collapse: collapse;
        margin: 0 auto 6px auto;
      }
      .informe-document table.practica-alumno-bloque td.practica-foto {
        width: 150px !important;
        max-width: 150px !important;
        padding: 2px;
        vertical-align: top;
        text-align: center;
      }
      .informe-document table.practica-alumno-bloque td.practica-datos {
        width: 700px !important;
        max-width: 700px !important;
        padding: 0;
        vertical-align: top;
      }
      .informe-document td.practica-foto img {
        display: block;
        width: 120px !important;
        height: 120px !important;
        max-width: 120px !important;
        margin: 0 auto;
      }
      .informe-document table.practica-datos-tabla {
        width: 100% !important;
        max-width: 700px !important;
        table-layout: fixed;
        border: 0 !important;
      }
      .informe-document table.practica-datos-tabla td {
        border: 1px solid #000;
        overflow: hidden;
        word-wrap: break-word;
        padding: 3px 5px;
      }
      .informe-document td.practica-datos input,
      .informe-document td.practica-datos select,
      .informe-document td.practica-datos textarea {
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box;
        font-size: 10px;
      }
      .informe-document .no-print {
        display: none !important;
      }
      .informe-document table.sample {
        border-collapse: collapse;
        border-spacing: 0;
        border: 1px solid #000;
        table-layout: fixed;
        width: 850px !important;
        max-width: 850px !important;
        margin: 0 auto 6px auto;
      }
      .informe-document table.sample td,
      .informe-document table.sample th {
        border: 1px solid #000;
        border-style: solid;
        padding: 3px 5px;
        vertical-align: middle;
        overflow: hidden;
        word-wrap: break-word;
      }
      .informe-document input,
      .informe-document select,
      .informe-document textarea {
        max-width: 100% !important;
        box-sizing: border-box !important;
      }
      .informe-document input.campo,
      .informe-document input.campodisabled,
      .informe-document select.span2,
      .informe-document select {
        width: 100% !important;
        font-size: 10px;
      }
      .informe-document table.sample table.sample {
        border: 0;
      }
      .informe-document br {
        display: none;
      }
      table { page-break-inside: auto; }
      thead { display: table-header-group; }
      tr    { page-break-inside: auto; page-break-after: auto; }
      td, th { page-break-inside: auto; }
    </style>
  </head>
  <body>
    <div class="informe-document">
      <%= yield %>
    </div>
  </body>
</html>
