<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
    <title><%= ENV['NOMBRE_APLICACION'] %></title>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <style>
      html, body {
        background: #ffffff !important;
        margin: 0;
        padding: 0;
        font-family: Tahoma, Geneva, Verdana, sans-serif;
      }
      .informe-document,
      .informe-document table,
      .informe-document td,
      .informe-document th {
        font-family: Tahoma, Geneva, Verdana, sans-serif;
      }
      .informe-document {
        width: 100%;
        max-width: 850px;
        margin: 0 auto;
        padding: 10px 0 20px;
      }
      .imprimirlink {
        color: #1a5276;
        font-weight: bold;
        text-decoration: none;
      }
      /* Tablas informe: linea negra delgada */
      .informe-document table.sample {
        border-collapse: collapse;
        border-spacing: 0;
        border: 1px solid #000;
      }
      .informe-document table.sample td,
      .informe-document table.sample th {
        border: 1px solid #000;
        border-style: solid;
        padding: 3px 5px;
        vertical-align: middle;
      }
      .informe-document table.sample table.sample {
        border: 0;
      }
      .informe-document table.informe-bloque {
        border-collapse: collapse;
        border-spacing: 0;
        width: 100%;
      }
      .informe-document table.informe-bloque > tbody > tr > td {
        padding: 0;
        vertical-align: top;
      }
      /* Catch-all: any table with a pixel width attribute becomes fluid */
      table[width] {
        width: 100% !important;
        max-width: 100% !important;
      }
      @media print {
        .imprimirlink { display: none; }
        @page { size: letter portrait; margin: 8mm; }
        .informe-document {
          max-width: 100% !important;
          width: 100% !important;
          padding: 0 !important;
        }
        body { margin: 0 !important; padding: 0 !important; }
      }
    </style>
  </head>
  <body>
    <div class="informe-document">
      <%= yield %>
    </div>
  </body>
</html>
