<aside class="main-sidebar">
  <section class="sidebar">
    <%= render 'layouts/sidebar_logo' %>
    <ul class="sidebar-menu" data-widget="tree">

      <li>
        <%= link_to busqueda_personas_path do %>
          <i class="fa fa-arrow-left text-danger"></i> Regresar a búsqueda
        <% end %>
      </li>

      <% if defined?(@persona) && @persona&.persisted? %>

        <%# ── Menú de secciones de la persona ── %>
        <li class="header">MENÚ DE OPCIONES</li>

        <li class="<%= active_class(edit_persona_path(etapa: 'A', id: @persona.id)) %>">
          <%= link_to edit_persona_path(etapa: 'A', id: @persona.id) do %>
            <i class="fa fa-user"></i><span> Datos Básicos</span>
          <% end %>
        </li>

        <li class="<%= active_class(edit_persona_path(etapa: 'B', id: @persona.id)) %>">
          <%= link_to edit_persona_path(etapa: 'B', id: @persona.id) do %>
            <i class="fa fa-info-circle"></i><span> Información Trámite</span>
          <% end %>
        </li>

        <li class="<%= active_class(edit_persona_path(etapa: 'C', id: @persona.id)) %>">
          <%= link_to edit_persona_path(etapa: 'C', id: @persona.id) do %>
            <i class="fa fa-graduation-cap"></i><span> Clases Dictadas</span>
          <% end %>
        </li>

        <li class="<%= active_class(edit_persona_path(etapa: 'D', id: @persona.id)) %>">
          <%= link_to edit_persona_path(etapa: 'D', id: @persona.id) do %>
            <i class="fa fa-book"></i><span> Prueba Teórica</span>
          <% end %>
        </li>

      <% elsif defined?(@persona) && @persona&.new_record? %>
        <li class="header">MENÚ DE OPCIONES</li>
        <li class="active">
          <%= link_to new_persona_path do %>
            <i class="fa fa-user"></i><span> Datos Básicos</span>
          <% end %>
        </li>

      <% end %>

    </ul>
  </section>
</aside>
