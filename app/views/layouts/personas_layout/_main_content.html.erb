<div class="content-wrapper">
  <section class="content-header">
    <h1>
      <% if defined?(@persona) && @persona&.persisted? %>
        <%= [@persona.primer_nombre, @persona.segundo_nombre,
             @persona.primer_apellido, @persona.segundo_apellido].compact.reject(&:blank?).join(' ') %>
        <small><%= @persona.identificacion %></small>
      <% else %>
        Personas
      <% end %>
    </h1>
  </section>

  <section class="content">
    <%= yield %>
  </section>
</div>
