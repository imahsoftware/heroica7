$(".form-group").removeClass("has-error");
$(".form-group > .help-block.help-block-error").remove();
<% if object.errors.any? %>
  <% object.errors.each do |error| %>
    $(".<%= object.model_name.param_key %>_<%= error.attribute %>").addClass("has-error");
    $(".<%= object.model_name.param_key %>_<%= error.attribute %>").append("<span class='help-block help-block-error'><%= j error.message %></span>");
  <% end %>
<% end %>
