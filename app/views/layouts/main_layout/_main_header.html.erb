<%
  isadmin = is_admin
  user = current_admin_user
  isportafolio = is_portafolio
  isimah = is_sygma
%>

<header class="main-header" style="background-color: #ffffff !important;">
  <% permit = Usersmodulo.where(user_id: isadmin, modulo_id: 1).exists? %>
  <%# Logo area: fondo blanco, nombre de la app en texto %>
  <%= link_to root_path, class: 'logo',
      style: 'background-color: #ffffff !important; height: 50px !important; display: flex !important; align-items: center !important; justify-content: center !important; padding: 0 12px !important;' do %>
    <span class="logo-mini" style="color: #394959; font-weight: 800; font-size: 16px; letter-spacing: 0.05em;">
      <%= ENV['NOMBRE_APLICACION'].to_s.first(2).upcase rescue 'IM' %>
    </span>
    <span class="logo-lg" style="display: flex; align-items: center; gap: 8px; color: red; font-size: 12px; font-weight: 600">
      HEROICA
    </span>
  <% end %>

  <!-- Header Navbar -->
  <nav class="navbar navbar-static-top">
    <div class="navbar-header" style="background-color: #394959;">
      <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </a>
      <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#navbar-collapse" aria-expanded="true">
        <i class="fa fa-gears"></i>
      </button>
    </div>
    <div class="navbar-collapse collapse" id="navbar-collapse" aria-expanded="false" style="background-color: #394959;">
      <!-- Navbar Right Menu -->
      <div class="navbar-custom-menu">
        <ul class="nav navbar-nav">
          <li class="dropdown messages-menu">
            <div class="navbar-custom-menu">
              <ul class="nav navbar-nav">
                <li>
                  <% if permiso("disponipractica","A").to_s == "S"%>
                    <%= link_to horarionuevo_programacionesfechas_path, class: 'dropdown-toggle', title: 'Agenda de Programacion'  do %>
                      <i class="fa fa-car" aria-hidden="true"></i>
                    <% end %>
                  <% end %>
                </li>
                <li>
                  <% if permiso("teoricodispo","A").to_s == "S"%>
                    <%= link_to disponibilidad_agendas_path, class: 'dropdown-toggle', onclick: 'window.open(this.href,"new_window","height=600,width=900,scrollbars=yes");return false;', title: 'Disponibilidad'  do %>
                      <i class="fa fa-calendar"></i>
                    <% end %>
                  <% end %>
                </li>
                <%
                  permit = Usersmodulo.where(user_id: isadmin, modulo_id: 1).exists?
                %>
                <% if params[:controller].to_s != 'users' %>
                  <% if current_user.user2_id.to_s != "" %>
                    <ul class="nav navbar-nav">
                      <li>
                        <%= link_to reestablecesusuario_users_path do %>
                          <span style="font-size: 12px !important; ">Reestablecer</span>

                        <% end %>
                      </li>
                    </ul>
                  <% end %>
                <% end %>
                <% if isimah or permit == true %>
                  <% if params[:controller].to_s != 'users' %>
                    <li class="dropdown messages-menu">
                      <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-expanded="true">
                        <span class="glyphicon glyphicon-search"></span>
                      </a>
                      <ul class="dropdown-menu" style="margin-top: 3px;">
                        <li>
                          <% if isimah == true and current_user.user2_id.to_s == "" %>
                            <%= form_tag cambiousuario_users_path, method: :get, id: "search-form", class: 'navbar-form navbar-left', role: 'search' do %>
                              <%= hidden_field_tag :user_id %>
                              <div class="input-group">
                                <%= autocomplete_field_tag :nombre, '', autocomplete_cambio_user2_users_path(portafolio_id: isportafolio), class: "form-control", id: 'navbar-search-input', id_element: '#user_id', placeholder: "Buscar...", type: "search" %>
                              </div>
                            <% end %>
                            <script type="text/javascript" charset="utf-8">
                                $('#navbar-search-input').bind('railsAutocomplete.select', function (event, data) {
                                    $('#search-form').submit()
                                });
                            </script>
                          <% end %>

                        </li>
                      </ul>
                    </li>
                  <% end %>
                <% end %>
              </ul>
            </div>
          </li>
          <% if isimah or permit == true
               @modulosseguridad = Usersmodulo.joins(:modulo).where(["usersmodulos.user_id = ? and modulos.nivel = ?", isadmin, 4]).select("modulos.*").order("modulos.descripcion")
               parcount = Usersmodulo.joins(:modulo).where(["usersmodulos.user_id = ? and modulos.nivel = ?", isadmin, 4]).count
          %>
            <li class="dropdown messages-menu">
              <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-expanded="true">
                <i class="fa fa-th-list"></i>
                <span class="label label-danger"><%= parcount rescue 0 %></span>
              </a>
              <ul class="dropdown-menu" style="width: 360px; margin-top: 3px;">
                <section class="content-header">
                  <h1>
                    <i class="fa fa-th-list"></i>
                    <small>Administración Modulos</small>
                  </h1>
                </section>
                <br/>
                <li>
                  <ul class="menu" style="height: 175px;">
                    <%
                      @modulosseguridad.each do |item| %>
                      <% if item.metodo.to_s == "" %>
                        <% item.metodo = 'GET' %>
                      <% end %>
                      <li><!-- start message -->
                        <%= link_to item.controlador, class: 'a-control-sidebar' do %>
                          <div class="pull-left">
                            <i class="<%= item.imagen.blank? ? 'fa fa-link' : item.imagen %>" style="font-size: 25px; color: #000;"></i>
                          </div>
                          <h4><%= item.descripcion %></h4>
                          <p><%= item.mensaje.blank? ? 'Modulo de administracion' : truncate(item.mensaje, :length => 45) %></p>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                </li>
              </ul>
            </li>
          <% end %>

          <li class="dropdown user user-menu">
            <%= link_to '#', class: 'dropdown-toggle', data: {toggle: 'dropdown'} do %>
              <% if user.avatar.url(:medium).include?('user_img') || user.avatar_file_name.blank? %>
                <span class="navbar-user-avatar-placeholder">
                  <i class="fa fa-user-circle"></i>
                </span>
              <% else %>
                <%= image_tag user.avatar.url(:medium), class: 'user-image', alt: 'User Image' %>
              <% end %>
              <span class="hidden-xs"><%= user.username %></span>
            <% end %>
            <ul class="dropdown-menu">
              <li class="user-header">
                <% if user.avatar.url(:medium).include?('user_img') || user.avatar_file_name.blank? %>
                  <span class="navbar-user-avatar-placeholder navbar-user-avatar-placeholder--lg">
                    <i class="fa fa-user-circle"></i>
                  </span>
                <% else %>
                  <%= image_tag user.avatar.url(:medium), class: 'img-circle', alt: 'User Image' %>
                <% end %>
                <p style="font-size: 11px;">
                  <%= user.nombre %>
                </p>
              </li>
              <li class="user-footer">
                <div class="pull-left">
                  <%= link_to edit_user_registration_path do %>
                    <button class="btn btn-flat btn-default">
                      <i class="fa fa-edit"></i></button>
                  <% end %>
                </div>
                <div class="pull-right">
                  <%= link_to logout_path, data: {confirm: '¿Esta seguro ' + "#{user.nombre}" + ' que quiere desconectarse?'} do %>
                    <button class="btn btn-flat btn-default"><i class="fa fa-sign-out-alt"></i></button>
                  <% end %>
                </div>
              </li>
            </ul>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>


<div class="modal fade" id="menu">
  <div class="modal-dialog" style="width: 1000px;">
    <div class="modal-content" style="width: 1000px;">
    </div>
  </div>
</div>
















