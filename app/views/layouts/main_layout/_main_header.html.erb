<%
  isadmin = is_admin
  user = User.find(isadmin)
  isportafolio = is_portafolio
  isimah = is_sygma
%>

<header class="main-header">
  <% permit = Usersmodulo.where(user_id: isadmin, modulo_id: 1).exists? %>
  <%= link_to root_path, class: 'logo' do %>
    <span class="logo-mini"><%= image_tag 'logo_heroica.png', alt: 'Logo', style: 'height: 30px; width: auto; object-fit: contain;' %></span>
    <span class="logo-lg"><%= image_tag 'logo_heroica.png', alt: 'Logo Heroica', style: 'height: 34px; width: auto; object-fit: contain; max-width: 160px;' %></span>
  <% end %>

  <!-- Header Navbar -->
  <nav class="navbar navbar-static-top">
    <div class="navbar-header" style="background-color: #b91c1c;">
      <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </a>
      <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#navbar-collapse" aria-expanded="true">
        <i class="fa fa-gears"></i>
      </button>
    </div>
    <div class="navbar-collapse collapse" id="navbar-collapse" aria-expanded="false" style="background-color: #b91c1c;">
      <!-- Navbar Right Menu -->
      <div class="navbar-custom-menu">
        <ul class="nav navbar-nav">
          <li class="dropdown messages-menu">
            <div class="navbar-custom-menu">
              <ul class="nav navbar-nav">
                <li>
                  <% if permiso("disponipractica","A").to_s == "S"%>
                    <%= link_to horarionuevo_programacionesfechas_path, class: 'dropdown-toggle', title: 'Agenda de Programacion'  do %>
                      <i class="fa fa-car" aria-hidden="true"></i>
                    <% end %>
                  <% end %>
                </li>
                <li>
                  <% if permiso("teoricodispo","A").to_s == "S"%>
                    <%= link_to disponibilidad_agendas_path, class: 'dropdown-toggle', onclick: 'window.open(this.href,"new_window","height=600,width=900,scrollbars=yes");return false;', title: 'Disponibilidad'  do %>
                      <i class="fa fa-calendar"></i>
                    <% end %>
                  <% end %>
                </li>
                <%
                  permit = Usersmodulo.where(user_id: isadmin, modulo_id: 1).exists?
                %>
                <% if params[:controller].to_s != 'users' %>
                  <% if current_user.user2_id.to_s != "" %>
                    <ul class="nav navbar-nav">
                      <li>
                        <%= link_to reestablecesusuario_users_path do %>
                          <span style="font-size: 12px !important; ">Reestablecer</span>

                        <% end %>
                      </li>
                    </ul>
                  <% end %>
                <% end %>
                <% if isimah or permit == true %>
                  <% if params[:controller].to_s != 'users' %>
                    <li class="dropdown messages-menu">
                      <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-expanded="true">
                        <span class="glyphicon glyphicon-search"></span>
                      </a>
                      <ul class="dropdown-menu" style="margin-top: 3px;">
                        <li>
                          <% if isimah == true and current_user.user2_id.to_s == "" %>
                            <%= form_tag cambiousuario_users_path, method: :get, id: "search-form", class: 'navbar-form navbar-left', role: 'search' do %>
                              <%= hidden_field_tag :user_id %>
                              <div class="input-group">
                                <%= autocomplete_field_tag :nombre, '', autocomplete_cambio_user2_users_path(portafolio_id: isportafolio), class: "form-control", id: 'navbar-search-input', id_element: '#user_id', placeholder: "Buscar...", type: "search" %>
                              </div>
                            <% end %>
                            <script type="text/javascript" charset="utf-8">
                                $('#navbar-search-input').bind('railsAutocomplete.select', function (event, data) {
                                    $('#search-form').submit()
                                });
                            </script>
                          <% end %>

                        </li>
                      </ul>
                    </li>
                  <% end %>
                <% end %>
              </ul>
            </div>
          </li>
          <% if isimah or permit == true
               @modulosseguridad = Usersmodulo.joins(:modulo).where(["usersmodulos.user_id = ? and modulos.nivel = ?", isadmin, 4]).select("modulos.*").order("modulos.descripcion")
               parcount = Usersmodulo.joins(:modulo).where(["usersmodulos.user_id = ? and modulos.nivel = ?", isadmin, 4]).count
          %>
            <li class="dropdown messages-menu">
              <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-expanded="true">
                <i class="fa fa-th-list"></i>
                <span class="label label-danger"><%= parcount rescue 0 %></span>
              </a>
              <ul class="dropdown-menu" style="width: 360px; margin-top: 3px;">
                <section class="content-header">
                  <h1>
                    <i class="fa fa-th-list"></i>
                    <small>Administración Modulos</small>
                  </h1>
                </section>
                <br/>
                <li>
                  <ul class="menu" style="height: 175px;">
                    <%
                      @modulosseguridad.each do |item| %>
                      <% if item.metodo.to_s == "" %>
                        <% item.metodo = 'GET' %>
                      <% end %>
                      <li><!-- start message -->
                        <%= link_to item.controlador, class: 'a-control-sidebar' do %>
                          <div class="pull-left">
                            <i class="<%= item.imagen.blank? ? 'fa fa-link' : item.imagen %>" style="font-size: 25px; color: #000;"></i>
                          </div>
                          <h4><%= item.descripcion %></h4>
                          <p><%= item.mensaje.blank? ? 'Modulo de administracion' : truncate(item.mensaje, :length => 45) %></p>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                </li>
              </ul>
            </li>
          <% end %>

          <li class="dropdown user user-menu">
            <%= link_to '#', class: 'dropdown-toggle', data: {toggle: 'dropdown'} do %>
              <% if user.avatar.url(:medium).include?('user_img') || user.avatar_file_name.blank? %>
                <span class="navbar-user-avatar-placeholder">
                  <i class="fa fa-user-circle"></i>
                </span>
              <% else %>
                <%= image_tag user.avatar.url(:medium), class: 'user-image', alt: 'User Image' %>
              <% end %>
              <span class="hidden-xs"><%= user.username %></span>
            <% end %>
            <ul class="dropdown-menu">
              <li class="user-header">
                <% if user.avatar.url(:medium).include?('user_img') || user.avatar_file_name.blank? %>
                  <span class="navbar-user-avatar-placeholder navbar-user-avatar-placeholder--lg">
                    <i class="fa fa-user-circle"></i>
                  </span>
                <% else %>
                  <%= image_tag user.avatar.url(:medium), class: 'img-circle', alt: 'User Image' %>
                <% end %>
                <p style="font-size: 11px;">
                  <%= user.nombre %>
                </p>
              </li>
              <li class="user-footer">
                <div class="pull-left">
                  <%= link_to edit_user_registration_path do %>
                    <button class="btn btn-flat btn-default">
                      <i class="fa fa-edit"></i></button>
                  <% end %>
                </div>
                <div class="pull-right">
                  <%= link_to logout_path, data: {confirm: '¿Esta seguro ' + "#{user.nombre}" + ' que quiere desconectarse?'} do %>
                    <button class="btn btn-flat btn-default"><i class="fa fa-sign-out-alt"></i></button>
                  <% end %>
                </div>
              </li>
            </ul>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>


<div class="modal fade" id="menu">
  <div class="modal-dialog" style="width: 1000px;">
    <div class="modal-content" style="width: 1000px;">
    </div>
  </div>
</div>




<style>
  /* ── Logo area ── */
  .main-header .logo {
    background-color: #ffffff !important;
    color: #b91c1c !important;
    height: 50px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 6px 12px !important;
    border-bottom: 3px solid #ef4444 !important;
  }

  /* AdminLTE: logo-mini solo visible cuando sidebar colapsado, logo-lg cuando expandido */
  .main-header .logo .logo-mini {
    display: none;
  }
  .main-header .logo .logo-lg {
    display: block;
  }
  .sidebar-collapse .main-header .logo .logo-mini {
    display: block !important;
  }
  .sidebar-collapse .main-header .logo .logo-lg {
    display: none !important;
  }

  /* ── Navbar ── */
  .main-header .navbar {
    background-color: #b91c1c !important;
    -webkit-transition: margin-left .3s ease-in-out !important;
    -o-transition: margin-left .3s ease-in-out !important;
    transition: margin-left .3s ease-in-out !important;
    margin-bottom: 0 !important;
    border: none !important;
    min-height: 50px !important;
    border-radius: 0 !important;
    box-shadow: 0 2px 8px rgba(185, 28, 28, 0.35) !important;
  }

  .navbar-nav > li > a {
    padding-top: 14px !important;
    padding-bottom: 14px !important;
    height: 50px;
    color: #ffffff !important;
    opacity: 0.9;
    transition: opacity 0.2s, background-color 0.2s;
  }

  .navbar-nav > li > a:hover {
    opacity: 1;
    background-color: rgba(255,255,255,0.12) !important;
  }

  /* Íconos del navbar en blanco */
  .main-header .navbar .nav > li > a > .fa,
  .main-header .navbar .nav > li > a > .glyphicon {
    color: #ffffff !important;
  }

  /* Username en navbar */
  .main-header .navbar .nav > li.user > a > span {
    color: #ffffff !important;
    font-weight: 500;
  }

  /* Avatar borde blanco */
  .main-header .navbar .user-image {
    border: 2px solid rgba(255,255,255,0.5) !important;
  }

  /* Dropdown del usuario */
  .main-header .navbar .user-menu .dropdown-menu {
    border-top: 3px solid #ef4444 !important;
  }

  .main-header .navbar .user-menu .dropdown-menu .user-header {
    background: linear-gradient(135deg, #b91c1c, #ef4444) !important;
  }

  /* Label badge */
  .main-header .navbar .label-danger {
    background-color: #ffffff !important;
    color: #b91c1c !important;
    font-weight: 700;
  }

  /* Sidebar toggle icon bars en blanco */
  .main-header .sidebar-toggle .icon-bar {
    background-color: #ffffff !important;
  }

  .main-header .sidebar-toggle {
    color: #ffffff !important;
  }

  .main-header .sidebar-toggle:hover {
    background-color: rgba(255,255,255,0.12) !important;
  }

  /* ── Avatar placeholder (sin imagen) ── */
  .navbar-user-avatar-placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    border: 2px solid rgba(255,255,255,0.5);
    margin-right: 4px;
    vertical-align: middle;
    float: left;
    margin-top: 3px;
  }

  .navbar-user-avatar-placeholder .fa {
    font-size: 1rem;
    color: #ffffff !important;
    line-height: 1;
  }

  /* Versión grande en el dropdown header */
  .navbar-user-avatar-placeholder--lg {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    border: 3px solid rgba(255,255,255,0.6);
    margin: 0 auto 8px;
    display: flex;
    float: none;
  }

  .navbar-user-avatar-placeholder--lg .fa {
    font-size: 2.4rem;
    color: #ffffff !important;
  }
</style>











