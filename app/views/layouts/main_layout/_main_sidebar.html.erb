
<%
  isadmin = is_admin
  user = User.find(isadmin)
  isportafolio = is_portafolio
  isimah = is_sygma
%>
<aside class="main-sidebar">
  <section class="sidebar">

    <!-- Logo en sidebar -->
    <div class="sidebar-logo-wrapper">
      <%= link_to root_path do %>
        <%= image_tag 'logo_heroica.png', alt: 'Logo Heroica', class: 'sidebar-logo-img' %>
      <% end %>
      <div class="sidebar-logo-divider"></div>
    </div>

    <!-- Sidebar Menu -->
    <ul class="sidebar-menu" data-widget="tree">
      <li class="header"><%= t :menu_principal %></li>
      <!-- Optionally, you can add icons to the links -->
      <% gescount = Usersmodulo.joins(:modulo).where(["usersmodulos.user_id = ? and modulos.nivel = ?", isadmin,1]).select("modulos.*").order("modulos.descripcion") %>
      <% if gescount.any? %>
        <li class="treeview" style="font-size: 12px !important;">
          <a href="#"><i class="fa fa-book-reader"></i> <span><%= t :menu_gestion %></span>
            <span class="pull-right-container">
              <i class="fa fa-angle-left pull-right"></i>
            </span>
          </a>
          <ul class="treeview-menu">
            <% gescount.each do |item| %>
              <% if item.metodo.to_s == "" %>
                <% item.metodo = 'GET' %>
              <% end %>
              <li>
                <%= link_to item.controlador do %>
                  <span style="font-size: 12px !important; "><%= item.descripcion %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
      <% procount = Usersmodulo.joins(:modulo).where(["usersmodulos.user_id = ? and modulos.nivel = ?", isadmin,2]).select("modulos.*").order("modulos.descripcion")  %>
      <% if procount.any? %>
        <li class="treeview" style="font-size: 12px !important;">
          <a href="#"><i class="fa fa-cogs"></i> <span><%= t :menu_procesos %></span>
            <span class="pull-right-container">
              <i class="fa fa-angle-left pull-right"></i>
            </span>
          </a>
          <ul class="treeview-menu">
            <% procount.each do |item| %>
              <% if item.metodo.to_s == "" %>
                <% item.metodo = 'GET' %>
              <% end %>
              <li>
                <%= link_to item.controlador, method: item.metodo.to_s do %>
                  <span style="font-size: 12px !important; "><%= item.descripcion %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
      <% parcount = Usersmodulo.joins(:modulo).where(["usersmodulos.user_id = ? and modulos.nivel = ?", isadmin,3]).select("modulos.*").order("modulos.descripcion")  %>
      <% if parcount.any? %>
        <li class="treeview" style="font-size: 12px !important;">
          <a href="#"><i class="fa fa-sliders-h"></i> <span><%= t :menu_parametrizacion %></span>
            <span class="pull-right-container">
              <i class="fa fa-angle-left pull-right"></i>
            </span>
          </a>
          <ul class="treeview-menu">
            <% parcount.each do |item| %>
              <% if item.metodo.to_s == "" %>
                <% item.metodo = 'GET' %>
              <% end %>
              <li>
                <%= link_to item.controlador do %>
                  <span style="font-size: 12px !important; "><%= item.descripcion %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </section>
</aside>


