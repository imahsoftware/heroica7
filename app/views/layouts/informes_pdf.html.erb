<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8"/>
    <%= wicked_pdf_stylesheet_link_tag 'ceasoft' %>
    <style>
      body {
        margin: 0;
        padding: 0;
        color: #000;
        background: #fff;
        font-family: Tahoma, Geneva, Verdana, sans-serif;
      }
      .informe-document,
      .informe-document table,
      .informe-document td,
      .informe-document th {
        font-family: Tahoma, Geneva, Verdana, sans-serif;
      }
      .informe-document {
        width: 100%;
        max-width: 850px;
        margin: 0 auto;
      }
      /* Tablas informe: linea negra delgada (override ceasoft .sample outset/inset) */
      .informe-document table.sample {
        border-collapse: collapse;
        border-spacing: 0;
        border: 1px solid #000;
      }
      .informe-document table.sample td,
      .informe-document table.sample th {
        border: 1px solid #000;
        border-style: solid;
        padding: 3px 5px;
        vertical-align: middle;
      }
      .informe-document table.sample table.sample {
        border: 0;
      }
      .informe-document table.informe-bloque {
        border-collapse: collapse;
        border-spacing: 0;
        width: 850px;
      }
      .informe-document table.informe-bloque > tbody > tr > td {
        padding: 0;
        vertical-align: top;
      }
      .imprimirlink { display: none; }
      table { page-break-inside: auto; }
      tr    { page-break-inside: avoid; page-break-after: auto; }
      td, th { page-break-inside: avoid; }
    </style>
  </head>
  <body>
    <div class="informe-document">
      <%= yield %>
    </div>
  </body>
</html>
