<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8"/>
    <%= wicked_pdf_stylesheet_link_tag 'ceasoft' %>
    <style>
      body {
        margin: 0;
        padding: 0;
        color: #000;
        background: #fff;
        font-family: Tahoma, Geneva, Verdana, sans-serif;
      }

      .informe-document {
        width: 100%;
        margin: 0;
        padding: 0;
      }

      .informe-document table[width] {
        width: 850px !important;
        max-width: 850px !important;
      }

      .registro-clase-sheet {
        width: 100% !important;
        max-width: none !important;
        margin: 0 auto;
        font-family: Tahoma, Geneva, Verdana, sans-serif;
      }

      .registro-clase-sheet table[width="850"],
      .registro-clase-sheet table.sample {
        width: 100% !important;
        max-width: 100% !important;
        border-collapse: collapse;
        table-layout: fixed;
      }

      .registro-clase-sheet table.sample td,
      .registro-clase-sheet table.sample th {
        border: 1px solid #000;
        vertical-align: middle;
        padding: 2px 5px;
        line-height: 1.18;
        box-sizing: border-box;
      }

      .registro-clase-sheet .camposDescN16 { font-size: 15px; font-weight: bold; }
      .registro-clase-sheet .camposDescN12 { font-size: 12px; font-weight: bold; }
      .registro-clase-sheet .camposDesc12  { font-size: 12px; }
      .registro-clase-sheet .camposDescN11 { font-size: 11px; font-weight: bold; }
      .registro-clase-sheet .camposDesc11  { font-size: 11px; }
      .registro-clase-sheet .camposDesc10  { font-size: 10px; }

      .registro-clase-header td { height: 0.38in; }
      .registro-clase-alumno td { height: 0.24in; }

      .registro-clase-foto img,
      .registro-clase-header .registro-clase-logo img {
        max-height: 1.28in !important;
        max-width: 1.55in !important;
        width: auto !important;
      }

      .registro-clase-practica tr.fila-clase td { height: 0.198in; }
      .registro-clase-teoria tr.fila-teoria td { height: 0.164in; }
      .registro-clase-instructor tr:not(.observaciones) td { height: 0.28in; }
      .registro-clase-instructor .observaciones td { height: 0.58in; }
      .registro-clase-footer td { height: 0.17in; }

      .registro-clase-instructor table.registro-clase-cumplio {
        width: 100% !important;
        max-width: 100% !important;
        table-layout: fixed;
        border-collapse: collapse;
        border: 0 !important;
      }

      .registro-clase-instructor table.registro-clase-cumplio td {
        border: 1px solid #000;
        padding: 2px 4px;
        box-sizing: border-box;
      }

      .imprimirlink { display: none !important; }

      table { page-break-inside: auto; }
      tr { page-break-inside: avoid; page-break-after: auto; }
    </style>
  </head>
  <body>
    <div class="informe-document">
      <%= yield %>
    </div>
  </body>
</html>
