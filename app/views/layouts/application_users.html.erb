<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : 'Usuario' %> | <%= ENV['NOMBRE_APLICACION'] %></title>
    <%= csrf_meta_tags %>
    <%= action_cable_meta_tag %>
    <%= favicon_link_tag asset_path('favicon.png') %>
		<meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>
  <body class="sidebar-mini skin-blue-light">
    <div class="wrapper">
      <%= render 'layouts/main_layout/main_header' %>
      <%= render 'layouts/users_layout/main_sidebar' %>
      <%= render 'layouts/main_layout/main_content' %>
      <%= render 'layouts/main_layout/main_footer' %>
      <%#= render 'layouts/main_layout/control_sidebar' %>
    </div>
  </body>

</html>
