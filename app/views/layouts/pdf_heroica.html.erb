<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8"/>
    <style>
      body { font-family: Tahoma, sans-serif; margin: 0; padding: 10px; }
      table { border-collapse: collapse; }
      .sample { border: 1px solid gray; border-collapse: collapse; }
      .sample th, .sample td { border: 1px solid gray; padding: 3px 6px; }
      thead { background: #F2F2F2; display: table-header-group; }
      .camposDesc11  { font-size: 11px; font-family: Tahoma; }
      .camposDescN11 { font-weight: bold; font-size: 11px; font-family: Tahoma; }
      .camposDescN12 { font-weight: bold; font-size: 12px; font-family: Tahoma; }
      .camposDescN16 { font-weight: bold; font-size: 16px; font-family: Tahoma; }
      .tit_gr_azul   { font-family: Tahoma; font-size: 19px; color: #4390b4; }
      .imprimirlink  { display: none !important; }
      @media print {
        body { margin: 0; padding: 0; }
        .imprimirlink { display: none !important; }
        tr { page-break-inside: avoid; }
      }
    </style>
  </head>
  <body>
    <div id="pdf-content">
      <%= yield %>
    </div>
    <script>
      window.onload = function() {
        var landscape = !!document.getElementById('pdf-landscape');
        var style = document.createElement('style');
        style.innerHTML = landscape
          ? '@page { size: letter landscape; margin: 8mm; }'
          : '@page { size: letter portrait; margin: 10mm; }';
        document.head.appendChild(style);
        window.print();
      };
    </script>
  </body>
</html>
