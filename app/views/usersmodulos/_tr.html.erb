<tr id="usersmodulo_<%= usersmodulo.id %>">
  <td class="text-center">
    <%= link_to edit_user_usersmodulo_path(@user, usersmodulo), remote: true,
        class: 'edit_usersmodulo_button',
        title: t(:title_editar),
        data: { toggle: 'tooltip' } do %>
      <button class="btn btn-xs btn-warning btn-accion"><i class="fa fa-edit"></i></button>
    <% end %>
    <%= link_to user_usersmodulo_path(@user, usersmodulo), remote: true,
        method: :delete,
        title: t(:title_elimina),
        data: { confirm: t(:elimina_confirma), toggle: 'tooltip' } do %>
      <button class="btn btn-xs btn-danger btn-accion"><i class="fa fa-trash"></i></button>
    <% end %>
  </td>
  <td><%= usersmodulo.modulo.descripcion rescue '—' %></td>
  <td><%= usersmodulo.modulo.mensaje rescue '—' %></td>
</tr>
