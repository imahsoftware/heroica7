<div class="table-responsive">
	<table class="table table-bordered">
	  <thead>
	    <tr class="thcolor">
				<th width="10%"></th>
        <th>Modulo</th>
	    </tr>
	  </thead>
	  <tbody id="tbody_usersmodulos">
	    <% @usersmodulos.order(updated_at: :desc).each do |usersmodulo| %>
	      <%= render 'usersmodulos/tr', usersmodulo: usersmodulo %>
	    <% end %>
	  </tbody>
	</table>
</div>
