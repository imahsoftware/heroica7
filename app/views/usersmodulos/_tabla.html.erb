<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="10%" class="text-center">Acciones</th>
        <th>Módulo</th>
        <th>Descripción</th>
      </tr>
    </thead>
    <tbody id="tbody_usersmodulos">
      <% @usersmodulos.order(updated_at: :desc).each do |usersmodulo| %>
        <%= render 'usersmodulos/tr', usersmodulo: usersmodulo %>
      <% end %>
    </tbody>
  </table>
</div>
