<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th width="10%">Fecha</th>
        <th width="10%">Nro. Egreso</th>
        <th width="10%" class="text-right">Valor</th>
        <th width="32%">Observación</th>
        <th width="15%">Proveedor</th>
        <th width="15%">Auditoría</th>
      </tr>
    </thead>
    <tbody>
      <% @egresos.each do |egreso| %>
        <tr id="egreso_<%= egreso.id %>">
          <td class="text-center">
            <%= link_to edit_egreso_path(egreso),
                title: t(:title_editar),
                data: { toggle: 'tooltip' } do %>
              <button class="btn btn-xs btn-warning btn-accion"><i class="fa fa-edit"></i></button>
            <% end %>
            <%= link_to egreso_path(egreso), method: :delete,
                title: t(:title_elimina),
                data: { confirm: t(:elimina_confirma), toggle: 'tooltip' } do %>
              <button class="btn btn-xs btn-danger btn-accion"><i class="fa fa-trash"></i></button>
            <% end %>
          </td>
          <td><%= egreso.fecha %></td>
          <td>
            <code style="font-size: 11px; background: #f1f5f9; color: #394959; padding: 2px 6px; border-radius: 4px;">
              <%= egreso.nro_egreso %>
            </code>
          </td>
          <td class="text-right"><%= number_with_delimiter(egreso.valor.to_i, delimiter: '.') %></td>
          <td style="font-size: 11px;"><%= egreso.observacion %></td>
          <td style="font-size: 11px; color: #64748b;"><%= egreso.proveedor&.autobuscar %></td>
          <td style="font-size: 11px; color: #64748b;">
            <strong>Crea:</strong> <%= egreso.created_at.strftime('%Y-%m-%d %H:%M') rescue '—' %><br>
            <%= egreso.user&.username %><br>
            <strong>Act:</strong> <%= egreso.updated_at.strftime('%Y-%m-%d %H:%M') rescue '—' %><br>
            <%= User.find(egreso.user_actualiza).username rescue nil %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
