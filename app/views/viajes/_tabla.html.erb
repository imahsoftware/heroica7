<div class="table-responsive">
  <table class="table table-bordered table-condensed table-striped table-usuarios">
    <thead>
      <tr>
        <th width="8%" class="text-center">Acciones</th>
        <th width="25%">Tipo de Tour</th>
        <th width="15%">Identificación</th>
        <th width="52%">Nombre</th>
      </tr>
    </thead>
    <tbody id="tbody_viajes">
      <% @viajes.each do |viaje| %>
        <%= render 'viajes/tr', viaje: viaje %>
      <% end %>
    </tbody>
  </table>
</div>
