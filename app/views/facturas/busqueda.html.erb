<div class="box box-primary">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-search"></i> INFORMACION FACTURAS</h3>
  </div>
  <div class="box-body">

    <%# ── Búsqueda de factura ────────────────────────────────────────────────── %>
    <%= form_with url: buscar_facturas_path, method: :get, local: true do %>
      <div class="row">
        <div class="col-md-6">
          <div class="form-group">
            <%= label_tag :buscarident, 'Identificación' %>
            <%= text_field_tag :buscarident, params[:buscarident],
                  class: 'form-control', size: 40 %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-group">
            <%= label_tag :buscarnombre, 'Nombre' %>
            <%= text_field_tag :buscarnombre, params[:buscarnombre],
                  class: 'form-control', size: 40 %>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-md-6">
          <div class="form-group">
            <%= label_tag :buscarfactura, 'Número de Factura' %>
            <%= text_field_tag :buscarfactura, params[:buscarfactura],
                  class: 'form-control', size: 40 %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-group">
            <%= label_tag :buscarabono, 'Número del Abono' %>
            <%= text_field_tag :buscarabono, params[:buscarabono],
                  class: 'form-control', size: 40 %>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-md-12">
          <%= submit_tag 'Buscar', class: 'btn btn-primary', disable_with: 'Buscando...' %>
        </div>
      </div>
    <% end %>

    <% if permiso('facturasinforme', 'A').to_s == 'S' %>
      <hr>

      <%# ── Informe diario ──────────────────────────────────────────────────────── %>
      <h4><i class="fa fa-bar-chart"></i> INFORME DIARIO</h4>
      <%= form_with url: informe_facturas_path, method: :get, local: true do %>
        <div class="row">
          <div class="col-md-4">
            <div class="form-group">
              <%= label_tag 'ubicacion[inicial]', 'Fecha Inicial' %>
              <%= date_field_tag 'ubicacion[inicial]', params.dig(:ubicacion, :inicial),
                    class: 'form-control' %>
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-group">
              <%= label_tag 'ubicacion[final]', 'Fecha Final' %>
              <%= date_field_tag 'ubicacion[final]', params.dig(:ubicacion, :final),
                    class: 'form-control' %>
            </div>
          </div>
          <div class="col-md-4" style="padding-top: 25px;">
            <%= submit_tag 'Generar', class: 'btn btn-success', disable_with: 'Generando...' %>
          </div>
        </div>
      <% end %>

      <hr>

      <%# ── Informe diario consolidado ─────────────────────────────────────────── %>
      <h4><i class="fa fa-bar-chart"></i> INFORME DIARIO CONSOLIDADO</h4>
      <%= form_with url: informeconsolidado_facturas_path, method: :get, local: true do %>
        <div class="row">
          <div class="col-md-4">
            <div class="form-group">
              <%= label_tag 'ubicacion[inicial]', 'Fecha Inicial' %>
              <%= date_field_tag 'ubicacion[inicial]', params.dig(:ubicacion, :inicial),
                    class: 'form-control' %>
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-group">
              <%= label_tag 'ubicacion[final]', 'Fecha Final' %>
              <%= date_field_tag 'ubicacion[final]', params.dig(:ubicacion, :final),
                    class: 'form-control' %>
            </div>
          </div>
          <div class="col-md-4" style="padding-top: 25px;">
            <%= submit_tag 'Generar', class: 'btn btn-success', disable_with: 'Generando...' %>
          </div>
        </div>
      <% end %>

      <hr>

      <%# ── Informe de clases (descarga XLS) ───────────────────────────────────── %>
      <h4><i class="fa fa-file-excel-o"></i> INFORME DE CLASES (Excel)</h4>
      <form id="form_informeclases" method="get" action="<%= informeclases_facturas_path(format: :xlsx) %>" data-turbo="false">
        <div class="row">
          <div class="col-md-4">
            <div class="form-group">
              <label for="clases_inicial">Fecha Inicial</label>
              <input type="date" id="clases_inicial" name="ubicacion[inicial]" class="form-control"
                     value="<%= params.dig(:ubicacion, :inicial) %>">
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-group">
              <label for="clases_final">Fecha Final</label>
              <input type="date" id="clases_final" name="ubicacion[final]" class="form-control"
                     value="<%= params.dig(:ubicacion, :final) %>">
            </div>
          </div>
          <div class="col-md-4" style="padding-top: 25px;">
            <button type="submit" class="btn btn-warning">
              <i class="fa fa-download"></i> Descargar Excel
            </button>
          </div>
        </div>
      </form>

    <% end %>

  </div>
</div>
