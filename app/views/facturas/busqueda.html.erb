<div class="box box-primary">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-search"></i> INFORMACION FACTURAS</h3>
  </div>
  <div class="box-body">

    <%# ── Búsqueda de factura ────────────────────────────────────────────────── %>
    <%= form_with url: buscar_facturas_path, method: :get, local: true do %>
      <div class="row">
        <div class="col-md-3">
          <div class="form-group">
            <%= label_tag :buscarident, 'Identificación' %>
            <%= text_field_tag :buscarident, params[:buscarident],
                  class: 'form-control' %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="form-group">
            <%= label_tag :buscarnombre, 'Nombre' %>
            <%= text_field_tag :buscarnombre, params[:buscarnombre],
                  class: 'form-control' %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="form-group">
            <%= label_tag :buscarfactura, 'Número de Factura' %>
            <%= text_field_tag :buscarfactura, params[:buscarfactura],
                  class: 'form-control' %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="form-group">
            <%= label_tag :buscarabono, 'Número del Abono' %>
            <%= text_field_tag :buscarabono, params[:buscarabono],
                  class: 'form-control' %>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-md-12">
          <%= submit_tag 'Buscar', class: 'btn btn-primary', disable_with: 'Buscando...' %>
        </div>
      </div>
    <% end %>

    <% if is_auth_a('facturasinforme') %>
      <hr>

      <%# ── Informe diario ──────────────────────────────────────────────────────── %>
      <h4><i class="fa fa-bar-chart"></i> INFORME DIARIO</h4>
      <form id="form_informe" method="get" action="<%= informe_facturas_path %>" data-turbo="false">
        <div class="row">
          <div class="col-md-4">
            <div class="form-group">
              <label for="informe_inicial">Fecha Inicial</label>
              <input type="text" id="informe_inicial" name="ubicacion[inicial]" class="form-control datepicker" placeholder="YYYY-MM-DD" autocomplete="off"
                     value="<%= params.dig(:ubicacion, :inicial) %>">
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-group">
              <label for="informe_final">Fecha Final</label>
              <input type="text" id="informe_final" name="ubicacion[final]" class="form-control datepicker" placeholder="YYYY-MM-DD" autocomplete="off"
                     value="<%= params.dig(:ubicacion, :final) %>">
            </div>
          </div>
          <div class="col-md-4" style="padding-top: 25px;">
            <button type="button" class="btn btn-success"
                    onclick="abrirInformePopup('form_informe', '<%= informe_facturas_path %>')">
              <i class="fa fa-eye"></i> Generar
            </button>
            <button type="button" class="btn btn-warning"
                    onclick="document.getElementById('form_informe').action='<%= informe_facturas_path(format: :xlsx) %>'; document.getElementById('form_informe').target='_self'; document.getElementById('form_informe').submit();">
              <i class="fa fa-download"></i> Excel
            </button>
          </div>
        </div>
      </form>

      <hr>

      <%# ── Informe diario consolidado ─────────────────────────────────────────── %>
      <h4><i class="fa fa-bar-chart"></i> INFORME DIARIO CONSOLIDADO</h4>
      <form id="form_informeconsolidado" method="get" action="<%= informeconsolidado_facturas_path %>" data-turbo="false">
        <div class="row">
          <div class="col-md-4">
            <div class="form-group">
              <label for="consolidado_inicial">Fecha Inicial</label>
              <input type="text" id="consolidado_inicial" name="ubicacion[inicial]" class="form-control datepicker" placeholder="YYYY-MM-DD" autocomplete="off"
                     value="<%= params.dig(:ubicacion, :inicial) %>">
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-group">
              <label for="consolidado_final">Fecha Final</label>
              <input type="text" id="consolidado_final" name="ubicacion[final]" class="form-control datepicker" placeholder="YYYY-MM-DD" autocomplete="off"
                     value="<%= params.dig(:ubicacion, :final) %>">
            </div>
          </div>
          <div class="col-md-4" style="padding-top: 25px;">
            <button type="button" class="btn btn-success"
                    onclick="abrirInformePopup('form_informeconsolidado', '<%= informeconsolidado_facturas_path %>')">
              <i class="fa fa-eye"></i> Generar
            </button>
            <button type="button" class="btn btn-warning"
                    onclick="document.getElementById('form_informeconsolidado').action='<%= informeconsolidado_facturas_path(format: :xlsx) %>'; document.getElementById('form_informeconsolidado').target='_self'; document.getElementById('form_informeconsolidado').submit();">
              <i class="fa fa-download"></i> Excel
            </button>
          </div>
        </div>
      </form>

      <hr>

      <%# ── Informe de clases (descarga XLS) ───────────────────────────────────── %>
      <h4><i class="fa fa-file-excel-o"></i> INFORME DE CLASES (Excel)</h4>
      <form id="form_informeclases" method="get" action="<%= informeclases_facturas_path(format: :xlsx) %>" data-turbo="false">
        <div class="row">
          <div class="col-md-4">
            <div class="form-group">
              <label for="clases_inicial">Fecha Inicial</label>
              <input type="text" id="clases_inicial" name="ubicacion[inicial]" class="form-control datepicker" placeholder="YYYY-MM-DD" autocomplete="off"
                     value="<%= params.dig(:ubicacion, :inicial) %>">
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-group">
              <label for="clases_final">Fecha Final</label>
              <input type="text" id="clases_final" name="ubicacion[final]" class="form-control datepicker" placeholder="YYYY-MM-DD" autocomplete="off"
                     value="<%= params.dig(:ubicacion, :final) %>">
            </div>
          </div>
          <div class="col-md-4" style="padding-top: 25px;">
            <button type="submit" class="btn btn-warning">
              <i class="fa fa-download"></i> Descargar Excel
            </button>
          </div>
        </div>
      </form>

    <% end %>

  </div>
</div>

<script>
  function abrirInformePopup(formId, accion) {
    var popup = window.open('', 'heroica_informe',
      'width=1050,height=750,scrollbars=yes,resizable=yes,toolbar=no,menubar=no,location=no');
    var form = document.getElementById(formId);
    form.action  = accion;
    form.target  = 'heroica_informe';
    form.submit();
    form.target  = '_self';   // restaurar para que Excel no abra popup
    popup.focus();
  }
</script>
