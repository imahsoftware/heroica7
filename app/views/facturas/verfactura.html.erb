<div class="box box-primary">
  <div class="box-header with-border">
    <h3 class="box-title"><i class="fa fa-file-text"></i> Factura Nro. <%= facturacero(@factura.nro_factura) %></h3>
  </div>
  <div class="box-body">
    <div class="row">
      <div class="col-md-4"><strong>Persona:</strong> <%= @factura.persona.nombres rescue nil %></div>
      <div class="col-md-4"><strong>Identificación:</strong> <%= @factura.persona.identificacion rescue nil %></div>
      <div class="col-md-4"><strong>Estado:</strong> <%= @factura.destado %></div>
    </div>
    <div class="row" style="margin-top:10px;">
      <div class="col-md-4"><strong>Categoría:</strong> <%= @factura.categoria.nombre rescue nil %></div>
      <div class="col-md-4"><strong>Trámite:</strong> <%= @factura.tipostramite.descripcion rescue nil %></div>
      <div class="col-md-4"><strong>Valor Total:</strong> <%= number_to_currency(@factura.valor, precision: 0, unit: '$', delimiter: '.') rescue @factura.valor %></div>
    </div>
    <% if @factura.detallesfacturas.exists? %>
      <hr>
      <h4>Detalle</h4>
      <table class="table table-bordered table-condensed">
        <thead>
          <tr><th>Concepto</th><th class="text-right">Valor</th></tr>
        </thead>
        <tbody>
          <% @factura.detallesfacturas.each do |det| %>
            <tr>
              <td><%= det.concepto.descripcion rescue nil %></td>
              <td class="text-right"><%= number_to_currency(det.valor, precision: 0, unit: '$', delimiter: '.') rescue det.valor %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
